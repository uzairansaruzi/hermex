# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
# dist/index.html is the checked-in static shell the catalog contract requires
# (test/hermes-catalog.test.mjs); only the generated production bundle is ignored.
dist/bundle.js
web-build/
expo-env.d.ts

# Simulator-rendered SF Symbol previews (scripts/generate-icon-previews.mjs) — runtime-only,
# regenerated on demand, never committed.
public/generated-icons/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
