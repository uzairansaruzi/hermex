    "Change or clear the filters to see more Cards." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Ändere oder entferne die Filter, um weitere Karten zu sehen." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Cambia o borra los filtros para ver más tarjetas." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Modifiez ou effacez les filtres pour voir plus de cartes." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Modifica o cancella i filtri per vedere altre schede." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Zmień lub wyczyść filtry, aby zobaczyć więcej kart." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Altere ou limpe os filtros para ver mais cartões." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Wijzig of wis de filters om meer kaarten te zien." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Daha fazla Kart görmek için filtreleri değiştirin veya temizleyin." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Измените или сбросьте фильтры, чтобы увидеть больше карточек." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "ほかのカードを表示するには、フィルタを変更またはクリアしてください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "更改或清除筛选条件以查看更多卡片。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "더 많은 카드를 보려면 필터를 변경하거나 지우세요." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "غيّر عوامل التصفية أو امسحها لرؤية مزيد من البطاقات." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "יש לשנות או לנקות את המסננים כדי לראות כרטיסים נוספים." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "مزید کارڈز دیکھنے کے لیے فلٹرز تبدیل یا صاف کریں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "變更或清除篩選條件以查看更多卡片。" } }, "zh-HK" : { "stringUnit" : { "state" : "need