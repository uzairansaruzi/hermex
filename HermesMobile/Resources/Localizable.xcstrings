      }
    },
    "Workspace path is required for this workspace kind." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "مسار مساحة العمل مطلوب لهذا النوع من مساحة العمل." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Für diesen Arbeitsbereichstyp ist ein Arbeitsbereichspfad erforderlich." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "La ruta del espacio de trabajo es obligatoria para este tipo de espacio de trabajo." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le chemin de l’espace de travail est requis pour ce type d’espace de travail." } },
        "he" : { "stringUnit" : { "state" : "translated", "value" : "נדרש נתיב סביבת עבודה עבור סוג סביבת עבודה זה." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Il percorso dell'area di lavoro è obbligatorio per questo tipo di area di lavoro." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "この種類のワークスペースにはワークスペース パスが必要です。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 작업공간 종류에는 작업공간 경로가 필요합니다." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Voor dit type werkruimte is een werkruimtepad vereist." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Ścieżka obszaru roboczego jest wymagana dla tego rodzaju obszaru roboczego." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O caminho do espaço de trabalho é obrigatório para este tipo de espaço de trabalho." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Для этого типа рабочей области требуется путь к рабочей области." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu çalışma alanı türü için çalışma alanı yolu gereklidir." } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "ورک اسپیس کی اس قسم کے لیے ورک اسپیس کا راستہ درکار ہے۔" } },
        "zh-HK" : { "stringUnit" : { "state" : "translated", "value" : "此工作空間類型需要工作空間路徑。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此工作空间类型需要工作空间路径。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "此工作空間類型需要工作空間路徑。" } }
      }
    },
    "Workspace, Skills, Maximum Runtime, and Prerequisite are set when the Card is created and cannot be edited here." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "يتم تعيين مساحة العمل والمهارات والحد الأقصى لوقت التشغيل والمتطلبات الأساسية عند إنشاء البطاقة ولا يمكن تحريرها هنا." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Arbeitsbereich, Fähigkeiten, maximale Laufzeit und Voraussetzung werden beim Erstellen der Karte festgelegt und können hier nicht bearbeitet werden." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "El espacio de trabajo, las habilidades, el tiempo de ejecución máximo y los requisitos previos se configuran cuando se crea la tarjeta y no se pueden editar aquí." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "L'espace de travail, les compétences, la durée d'exécution maximale et les conditions préalables sont définis lors de la création de la carte et ne peuvent pas être modifiés ici." } },
        "he" : { "stringUnit" : { "state" : "translated", "value" : "סביבת עבודה, מיומנויות, זמן ריצה מרבי ותנאי מוקדם מוגדרים כאשר הכרטיס נוצר ולא ניתן לערוך אותם כאן." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Area di lavoro, Competenze, Durata massima e Prerequisiti vengono impostati al momento della creazione della scheda e non possono essere modificati qui." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ワークスペース、スキル、最大実行時間、前提条件はカードの作成時に設定され、ここでは編集できません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "작업 영역, 기술, 최대 실행 시간 및 전제 조건은 카드가 생성될 때 설정되며 여기에서 편집할 수 없습니다." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Werkruimte, vaardigheden, maximale looptijd en vereiste worden ingesteld wanneer de kaart wordt gemaakt en kunnen hier niet worden bewerkt." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Obszar roboczy, Umiejętności, Maksymalny czas działania i Wymagania wstępne są ustawiane podczas tworzenia karty i nie można ich tutaj edytować." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Espaço de Trabalho, Habilidades, Tempo Máximo de Execução e Pré-requisito são definidos quando o Cartão é criado e não podem ser editados aqui." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Рабочая область, Навыки, Максимальное время работы и Предварительные условия задаются при создании карты и не могут быть изменены здесь." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Çalışma Alanı, Beceriler, Maksimum Çalışma Süresi ve Önkoşul, Kart oluşturulduğunda ayarlanır ve burada düzenlenemez." } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "ورک اسپیس، سکلز، زیادہ سے زیادہ رن ٹائم، اور شرط اس وقت سیٹ ہوتی ہے جب کارڈ بن جاتا ہے اور یہاں ترمیم نہیں کی جا سکتی۔" } },
        "zh-HK" : { "stringUnit" : { "state" : "translated", "value" : "工作空間、技能、最長運行時間和先決條件是在創建卡片時設定的，無法在此處編輯。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "工作空间、技能、最长运行时间和先决条件是在创建卡片时设置的，无法在此处编辑。" } },
