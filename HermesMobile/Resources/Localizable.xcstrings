    "Hide group" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Gruppe ausblenden" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Ocultar grupo" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Masquer le groupe" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Nascondi gruppo" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Ukryj grupę" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Ocultar grupo" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Groep verbergen" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Grubu gizle" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Скрыть группу" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "グループを非表示" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "隐藏群组" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "그룹 숨기기" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "إخفاء المجموعة" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "הסתרת הקבוצה" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "گروپ چھپائیں" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "隱藏群組" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "隱藏群組" } } } },
    "Hide hidden" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Ausgeblendete verbergen" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Ocultar ocultos" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Masquer les éléments masqués" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Nascondi i nascosti" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Nie pokazuj ukrytych" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Ocultar os ocultos" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Verborgen items verbergen" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Gizlenenleri gösterme" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Не показывать скрытые" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "非表示の項目を隠す" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "收起已隐藏项" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "숨긴 항목 가리기" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "إخفاء المخفية" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "הסתרת המוסתרים" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "پوشیدہ چھپائیں" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "收合已隱藏項目" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "收起已隱藏項目" } } } },
    "In Settings → Plugins, enable Bots for the intended Profile. Applies to selects the Profile configuration being edited." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Aktiviere unter „Settings → Plugins“ die Bots für das gewünschte Profil. „Applies to“ wählt die Profilkonfiguration, die bearbeitet wird." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "En Settings → Plugins, activa Bots para el perfil que quieras. «Applies to» selecciona la configuración de perfil que se está editando." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Dans Settings → Plugins, activez Bots pour le profil voulu. « Applies to » sélectionne la configuration de profil en cours de modification." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "In Settings → Plugins, attiva Bots per il profilo previsto. «Applies to» seleziona la configurazione del profilo da modificare." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "W Settings → Plugins włącz Bots dla wybranego profilu. Pole „Applies to” wybiera edytowaną konfigurację profilu." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Em Settings → Plugins, ative Bots para o perfil desejado. “Applies to” seleciona a configuração do perfil que está sendo editada." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Schakel in ‘Settings → Plugins’ Bots in voor het gewenste profiel. ‘Applies to’ selecteert de profielconfiguratie die je bewerkt." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Settings → Plugins’te istenen Profil için Bots’u etkinleştirin. “Applies to”, düzenlenen Profil yapılandırmasını seçer." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "В Settings → Plugins включите Bots для нужного профиля. Поле «Applies to» выбирает редактируемую конфигурацию профиля." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "設定 → プラグインで、対象のプロファイルのBotsを有効にしてください。「適用先」では、編集するプロファイル設定を選択します。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "在“设置 → 插件”中，为目标配置文件启用“机器人”。“应用于”用于选择正在编辑的配置文件。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "설정 → 플러그인에서 대상 프로필의 Bots를 활성화하세요. ‘적용 대상’에서 편집할 프로필 구성을 선택합니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "في Settings → Plugins، فعّل Bots لملف التعريف المقصود. يحدد «Applies to» إعدادات ملف التعريف التي يجري تحريرها." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "ב‑Settings → Plugins יש להפעיל את Bots עבור הפרופיל הרצוי. האפשרות «Applies to» בוחרת את תצורת הפרופיל שנערכת." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "Settings → Plugins میں مطلوبہ پروفائل کے لیے Bots فعال کریں۔ «Applies to» وہ پروفائل ترتیب منتخب کرتا ہے جس میں ترمیم ہو رہی ہے۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "在「設定 → 外掛程式」中，為目標設定檔啟用「機器人」。「套用至」用於選擇正在編輯的設定檔。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "在「設定 → 插件」中，為目標設定檔啟用「機械人」。「套用至」用於選擇正在編輯的設定檔。" } } } },
