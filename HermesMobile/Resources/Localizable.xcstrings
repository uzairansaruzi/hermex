    "Removes this server and its saved settings on this device. Your active server is unaffected." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يزيل هذا الخادم وإعداداته المحفوظة على هذا الجهاز. لا يتأثر خادمك النشط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Entfernt diesen Server und seine gespeicherten Einstellungen auf diesem Gerät. Dein aktiver Server ist davon nicht betroffen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elimina este servidor y sus ajustes guardados en este dispositivo. Tu servidor activo no se ve afectado."
