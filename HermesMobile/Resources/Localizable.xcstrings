          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "מסיר שרת זה ואת ההגדרות השמורות שלו במכשיר זה. השרת הפעיל שלך אינו מושפע."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rimuove questo server e le sue impostazioni salvate su questo dispositivo. Il server attivo non viene modificato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
