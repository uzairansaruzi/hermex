    "You'll return to onboarding and need the server URL and password to sign back in." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ستعود إلى المقدمة وستحتاج إلى عنوان URL للخادم وكلمة المرور لتسجيل الدخول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Du kehrst zur Einrichtung zurück und benötigst die Server-URL und das Passwort, um dich wieder anzumelden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Regresarás a la introducción y necesitarás la URL del servidor y la contraseña para volver a iniciar sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vous reviendrez à la présentation et devrez saisir l'URL du serveur et le mot de passe pour vous reconnecter."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "תחזור אל התחלת השימוש ותזדקק לכתובת ה-URL ולסיסמה של השרת כדי להתחבר שוב."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tornerai all'introduzione e avrai bisogno dell'URL e della password del server per accedere di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "オンボーディングに戻ります。再度サインインするにはサーバのURLとパスワードが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "시작하기 화면으로 돌아가며, 다시 로그인하려면 서버 URL과 비밀번호가 필요해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "U keert terug naar de introductie en hebt de server-URL en het wachtwoord nodig om opnieuw in te loggen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wrócisz do wprowadzenia i będziesz potrzebować adresu URL serwera oraz hasła, aby zalogować się ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Você voltará à introdução e precisará do URL e da senha do servidor para entrar novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Вы вернётесь к введению, и для повторного входа вам понадобятся URL-адрес сервера и пароль."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tanıtıma geri döneceksiniz ve yeniden giriş yapmak için sunucu URL'sine ve parolasına ihtiyacınız olacak."
