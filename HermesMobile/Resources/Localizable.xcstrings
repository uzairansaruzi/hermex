    "Steering hint" : {"localizations":{"de":{"stringUnit":{"state":"needs_review","value":"Steuerungshinweis"}},"es":{"stringUnit":{"state":"needs_review","value":"Sugerencia de dirección"}},"fr":{"stringUnit":{"state":"needs_review","value":"Indication d'orientation"}},"it":{"stringUnit":{"state":"needs_review","value":"Suggerimento di guida"}},"pl":{"stringUnit":{"state":"needs_review","value":"Wskazówka sterowania"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Dica de direcionamento"}},"nl":{"stringUnit":{"state":"needs_review","value":"Bijstuurhint"}},"tr":{"stringUnit":{"state":"needs_review","value":"Yönlendirme ipucu"}},"ru":{"stringUnit":{"state":"needs_review","value":"Подсказка для направления"}},"ja":{"stringUnit":{"state":"needs_review","value":"誘導ヒント"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"引导提示"}},"ko":{"stringUnit":{"state":"needs_review","value":"유도 힌트"}},"ar":{"stringUnit":{"state":"needs_review","value":"تلميح التوجيه"}},"he":{"stringUnit":{"state":"needs_review","value":"רמז ההכוונה"}},"ur":{"stringUnit":{"state":"needs_review","value":"رہنمائی کا اشارہ"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"引導提示"}},"zh-HK":{"stringUnit":{"state":"needs_review","value":"引導提示"}}}},
    "Steering hint was not consumed before the response ended, so it was queued for the next turn." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لم يُستهلَك تلميح التوجيه قبل انتهاء الرد، لذا وُضع في قائمة الانتظار للدور التالي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Steuerungshinweis wurde nicht verarbeitet, bevor die Antwort endete, daher wurde er für den nächsten Zug in die Warteschlange gestellt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La sugerencia de dirección no se procesó antes de que terminara la respuesta, por lo que se puso en cola para el siguiente turno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L'indication d'orientation n'a pas été utilisée avant la fin de la réponse ; elle a été mise en attente pour le prochain tour."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "רמז ההכוונה לא נצרך לפני שהתגובה הסתיימה, ולכן הוכנס לתור עבור התור הבא."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il suggerimento di guida non è stato recepito prima della fine della risposta, quindi è stato messo in coda per il turno successivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "応答が終了する前に誘導ヒントが使用されなかったため、次のターンのためにキューに入れられました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "응답이 끝나기 전에 유도 힌트가 사용되지 않아 다음 차례를 위해 대기열에 추가되었어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De bijstuurhint is niet verwerkt voordat het antwoord eindigde, dus is deze in de wachtrij geplaatst voor de volgende beurt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wskazówka sterowania nie została wykorzystana przed zakończeniem odpowiedzi i trafiła do kolejki na następną turę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A dica de direcionamento não foi consumida antes de a resposta terminar, então ela foi colocada na fila para o próximo turno."
          }
        },
        "ru" : {
          "stringUnit" : {
