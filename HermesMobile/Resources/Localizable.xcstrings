        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "آپ تعارف پر واپس جائیں گے اور دوبارہ سائن اِن کرنے کے لیے سرور URL اور پاس ورڈ درکار ہوں گے۔"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
