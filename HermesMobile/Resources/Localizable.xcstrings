          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "برانچ تبدیل ہو گئی، لیکن محفوظ کردہ تبدیلیاں بحال نہیں ہو سکیں۔"
          }
        },
        "zh-Hant" : {
