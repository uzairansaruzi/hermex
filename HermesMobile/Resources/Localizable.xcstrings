          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "موجودہ جواب میں خلل ڈالا اور آپ کا پیغام اگلی بار بھیجنے کے لیے قطار میں لگا دیا۔"
          }
