    "On-device only" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Nur auf dem Gerät" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Solo en el dispositivo" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Sur l’appareil uniquement" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Solo sul dispositivo" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Tylko na urządzeniu" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Somente no dispositivo" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Alleen op apparaat" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Yalnızca cihazda" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Только на устройстве" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "デバイスのみ" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "仅限设备端" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "기기에서만" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "الجهاز فقط" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "במכשיר בלבד" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "صرف ڈیوائس" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "僅限裝置端" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "僅限裝置端" } } } },
    "On-device only keeps composer dictation audio off your Hermes server." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "„Nur auf dem Gerät“ hält das Diktataudio des Eingabefelds von deinem Hermes-Server fern." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "«Solo en el dispositivo» mantiene el audio del dictado del editor fuera de tu servidor de Hermes." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "« Sur l’appareil uniquement » garde l’audio de dictée du champ de saisie hors de votre serveur Hermes." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "«Solo sul dispositivo» tiene l’audio della dettatura del compositore fuori dal tuo server Hermes." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Tryb „Tylko na urządzeniu” nie wysyła dźwięku dyktowania z edytora na serwer Hermes." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "“Somente no dispositivo” mantém o áudio do ditado do compositor fora do seu servidor Hermes." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "‘Alleen op apparaat’ houdt dicteeraudio van het invoerveld weg van je Hermes-server." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Yalnızca cihazda seçeneği, yazma alanındaki dikte sesini Hermes sunucunuzdan uzak tutar." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Режим «Только на устройстве» не передаёт аудио диктовки из поля ввода на ваш сервер Hermes." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "「デバイスのみ」では、入力欄の音声入力の音声がHermesサーバーに送信されません。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "“仅限设备端”可确保编写器的听写音频不会发送到你的 Hermes 服务器。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "‘기기에서만’을 선택하면 작성기 받아쓰기 오디오가 Hermes 서버로 전송되지 않습니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "يُبقي خيار «الجهاز فقط» صوت الإملاء في محرر الرسائل بعيدًا عن خادم Hermes." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "האפשרות ״במכשיר בלבד״ שומרת את שמע ההכתבה בתיבת הכתיבה מחוץ לשרת Hermes שלך." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "«صرف ڈیوائس» کمپوزر کی ڈکٹیشن آڈیو کو آپ کے Hermes سرور سے دور رکھتا ہے۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "「僅限裝置端」可確保撰寫器的聽寫音訊不會傳送到你的 Hermes 伺服器。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "「僅限裝置端」可確保撰寫器的聽寫音訊不會傳送到你的 Hermes 伺服器。" } } } },
    "On-device speech recognition is not available for the current locale." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Die Spracherkennung auf dem Gerät ist für die aktuelle Sprachregion nicht verfügbar." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "El reconocimiento de voz en el dispositivo no está disponible para el idioma actual." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "La reconnaissance vocale sur l’appareil n’est pas disponible pour la langue actuelle." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Il riconoscimento vocale sul dispositivo non è disponibile per la lingua corrente." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Rozpoznawanie mowy na urządzeniu jest niedostępne dla bieżących ustawień regionalnych." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "O reconhecimento de fala no dispositivo não está disponível para o idioma atual." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Spraakherkenning op het apparaat is niet beschikbaar voor de huidige landinstelling." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Cihaz üzerinde konuşma tanıma mevcut yerel ayar için kullanılamıyor." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Распознавание речи на устройстве недоступно для текущей локали." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "現在のロケールではデバイス上の音声認識を利用できません。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "当前语言区域不支持设备端语音识别。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "현재 지역에서는 기기 내 음성 인식을 사용할 수 없습니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "التعرف على الكلام على الجهاز غير متاح للغة الحالية." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "זיהוי דיבור במכשיר אינו זמין עבור האזור הנוכחי." } }, "ur" : { "stringUnit"