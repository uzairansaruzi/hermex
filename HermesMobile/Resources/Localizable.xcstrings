        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مکمل شدہ باری کی سوچ، ٹول کالز اور عبوری جوابات کو ایک قطار کے پیچھے سمیٹ دیتا ہے جو بتاتی ہے کہ کتنا وقت لگا۔ کھولنے کے لیے قطار پر ٹیپ کریں۔"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "將已完成回合的思考、工具呼叫和中途回覆摺疊到一行之後，並顯示所花時間。點一下該行即可展開。"
          }
        },
        "zh-Hans" : {
