    "The Dispatcher skips Ready Cards without an Assigned Profile." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "يتخطى المرسل البطاقات الجاهزة بدون ملف تعريف مخصص." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Dispatcher überspringt bereite Karten ohne zugewiesenes Profil." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "El Dispatcher omite las tarjetas listas sin un perfil asignado." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le répartiteur ignore les cartes prêtes sans profil attribué." } },
        "he" : { "stringUnit" : { "state" : "translated", "value" : "השולח מדלג על כרטיסים מוכנים ללא פרופיל מוקצה." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Il Dispatcher salta le Carte Pronte senza un Profilo Assegnato." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ディスパッチャは、プロファイルが割り当てられていない Ready Card をスキップします。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "Dispatcher는 할당된 프로필 없이 Ready Card를 건너뜁니다." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "De coördinator slaat gereedkaarten zonder toegewezen profiel over." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Dyspozytor pomija Gotowe Karty bez przypisanego profilu." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O Dispatcher ignora os cartões prontos sem um perfil atribuído." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Диспетчер пропускает Готовые карты без Присвоенного профиля." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Gönderici, Atanmış Profili olmayan Hazır Kartları atlar." } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "ڈسپیچر کسی تفویض شدہ پروفائل کے بغیر تیار کارڈز کو چھوڑ دیتا ہے۔" } },
        "zh-HK" : { "stringUnit" : { "state" : "translated", "value" : "調度員會跳過沒有分配設定檔的就緒卡。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "调度员会跳过没有分配配置文件的就绪卡。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "調度員會跳過沒有分配設定檔的就緒卡。" } }
      }
    },
    "This Card changed on the server after the editor opened. Your draft has been preserved." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "تم تغيير هذه البطاقة على الخادم بعد فتح المحرر. لقد تم الحفاظ على مسودتك." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Diese Karte wurde auf dem Server geändert, nachdem der Editor geöffnet wurde. Ihr Entwurf wurde gespeichert." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Esta tarjeta cambió en el servidor después de que se abrió el editor. Su borrador se ha conservado." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Cette carte a changé sur le serveur après l'ouverture de l'éditeur. Votre brouillon a été conservé." } },
        "he" : { "stringUnit" : { "state" : "translated", "value" : "כרטיס זה השתנה בשרת לאחר פתיחת העורך. הטיוטה שלך נשמרה." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Questa carta è cambiata sul server dopo l'apertura dell'editor. La tua bozza è stata conservata." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このカードは、エディタを開いた後、サーバー上で変更されました。下書きは保存されました。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 카드는 에디터가 열린 후 서버에서 변경되었습니다. 초안이 보존되었습니다." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Deze kaart is op de server gewijzigd nadat de editor was geopend. Uw concept is bewaard gebleven." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Ta karta uległa zmianie na serwerze po otwarciu edytora. Twoja wersja robocza została zachowana." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Este cartão mudou no servidor após a abertura do editor. Seu rascunho foi preservado." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Эта карта изменилась на сервере после открытия редактора. Ваш черновик сохранен." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu Kart editör açıldıktan sonra sunucuda değişti. Taslağınız korunmuştur." } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "ایڈیٹر کھلنے کے بعد یہ کارڈ سرور پر بدل گیا۔ آپ کا مسودہ محفوظ کر لیا گیا ہے۔" } },
        "zh-HK" : { "stringUnit" : { "state" : "translated", "value" : "編輯器開啟後，這張卡在伺服器上發生了變化。您的草稿已儲存。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "编辑器打开后，这张卡在服务器上发生了变化。您的草稿已保存。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "編輯器開啟後，這張卡在伺服器上發生了變化。您的草稿已儲存。" } }
      }
    },
