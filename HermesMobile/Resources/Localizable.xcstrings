    "Reset rating prompt state" : {"localizations":{"de":{"stringUnit":{"state":"needs_review","value":"Status der Bewertungsanfrage zurücksetzen"}},"es":{"stringUnit":{"state":"needs_review","value":"Restablecer el estado de la solicitud de valoración"}},"fr":{"stringUnit":{"state":"needs_review","value":"Réinitialiser l’état de la demande d’évaluation"}},"it":{"stringUnit":{"state":"needs_review","value":"Reimposta lo stato della richiesta di valutazione"}},"pl":{"stringUnit":{"state":"needs_review","value":"Wyzeruj stan prośby o ocenę"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Redefinir o estado da solicitação de avaliação"}},"nl":{"stringUnit":{"state":"needs_review","value":"Status van beoordelingsverzoek resetten"}},"tr":{"stringUnit":{"state":"needs_review","value":"Değerlendirme istemi durumunu sıfırla"}},"ru":{"stringUnit":{"state":"needs_review","value":"Сбросить состояние запроса оценки"}},"ja":{"stringUnit":{"state":"needs_review","value":"評価リクエストの状態をリセット"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"重置评分提示状态"}},"ko":{"stringUnit":{"state":"needs_review","value":"평가 요청 상태 초기화"}},"ar":{"stringUnit":{"state":"needs_review","value":"إعادة تعيين حالة طلب التقييم"}},"he":{"stringUnit":{"state":"needs_review","value":"איפוס מצב בקשת הדירוג"}},"ur":{"stringUnit":{"state":"needs_review","value":"درجہ بندی کی درخواست کی حالت ری سیٹ کریں"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"重設評分提示狀態"}},"zh-HK":{"stringUnit":{"state":"needs_review","value":"重設評分提示狀態"}}}},
    "Message %@" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Message %@"}},"de":{"stringUnit":{"state":"needs_review","value":"Nachricht an %@"}},"es":{"stringUnit":{"state":"needs_review","value":"Mensaje a %@"}},"fr":{"stringUnit":{"state":"needs_review","value":"Message à %@"}},"it":{"stringUnit":{"state":"needs_review","value":"Messaggio a %@"}},"pl":{"stringUnit":{"state":"needs_review","value":"Wiadomość do %@"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Mensagem para %@"}},"nl":{"stringUnit":{"state":"needs_review","value":"Bericht aan %@"}},"tr":{"stringUnit":{"state":"needs_review","value":"%@ için mesaj"}},"ru":{"stringUnit":{"state":"needs_review","value":"Сообщение в %@"}},"ja":{"stringUnit":{"state":"needs_review","value":"%@ にメッセージ"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"向 %@ 发送消息"}},"ko":{"stringUnit":{"state":"needs_review","value":"%@에 메시지 보내기"}},"ar":{"stringUnit":{"state":"needs_review","value":"رسالة إلى %@"}},"he":{"stringUnit":{"state":"needs_review","value":"הודעה אל %@"}},"ur":{"stringUnit":{"state":"needs_review","value":"%@ کو پیغام"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"傳送訊息給 %@"}},"zh-HK":{"stringUnit":{"state":"needs_review","value":"傳送訊息給 %@"}}}},
    "Retry send" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Retry send"}},"de":{"stringUnit":{"state":"needs_review","value":"Senden erneut versuchen"}},"es":{"stringUnit":{"state":"needs_review","value":"Reintentar envío"}},"fr":{"stringUnit":{"state":"needs_review","value":"Réessayer l’envoi"}},"it":{"stringUnit":{"state":"needs_review","value":"Riprova invio"}},"pl":{"stringUnit":{"state":"needs_review","value":"Ponów wysyłanie"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Tentar enviar novamente"}},"nl":{"stringUnit":{"state":"needs_review","value":"Verzenden opnieuw proberen"}},"tr":{"stringUnit":{"state":"needs_review","value":"Göndermeyi yeniden dene"}},"ru":{"stringUnit":{"state":"needs_review","value":"Повторить отправку"}},"ja":{"stringUnit":{"state":"needs_review","value":"送信を再試行"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"重试发送"}},"ko":{"stringUnit":{"state":"needs_review","value":"전송 다시 시도"}},"ar":{"stringUnit":{"state":"needs_review","value":"إعادة محاولة الإرسال"}},"he":{"stringUnit":{"state":"needs_review","value":"ניסיון שליחה חוזר"}},"ur":{"stringUnit":{"state":"needs_review","value":"دوبارہ بھیجنے کی کوشش کریں"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"重試傳送"}},"zh-HK":{"stringUnit":{"state":"needs_review","value":"重試傳送"}}}},
    "Stop every bot in this room" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Stop every bot in this room"}},"de":{"stringUnit":{"state":"needs_review","value":"Alle Bots in diesem Raum stoppen"}},"es":{"stringUnit":{"state":"needs_review","value":"Detener todos los bots de esta sala"}},"fr":{"stringUnit":{"state":"needs_review","value":"Arrêter tous les bots de cette salle"}},"it":{"stringUnit":{"state":"needs_review","value":"Ferma tutti i bot in questa stanza"}},"pl":{"stringUnit":{"state":"needs_review","value":"Zatrzymaj wszystkie boty w tym pokoju"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Parar todos os bots nesta sala"}},"nl":{"stringUnit":{"state":"needs_review","value":"Stop alle bots in deze ruimte"}},"tr":{"stringUnit":{"state":"needs_review","value":"Bu odadaki tüm botları durdur"}},"ru":{"stringUnit":{"state":"needs_review","value":"Остановить всех ботов в этой комнате"}},"ja":{"stringUnit":{"state":"needs_review","value":"このルームのすべてのボットを停止"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"停止此聊天室中的所有机器人"}},"ko":{"stringUnit":{"state":"needs_review","value":"이 방의 모든 봇 중지"}},"ar":{"stringUnit":{"state":"needs_review","value":"إيقاف كل الروبوتات في هذه الغرفة"}},"he":{"stringUnit":{"state":"needs_review","value":"עצירת כל הבוטים בחדר הזה"}},"ur":{"stringUnit":{"state":"needs_review","value":"اس کمرے کے تمام بوٹس روکیں"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"停止此聊天室中的所有機器人"}},"zh-HK":{"stringUnit":{"state":"needs_review","value":"停止此聊天室中的所有機械人"}}}},
    "Everyone" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Everyone"}},"de":{"stringUnit":{"state":"needs_review","value":"Alle"}},"es":{"stringUnit":{"state":"needs_review","value":"Todos"}},"fr":{"stringUnit":{"state":"needs_review","value":"Tout le monde"}},"it":{"stringUnit":{"state":"needs_review","value":"Tutti"}},"pl":{"stringUnit":{"state":"needs_review","value":"Wszyscy"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Todos"}},"nl":{"stringUnit":{"state":"needs_review","value":"Iedereen"}},"tr":{"stringUnit":{"state":"needs_review","value":"Herkes"}},"ru":{"stringUnit":{"state":"needs_review","value":"Все"}},"ja":{"stringUnit":{"state":"needs_review","value":"全員"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"所有人"}},"ko":{"stringUnit":{"state":"needs_review","value":"모두"}},"ar":{"stringUnit":{"state":"needs_review","value":"الجميع"}},"he":{"stringUnit":{"state":"needs_review","value":"כולם"}},"ur":{"stringUnit":{"state":"needs_review","value":"سب"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"所有人"}},"zh-HK":{"stringUnit":{"state":"needs_review","value":"所有人"}}}},
    "Outcome unknown. Reconnect to check the room. Commands are never resent automatically." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Outcome unknown. Reconnect to check the room. Commands are never resent automatically."}},"de":{"stringUnit":{"state":"needs_review","value":"Ergebnis unbekannt. Verbinde dich erneut, um den Raum zu prüfen. Befehle werden nie automatisch erneut gesendet."}},"es":{"stringUnit":{"state":"needs_review","value":"Resultado desconocido. Vuelve a conectarte para comprobar la sala. Los comandos nunca se reenvían automáticamente."}},"fr":{"stringUnit":{"state":"needs_review","value":"Résultat inconnu. Reconnectez-vous pour vérifier la salle. Les commandes ne sont jamais renvoyées automatiquement."}},"it":{"stringUnit":{"state":"needs_review","value":"Esito sconosciuto. Riconnettiti per controllare la stanza. I comandi non vengono mai reinviati automaticamente."}},"pl":{"stringUnit":{"state":"needs_review","value":"Wynik nieznany. Połącz się ponownie, aby sprawdzić pokój. Polecenia nigdy nie są wysyłane ponownie automatycznie."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Resultado desconhecido. Reconecte-se para verificar a sala. Os comandos nunca são reenviados automaticamente."}},"nl":{"stringUnit":{"state":"needs_review","value":"Resultaat onbekend. Maak opnieuw verbinding om de ruimte te controleren. Opdrachten worden nooit automatisch opnieuw verzonden."}},"tr":{"stringUnit":{"state":"needs_review","value":"Sonuç bilinmiyor. Odayı kontrol etmek için yeniden bağlanın. Komutlar asla otomatik olarak yeniden gönderilmez."}},"ru":{"stringUnit":{"state":"needs_review","value":"Результат неизвестен. Подключитесь снова, чтобы проверить комнату. Команды никогда не отправляются повторно автоматически."}},"ja":{"stringUnit":{"state":"needs_review","value":"結果は不明です。再接続してルームを確認してください。コマンドが自動的に再送信されることはありません。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"结果未知。请重新连接以查看聊天室。命令绝不会自动重新发送。"}},"ko":{"stringUnit":{"state":"needs_review","value":"결과를 알 수 없습니다. 다시 연결하여 방을 확인하세요. 명령은 자동으로 재전송되지 않습니다."}},"ar":{"stringUnit":{"state":"needs_review","value":"النتيجة غير معروفة. أعد الاتصال للتحقق من الغرفة. لا تُعاد الأوامر تلقائيًا أبدًا."}},"he":{"stringUnit":{"state":"needs_review","value":"התוצאה לא ידועה. יש להתחבר מחדש כדי לבדוק את החדר. פקודות לעולם אינן נשלחות שוב אוטומטית."}},"ur":{"stringUnit":{"state":"needs_review","value":"نتیجہ نامعلوم ہے۔ کمرہ دیکھنے کے لیے دوبارہ جڑیں۔ کمانڈز کبھی خودکار طور پر دوبارہ نہیں بھیجی جاتیں۔"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"結果未知。請重新連線以查看聊天室。命令絕不會自動重新傳送。"}},"zh-HK":{"stringUnit":{"state":"needs_review","value":"結果未知。請重新連線以查看聊天室。指令絕不會自動重新傳送。"}}}},

