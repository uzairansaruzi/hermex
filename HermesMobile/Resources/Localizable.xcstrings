    "Group name" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Gruppenname" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Nombre del grupo" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Nom du groupe" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Nome del gruppo" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Nazwa grupy" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Nome do grupo" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Groepsnaam" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Grup adı" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Название группы" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "グループ名" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "群组名称" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "그룹 이름" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "اسم المجموعة" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "שם הקבוצה" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "گروپ کا نام" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "群組名稱" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "群組名稱" } } } },
    "Group options" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Gruppenoptionen" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Opciones del grupo" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Options du groupe" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Opzioni gruppo" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Opcje grupy" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Opções do grupo" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Groepsopties" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Grup seçenekleri" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Параметры группы" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "グループのオプション" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "群组选项" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "그룹 옵션" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "خيارات المجموعة" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "אפשרויות קבוצה" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "گروپ کے اختیارات" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "群組選項" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "群組選項" } } } },
    "Groups can have up to six members." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Gruppen können bis zu sechs Mitglieder haben." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Los grupos pueden tener hasta seis miembros." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Un groupe peut compter jusqu’à six membres." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "I gruppi possono avere fino a sei membri." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Grupy mogą mieć maksymalnie sześciu członków." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Os grupos podem ter até seis membros." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Groepen kunnen maximaal zes leden hebben." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Gruplarda en fazla altı üye olabilir." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "В группе может быть не более шести участников." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "グループのメンバーは最大6つまでです。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "群组最多可有 6 名成员。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "그룹에는 멤버를 최대 6개까지 둘 수 있습니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "يمكن أن تضم المجموعات ستة أعضاء كحد أقصى." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "בקבוצה יכולים להיות עד שישה חברים." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "گروپس میں زیادہ سے زیادہ چھ ممبرز ہو سکتے ہیں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "群組最多可有 6 位成員。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "群組最多可有 6 位成員。" } } } },
    "Hermes Desktop answers this by itself, and the bot carries on without it if it cannot. There is nothing to do here or at the Mac." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop beantwortet das selbst, und der Bot macht ohne weiter, falls das nicht klappt. Hier oder am Mac ist nichts zu tun." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop lo resuelve por sí solo y, si no puede, el bot continúa sin ello. No hay nada que hacer aquí ni en el Mac." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop s’en charge seul, et le bot continue sans cela s’il n’y parvient pas. Il n’y a rien à faire ici ni sur le Mac." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop risponde da solo e, se non ci riesce, il bot prosegue senza. Non c’è nulla da fare qui o sul Mac." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop obsługuje to samodzielnie, a jeśli nie może, bot kontynuuje bez tego. Nie trzeba nic robić ani tutaj, ani przy Macu." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "O Hermes Desktop responde a isto sozinho, e o bot continua sem isso se não conseguir. Não há nada a fazer aqui nem no Mac." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop beantwoordt dit zelf, en de bot gaat zonder verder als dat niet lukt. Hier of op de Mac hoef je niets te doen." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop bunu kendisi yanıtlar; yanıtlayamazsa bot bu olmadan devam eder. Burada veya Mac’te yapılacak bir şey yok." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop обрабатывает это сам, а если не может, бот продолжает без этого. Ни здесь, ни за Mac ничего делать не нужно." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktopがこれに自動で対応し、対応できない場合もボットはそれなしで続行します。ここでもMacでも操作は不要です。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop 会自行处理此请求；如果无法处理，机器人会跳过它继续运行。你无需在此处或 Mac 上进行任何操作。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop이 이를 자동으로 처리하며, 처리할 수 없으면 봇은 이것 없이 계속 진행합니다. 여기나 Mac에서 할 일은 없습니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "يجيب Hermes Desktop عن هذا بنفسه، ويتابع الروبوت من دونه إن تعذّر ذلك. لا يلزم فعل شيء هنا أو على جهاز Mac." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "‏Hermes Desktop עונה על כך בעצמו, והבוט ממשיך בלעדיו אם אינו יכול. אין צורך לעשות דבר כאן או ב‑Mac." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop اس کا جواب خود دیتا ہے، اور اگر نہ دے سکے تو بوٹ اس کے بغیر جاری رکھتا ہے۔ یہاں یا Mac پر کچھ کرنے کی ضرورت نہیں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop 會自行處理此請求；若無法處理，機器人會略過它繼續執行。你無需在此處或 Mac 上進行任何操作。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop 會自行處理此請求；若無法處理，機械人會略過它繼續執行。你無需在此處或 Mac 上進行任何操作。" } } } },
    "Hermes Desktop is handling this" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop kümmert sich darum" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop se está encargando" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop s’en charge" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop se ne sta occupando" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop się tym zajmuje" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "O Hermes Desktop está cuidando disso" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop handelt dit af" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop bununla ilgileniyor" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop занимается этим" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktopが対応中" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop 正在处理" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop이 처리 중" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "يتولى Hermes Desktop هذا الأمر" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "‏Hermes Desktop מטפל בזה" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop یہ سنبھال رہا ہے" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop 正在處理" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop 正在處理" } } } },
    "Hermes Desktop walks someone through this on the Mac. Skip it here and the bot carries on without the server." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop führt jemanden am Mac durch diesen Schritt. Überspringst du ihn hier, macht der Bot ohne den Server weiter." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop guía a alguien en el Mac para hacerlo. Omítelo aquí y el bot continuará sin el servidor." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop guide quelqu’un sur le Mac pour cette étape. Ignorez-la ici et le bot continuera sans le serveur." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop guida qualcuno in questo passaggio sul Mac. Saltalo qui e il bot prosegue senza il server." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop przeprowadza przez to kogoś przy Macu. Pomiń to tutaj, a bot będzie kontynuował bez serwera." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "O Hermes Desktop guia alguém por isto no Mac. Pule aqui e o bot continua sem o servidor." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop begeleidt iemand hierbij op de Mac. Sla het hier over en de bot gaat verder zonder de server." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop, Mac başındaki birine bu adımda yol gösterir. Burada atlarsanız bot sunucu olmadan devam eder." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop проведёт человека через это на Mac. Пропустите здесь, и бот продолжит без сервера." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes DesktopがMac上でこの手順を案内します。ここでスキップすると、ボットはサーバーなしで続行します。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop 会在 Mac 上引导用户完成此操作。如果在此跳过，机器人将在没有该服务器的情况下继续运行。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop이 Mac에서 이 과정을 안내합니다. 여기서 건너뛰면 봇은 서버 없이 계속 진행합니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "يرشد Hermes Desktop شخصًا خلال هذا على جهاز Mac. تخطَّه هنا وسيتابع الروبوت من دون الخادم." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "‏Hermes Desktop מדריך מישהו בתהליך הזה ב‑Mac. אם מדלגים כאן, הבוט ממשיך בלי השרת." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop اس Mac پر کسی کو اس عمل سے گزارتا ہے۔ یہاں اسے چھوڑ دیں تو بوٹ سرور کے بغیر جاری رکھے گا۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop 會在 Mac 上引導使用者完成此操作。若在此略過，機器人將在沒有該伺服器的情況下繼續執行。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop 會在 Mac 上引導用戶完成此操作。若在此略過，機械人將在沒有該伺服器的情況下繼續執行。" } } } },
    "Hermes Media" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes-Medien" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Multimedia de Hermes" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Média Hermes" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Media Hermes" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Multimedia Hermes" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Mídia do Hermes" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes-media" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Medyası" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Медиа Hermes" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermesメディア" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes 媒体" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes 미디어" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "وسائط Hermes" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "מדיה של Hermes" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes میڈیا" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes 媒體" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes 媒體" } } } },
