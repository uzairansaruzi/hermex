    "Enter a Hermes HTTP or HTTPS address without a path, credentials or query." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Gib eine Hermes-HTTP- oder -HTTPS-Adresse ohne Pfad, Anmeldedaten oder Abfrage ein." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Introduce una dirección HTTP o HTTPS de Hermes sin ruta, credenciales ni consulta." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Saisissez une adresse Hermes HTTP ou HTTPS sans chemin, identifiants ni requête." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Inserisci un indirizzo Hermes HTTP o HTTPS senza percorso, credenziali o query." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Wpisz adres HTTP lub HTTPS serwera Hermes bez ścieżki, danych logowania ani zapytania." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Digite um endereço HTTP ou HTTPS do Hermes sem caminho, credenciais ou query." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Voer een Hermes-HTTP- of -HTTPS-adres in zonder pad, inloggegevens of query." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Yol, kimlik bilgisi veya sorgu içermeyen bir Hermes HTTP ya da HTTPS adresi girin." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Введите HTTP- или HTTPS-адрес Hermes без пути, учётных данных и параметров запроса." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "パス、認証情報、クエリを含まないHermesのHTTPまたはHTTPSアドレスを入力してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "请输入不含路径、凭据或查询参数的 Hermes HTTP 或 HTTPS 地址。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "경로, 자격 증명, 쿼리가 없는 Hermes HTTP 또는 HTTPS 주소를 입력하세요." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "أدخل عنوان Hermes بصيغة HTTP أو HTTPS بدون مسار أو بيانات اعتماد أو استعلام." } }, "he" : { "stringUnit" : { "state" :