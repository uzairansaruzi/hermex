    "Refresh failed. Try again before using Dispatcher." : { "localizations" : {
      "de" : { "stringUnit" : { "state" : "translated", "value" : "Aktualisierung fehlgeschlagen. Versuche es erneut, bevor du den Dispatcher verwendest." } },
      "es" : { "stringUnit" : { "state" : "translated", "value" : "La actualización falló. Inténtalo de nuevo antes de usar el despachador." } },
      "fr" : { "stringUnit" : { "state" : "translated", "value" : "L’actualisation a échoué. Réessayez avant d’utiliser le répartiteur." } },
      "it" : { "stringUnit" : { "state" : "translated", "value" : "Aggiornamento non riuscito. Riprova prima di usare il dispatcher." } },
      "pl" : { "stringUnit" : { "state" : "translated", "value" : "Odświeżanie nie powiodło się. Spróbuj ponownie przed użyciem dyspozytora." } },
      "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A atualização falhou. Tente novamente antes de usar o despachador." } },
      "nl" : { "stringUnit" : { "state" : "translated", "value" : "Vernieuwen mislukt. Probeer het opnieuw voordat je de dispatcher gebruikt." } },
      "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yenileme başarısız oldu. Dağıtıcıyı kullanmadan önce tekrar deneyin." } },
      "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не удалось обновить данные. Повторите попытку перед использованием диспетчера." } },
      "ja" : { "stringUnit" : { "state" : "translated", "value" : "更新に失敗しました。ディスパッチャーを使用する前に再試行してください。" } },
      "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "刷新失败。请重试后再使用调度器。" } },
      "ko" : { "stringUnit" : { "state" : "translated", "value" : "새로 고침에 실패했습니다. 디스패처를 사용하기 전에 다시 시도하세요." } },
      "ar" : { "stringUnit" : { "state" : "translated", "value" : "فشل التحديث. حاول مرة أخرى قبل استخدام الموزّع." } },
      "he" : { "stringUnit" : { "state" : "translated", "value" : "הרענון נכשל. יש לנסות שוב לפני השימוש במפיץ." } },
      "ur" : { "stringUnit" : { "state" : "translated", "value" : "ریفریش ناکام ہو گیا۔ ڈسپیچر استعمال کرنے سے پہلے دوبارہ کوشش کریں۔" } },
      "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "重新整理失敗。請重試後再使用調度器。" } },
      "zh-HK" : { "stringUnit" : { "state" : "translated", "value" : "重新整理失敗。請重試後再使用調度器。" } }
    } },
