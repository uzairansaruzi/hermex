    "Enter a commit message first." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Gib zuerst eine Commit-Nachricht ein." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Escribe primero un mensaje de confirmación." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Saisissez d’abord un message de commit." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Inserisci prima un messaggio di commit." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Najpierw wpisz komunikat zatwierdzenia." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Digite uma mensagem de commit primeiro." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Voer eerst een commitbericht in." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Önce bir commit mesajı girin." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Сначала введите сообщение коммита." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "先にコミットメッセージを入力してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "请先输入提交信息。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "먼저 커밋 메시지를 입력하세요." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "أدخل رسالة الالتزام أولًا." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "יש להזין קודם הודעת התחייבות." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "پہلے کمٹ پیغام درج کریں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "請先輸入提交訊息。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "請先輸入提交訊息。" } } } },
