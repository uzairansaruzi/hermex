    "Use letters or numbers; “%@” is not allowed as a Profile name." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Verwende Buchstaben oder Zahlen; „%@“ ist als Profilname nicht erlaubt." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Usa letras o números; “%@” no está permitido como nombre de perfil." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Utilisez des lettres ou des chiffres ; « %@ » n’est pas autorisé comme nom de profil." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Usa lettere o numeri; “%@” non è consentito come nome del profilo." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Użyj liter lub cyfr; „%@” nie jest dozwolone jako nazwa profilu." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Use letras ou números; “%@” não é permitido como nome de perfil." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Gebruik letters of cijfers; ‘%@’ is niet toegestaan als profielnaam." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Harf veya rakam kullanın; “%@” profil adı olarak kullanılamaz." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Используйте буквы или цифры; «%@» нельзя использовать как имя профиля." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "英字または数字を使ってください。「%@」はプロファイル名に使えません。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "请使用字母或数字；“%@”不能用作配置名称。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "문자나 숫자를 사용하세요. “%@”은(는) 프로필 이름으로 사용할 수 없습니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "استخدم حروفًا أو أرقامًا؛ ”%@“ غير مسموح به كاسم ملف تعريف." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "השתמשו באותיות או במספרים; ״%@״ אינו מותר כשם פרופיל." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "حروف یا نمبر استعمال کریں؛ ”%@“ پروفائل کے نام کے طور پر جائز نہیں ہے۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "請使用字母或數字；「%@」不能作為設定檔名稱。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "請使用字母或數字；「%@」不能作為設定檔名稱。" } } } },
    "A bot named “%@” already exists on this Hermes." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Auf diesem Hermes gibt es bereits einen Bot namens „%@“." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Ya existe un bot llamado “%@” en este Hermes." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Un bot nommé « %@ » existe déjà sur ce Hermes." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Su questo Hermes esiste già un bot chiamato “%@”." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Bot o nazwie „%@” już istnieje na tym Hermesie." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Já existe um bot chamado “%@” neste Hermes." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Er bestaat al een bot met de naam ‘%@’ op deze Hermes." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Bu Hermes’te “%@” adlı bir bot zaten var." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Бот с именем «%@» уже существует на этом Hermes." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "この Hermes には「%@」という名前のボットがすでにあります。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "此 Hermes 上已存在名为“%@”的机器人。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "이 Hermes에 “%@”이라는 봇이 이미 있습니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "يوجد بالفعل بوت باسم ”%@“ على Hermes هذا." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "בוט בשם ״%@״ כבר קיים ב‑Hermes הזה." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "اس Hermes پر ”%@“ نام کا بوٹ پہلے سے موجود ہے۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "此 Hermes 上已有名為「%@」的機器人。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "此 Hermes 上已有名為「%@」的機器人。" } } } },
    "No model is set for this bot yet. Pick one in Edit or in Hermes Desktop before chatting." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Für diesen Bot ist noch kein Modell festgelegt. Wähle vor dem Chatten eines unter „Bearbeiten“ oder in Hermes Desktop." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Este bot aún no tiene un modelo. Elige uno en Editar o en Hermes Desktop antes de chatear." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Aucun modèle n’est encore défini pour ce bot. Choisissez-en un dans Modifier ou dans Hermes Desktop avant de discuter." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Nessun modello impostato per questo bot. Scegline uno in Modifica o in Hermes Desktop prima di chattare." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Ten bot nie ma jeszcze modelu. Wybierz go w Edycji lub w Hermes Desktop przed rozmową." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Nenhum modelo foi definido para este bot ainda. Escolha um em Editar ou no Hermes Desktop antes de conversar." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Er is nog geen model ingesteld voor deze bot. Kies er een via Bewerken of in Hermes Desktop voordat je chat." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Bu bot için henüz bir model ayarlanmadı. Sohbet etmeden önce Düzenle’den veya Hermes Desktop’tan birini seçin." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Для этого бота ещё не задана модель. Выберите её в разделе «Изменить» или в Hermes Desktop перед общением." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "このボットにはまだモデルが設定されていません。チャットの前に「編集」または Hermes Desktop で選んでください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "此机器人尚未设置模型。请先在“编辑”或 Hermes Desktop 中选择一个，再开始聊天。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "이 봇에 아직 모델이 설정되지 않았습니다. 채팅 전에 편집 또는 Hermes Desktop에서 선택하세요." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "لم يتم تعيين نموذج لهذا البوت بعد. اختر واحدًا من ”تعديل“ أو من Hermes Desktop قبل الدردشة." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "עדיין לא הוגדר מודל לבוט הזה. בחרו אחד ב״עריכה״ או ב‑Hermes Desktop לפני שמתחילים לשוחח." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "اس بوٹ کے لیے ابھی کوئی ماڈل سیٹ نہیں ہے۔ چیٹ سے پہلے ترمیم یا Hermes Desktop میں ایک منتخب کریں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "此機器人尚未設定模型。請先在「編輯」或 Hermes Desktop 中選擇一個再開始聊天。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "此機器人尚未設定模型。請先在「編輯」或 Hermes Desktop 中選擇一個再開始聊天。" } } } },
    "Hermes refused this name. It may already exist on the host." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes hat diesen Namen abgelehnt. Vielleicht gibt es ihn auf dem Host schon." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes rechazó este nombre. Puede que ya exista en el host." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes a refusé ce nom. Il existe peut‑être déjà sur l’hôte." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes ha rifiutato questo nome. Potrebbe già esistere sull’host." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes odrzucił tę nazwę. Może już istnieć na hoście." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "O Hermes recusou este nome. Ele pode já existir no host." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes heeft deze naam geweigerd. Mogelijk bestaat hij al op de host." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes bu adı reddetti. Ana makinede zaten olabilir." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes отклонил это имя. Возможно, оно уже есть на хосте." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes がこの名前を拒否しました。ホスト上にすでに存在する可能性があります。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes 拒绝了此名称。主机上可能已存在。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes가 이 이름을 거부했습니다. 호스트에 이미 있을 수 있습니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "رفض Hermes هذا الاسم. قد يكون موجودًا بالفعل على المضيف." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes דחה את השם הזה. ייתכן שהוא כבר קיים במארח." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes نے یہ نام مسترد کر دیا۔ ہو سکتا ہے یہ ہوسٹ پر پہلے سے موجود ہو۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes 拒絕了此名稱。主機上可能已存在。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes 拒絕了此名稱。主機上可能已存在。" } } } },
    "The look was not saved. Edit the bot to set it." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Das Aussehen wurde nicht gespeichert. Bearbeite den Bot, um es festzulegen." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "No se guardó el aspecto. Edita el bot para establecerlo." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "L’apparence n’a pas été enregistrée. Modifiez le bot pour la définir." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "L’aspetto non è stato salvato. Modifica il bot per impostarlo." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Wygląd nie został zapisany. Edytuj bota, aby go ustawić." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "A aparência não foi salva. Edite o bot para defini‑la." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Het uiterlijk is niet opgeslagen. Bewerk de bot om het in te stellen." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Görünüm kaydedilmedi. Ayarlamak için botu düzenleyin." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Внешний вид не сохранён. Измените бота, чтобы задать его." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "見た目は保存されませんでした。ボットを編集して設定してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "外观未保存。请编辑机器人进行设置。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "외모가 저장되지 않았습니다. 봇을 편집하여 설정하세요." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "لم يتم حفظ المظهر. عدّل البوت لتعيينه." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "המראה לא נשמר. ערכו את הבוט כדי להגדיר אותו." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "شکل و صورت محفوظ نہیں ہوئی۔ اسے سیٹ کرنے کے لیے بوٹ میں ترمیم کریں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "外觀未儲存。請編輯機器人以設定。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "外觀未儲存。請編輯機器人以設定。" } } } },
    "Name your bot" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Gib deinem Bot einen Namen" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Ponle nombre a tu bot" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Nommez votre bot" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Dai un nome al tuo bot" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Nazwij swojego bota" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Dê um nome ao seu bot" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Geef je bot een naam" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Botunuza ad verin" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Назовите бота" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "ボットに名前を付ける" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "为机器人命名" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "봇 이름 짓기" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "سمِّ البوت الخاص بك" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "תנו שם לבוט" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "اپنے بوٹ کا نام رکھیں" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "為機器人命名" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "為機器人命名" } } } },
    "Copies %@’s instructions, settings and skills. Its chat stays with the original." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Kopiert die Anweisungen, Einstellungen und Skills von %@. Der Chat bleibt beim Original." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Copia las instrucciones, la configuración y las skills de %@. Su chat se queda con el original." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Copie les instructions, les réglages et les skills de %@. Sa discussion reste avec l’original." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Copia istruzioni, impostazioni e skill di %@. La chat resta con l’originale." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Kopiuje instrukcje, ustawienia i umiejętności bota %@. Czat zostaje przy oryginale." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Copia as instruções, configurações e habilidades de %@. O chat fica com o original." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Kopieert de instructies, instellingen en skills van %@. De chat blijft bij het origineel." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "%@ botunun talimatlarını, ayarlarını ve becerilerini kopyalar. Sohbeti orijinalde kalır." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Копирует инструкции, настройки и навыки бота %@. Его чат остаётся у оригинала." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "%@ の指示、設定、スキルをコピーします。チャットは元のボットに残ります。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "复制 %@ 的指令、设置和技能。其聊天记录保留在原机器人。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "%@의 지침, 설정, 스킬을 복사합니다. 채팅은 원본에 남습니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "ينسخ تعليمات %@ وإعداداته ومهاراته. تبقى دردشته مع الأصل." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "מעתיק את ההוראות, ההגדרות והמיומנויות של %@. הצ׳אט נשאר עם המקור." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "%@ کی ہدایات، ترتیبات اور مہارتیں کاپی کرتا ہے۔ اس کی چیٹ اصل کے ساتھ رہتی ہے۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "複製 %@ 的指令、設定和技能。其聊天記錄留在原機器人。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "複製 %@ 的指令、設定和技能。其聊天記錄留在原機器人。" } } } },
    "Setup" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Einrichtung" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Configuración" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Configuration" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Configurazione" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Konfiguracja" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Configuração" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Instellen" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Kurulum" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Настройка" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "セットアップ" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "设置" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "설정" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "الإعداد" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "הגדרה" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "سیٹ اپ" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "設定" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "設定" } } } },
