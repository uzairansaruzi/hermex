    "Disband Group" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Gruppe auflösen" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Disolver grupo" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Dissoudre le groupe" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Sciogli gruppo" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Rozwiąż grupę" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Dissolver grupo" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Groep opheffen" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Grubu Dağıt" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Распустить группу" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "グループを解散" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "解散群组" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "그룹 해산" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "حلّ المجموعة" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "פירוק הקבוצה" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "گروپ ختم کریں" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "解散群組" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "解散群組" } } } },
    "Disband this group?" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Diese Gruppe auflösen?" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "¿Disolver este grupo?" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Dissoudre ce groupe ?" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Sciogliere questo gruppo?" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Rozwiązać tę grupę?" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Dissolver este grupo?" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Deze groep opheffen?" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Bu grup dağıtılsın mı?" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Распустить эту группу?" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "このグループを解散しますか？" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "解散此群组？" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "이 그룹을 해산할까요?" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "حلّ هذه المجموعة؟" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "לפרק את הקבוצה הזו?" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "یہ گروپ ختم کریں؟" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "解散此群組？" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "解散此群組？" } } } },
