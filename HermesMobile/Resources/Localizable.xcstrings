    "All changes" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Alle Änderungen" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Todos los cambios" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Toutes les modifications" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Tutte le modifiche" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Wszystkie zmiany" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Todas as alterações" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Alle wijzigingen" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Tüm değişiklikler" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Все изменения" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "すべての変更" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "所有更改" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "모든 변경 사항" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "كل التغييرات" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "כל השינויים" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "تمام تبدیلیاں" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "所有更改" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "所有更改" } } } },
    "Allow Photos access to save media from Hermex." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Erlaube den Zugriff auf Fotos, um Medien aus Hermex zu speichern." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Permite el acceso a Fotos para guardar contenido multimedia de Hermex." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Autorisez l’accès à Photos pour enregistrer des médias depuis Hermex." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Consenti l’accesso a Foto per salvare i media da Hermex." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Zezwól na dostęp do Zdjęć, aby zapisywać multimedia z Hermex." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Permita o acesso ao app Fotos para salvar mídias do Hermex." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Sta toegang tot Foto's toe om media uit Hermex op te slaan." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermex’ten medya kaydetmek için Fotoğraflar erişimine izin verin." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Разрешите доступ к Фото, чтобы сохранять медиа из Hermex." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermexからメディアを保存するには「写真」へのアクセスを許可してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "允许访问“照片”以保存来自 Hermex 的媒体。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermex에서 미디어를 저장하려면 사진 접근을 허용하세요." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "اسمح بالوصول إلى الصور لحفظ الوسائط من Hermex." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "יש לאפשר גישה ל״תמונות״ כדי לשמור מדיה מ‑Hermex." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermex سے میڈیا محفوظ کرنے کے لیے Photos تک رسائی کی اجازت دیں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "允許存取「照片」以儲存來自 Hermex 的媒體。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "允許存取「相片」以儲存來自 Hermex 的媒體。" } } } },
    "Allow access in Settings to browse recent photos here." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Erlaube den Zugriff in den Einstellungen, um hier deine letzten Fotos zu durchsuchen." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Permite el acceso en Ajustes para ver aquí tus fotos recientes." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Autorisez l’accès dans Réglages pour parcourir ici vos photos récentes." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Consenti l’accesso in Impostazioni per sfogliare qui le foto recenti." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Zezwól na dostęp w Ustawieniach, aby przeglądać tutaj ostatnie zdjęcia." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Permita o acesso nos Ajustes para ver as fotos recentes aqui." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Sta toegang toe in Instellingen om hier je recente foto's te bekijken." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Son fotoğraflara buradan göz atmak için Ayarlar’da erişime izin verin." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Разрешите доступ в Настройках, чтобы просматривать здесь недавние фото." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "ここで最近の写真を表示するには、設定でアクセスを許可してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "在“设置”中允许访问，即可在此浏览最近的照片。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "여기에서 최근 사진을 보려면 설정에서 접근을 허용하세요." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "اسمح بالوصول في الإعدادات لتصفح الصور الحديثة هنا." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "יש לאפשר גישה בהגדרות כדי לעיין כאן בתמונות אחרונות." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "یہاں حالیہ تصاویر براؤز کرنے کے لیے ترتیبات میں رسائی کی اجازت دیں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "在「設定」中允許存取，即可在此瀏覽最近的照片。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "在「設定」中允許存取，即可在此瀏覽最近的相片。" } } } },
    "Allow camera access in Settings to take a photo for this chat." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Erlaube den Kamerazugriff in den Einstellungen, um ein Foto für diesen Chat aufzunehmen." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Permite el acceso a la cámara en Ajustes para hacer una foto para este chat." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Autorisez l’accès à l’appareil photo dans Réglages pour prendre une photo pour cette discussion." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Consenti l’accesso alla fotocamera in Impostazioni per scattare una foto per questa chat." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Zezwól na dostęp do aparatu w Ustawieniach, aby zrobić zdjęcie do tego czatu." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Permita o acesso à câmera nos Ajustes para tirar uma foto para este chat." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Sta cameratoegang toe in Instellingen om een foto voor deze chat te maken." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Bu sohbet için fotoğraf çekmek üzere Ayarlar’da kamera erişimine izin verin." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Разрешите доступ к камере в Настройках, чтобы сделать фото для этого чата." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "このチャット用に写真を撮るには、設定でカメラへのアクセスを許可してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "在“设置”中允许访问相机，即可为此聊天拍照。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "이 채팅에 사용할 사진을 찍으려면 설정에서 카메라 접근을 허용하세요." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "اسمح بالوصول إلى الكاميرا في الإعدادات لالتقاط صورة لهذه الدردشة." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "יש לאפשר גישה למצלמה בהגדרות כדי לצלם תמונה לצ׳אט הזה." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "اس چیٹ کے واسطے تصویر لینے کے لیے ترتیبات میں کیمرے تک رسائی کی اجازت دیں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "在「設定」中允許存取相機，即可為此聊天拍照。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "在「設定」中允許存取相機，即可為此聊天拍照。" } } } },
