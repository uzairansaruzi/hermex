    "Kanban could not reach the server." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Kanban konnte den Server nicht erreichen." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Kanban no pudo conectar con el servidor." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Kanban n’a pas pu joindre le serveur." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Kanban non è riuscito a raggiungere il server." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Kanban nie może połączyć się z serwerem." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "O Kanban não conseguiu acessar o servidor." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Kanban kan de server niet bereiken." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Kanban sunucuya ulaşamadı." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Канбану не удалось связаться с сервером." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "カンバンがサーバーに接続できませんでした。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "看板无法连接到服务器。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "칸반이 서버에 연결할 수 없습니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "تعذّر على كانبان الوصول إلى الخادم." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "קנבן לא הצליח להגיע לשרת." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "کانبان سرور تک نہیں پہنچ سکا۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "看板無法連線至伺服器。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "看板無法連線至伺服器。" } } } },
    "Kanban is available with limited capabilities." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Kanban ist mit eingeschränktem Funktionsumfang verfügbar." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Kanban está disponible con funciones limitadas." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Kanban est disponible avec des fonctionnalités limitées." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Kanban è disponibile con funzionalità limitate." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Kanban jest dostępny z ograniczonymi możliwościami." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "O Kanban está disponível com recursos limitados." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Kanban is beschikbaar met beperkte mogelijkheden." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Kanban sınırlı özelliklerle kullanılabilir." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Канбан доступен с ограниченными возможностями." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "カンバンは一部の機能のみ利用できます。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "看板可用，但功能有限。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "칸반은 제한된 기능으로 사용할 수 있습니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "كانبان متاح بإمكانات محدودة." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "קנבן זמין עם יכולות מוגבלות." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "کانبان محدود صلاحیتوں کے ساتھ دستیاب ہے۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "看板可以使用，但功能有限。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "看板可以使用，但功能有限。" } } } },
    "Keep Hermes Desktop running. In Settings → Advanced, enable Keep computer awake. The display may dim." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Lass Hermes Desktop laufen. Aktiviere unter „Settings → Advanced“ die Option „Keep computer awake“. Das Display wird eventuell gedimmt." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Mantén Hermes Desktop abierto. En Settings → Advanced, activa «Keep computer awake». La pantalla puede atenuarse." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Laissez Hermes Desktop ouvert. Dans Settings → Advanced, activez « Keep computer awake ». L’écran peut s’assombrir." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Tieni Hermes Desktop in esecuzione. In Settings → Advanced, attiva «Keep computer awake». Lo schermo potrebbe attenuarsi." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Pozostaw Hermes Desktop uruchomiony. W Settings → Advanced włącz „Keep computer awake”. Ekran może zostać przyciemniony." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Mantenha o Hermes Desktop em execução. Em Settings → Advanced, ative “Keep computer awake”. A tela pode escurecer." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Laat Hermes Desktop actief. Schakel in ‘Settings → Advanced’ de optie ‘Keep computer awake’ in. Het scherm kan dimmen." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop’u çalışır durumda tutun. Settings → Advanced’de “Keep computer awake” seçeneğini etkinleştirin. Ekran kararabilir." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Не закрывайте Hermes Desktop. В Settings → Advanced включите «Keep computer awake». Экран может затемняться." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktopを起動したままにしてください。設定 → 詳細で「コンピュータをスリープさせない」を有効にしてください。ディスプレイは暗くなる場合があります。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "保持 Hermes Desktop 运行。在“设置 → 高级”中，启用“保持电脑唤醒”。显示器可能会变暗。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop을 계속 실행해 두세요. 설정 → 고급에서 ‘컴퓨터 깨어 있게 유지’를 활성화하세요. 디스플레이는 어두워질 수 있습니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "أبقِ Hermes Desktop قيد التشغيل. في Settings → Advanced، فعّل «Keep computer awake». قد تخفت الشاشة." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "יש להשאיר את Hermes Desktop פועל. ב‑Settings → Advanced יש להפעיל את «Keep computer awake». ייתכן שהמסך יתעמעם." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop چلتا رکھیں۔ Settings → Advanced میں «Keep computer awake» فعال کریں۔ ڈسپلے مدھم ہو سکتا ہے۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "讓 Hermes Desktop 保持執行。在「設定 → 進階」中，啟用「讓電腦保持喚醒」。螢幕可能會變暗。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "讓 Hermes Desktop 保持執行。在「設定 → 進階」中，啟用「讓電腦保持喚醒」。螢幕可能會變暗。" } } } },
