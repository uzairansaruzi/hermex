    "Open Hermex on a new chat and start voice dictation." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermex mit einem neuen Chat öffnen und das Diktieren starten." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Abre Hermex en un chat nuevo e inicia el dictado por voz." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Ouvre Hermex sur une nouvelle discussion et lance la dictée vocale." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Apri Hermex su una nuova chat e avvia la dettatura vocale." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Otwórz Hermex w nowym czacie i rozpocznij dyktowanie." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Abrir o Hermex em um novo chat e iniciar o ditado por voz." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Open Hermex met een nieuwe chat en start dicteren." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermex’i yeni bir sohbette aç ve sesli dikteyi başlat." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Открыть Hermex в новом чате и начать диктовку." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermexで新規チャットを開き、音声入力を開始します。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "打开 Hermex 并新建聊天，然后开始语音听写。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermex에서 새 채팅을 열고 받아쓰기를 시작합니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "افتح Hermex على دردشة جديدة وابدأ الإملاء الصوتي." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "פתיחת Hermex בצ׳אט חדש והתחלת הכתבה קולית." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermex میں نئی چیٹ کھولیں اور صوتی ڈکٹیشن شروع کریں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "開啟 Hermex 並新增聊天，然後開始語音聽寫。" } }, "zh-HK" : { "stringUnit" : { 