          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "אם משאירים את המודל על ברירת המחדל של השרת, השרת משתמש במודל של הפרופיל שנבחר."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lasciando il modello sul valore predefinito del server, il server usa il modello del profilo selezionato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "モデルを「サーバのデフォルト」のままにすると、サーバは選択したプロファイルのモデルを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "모델을 서버 기본값으로 두면 서버가 선택한 프로필의 모델을 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Als je het model op de standaard van de server laat staan, gebruikt de server het model van het geselecteerde profiel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
