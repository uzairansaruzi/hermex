    "The Kanban server is unavailable." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Der Kanban-Server ist nicht verfügbar." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "El servidor de Kanban no está disponible." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Le serveur Kanban est indisponible." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Il server Kanban non è disponibile." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Serwer Kanban jest niedostępny." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "O servidor do Kanban está indisponível." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "De Kanban-server is niet beschikbaar." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Kanban sunucusu kullanılamıyor." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Сервер Канбана недоступен." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "カンバンサーバーを利用できません。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "看板服务器不可用。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "칸반 서버를 사용할 수 없습니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "خادم كانبان غير متاح." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "שרת הקנבן אינו זמין." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "کانبان سرور دستیاب نہیں ہے۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "看板伺服器無法使用。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "看板伺服器無法使用。" } } } },
    "The bot could not accept that answer. Check this bot in Desktop." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Der Bot konnte diese Antwort nicht annehmen. Prüfe diesen Bot in Desktop." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "El bot no pudo aceptar esa respuesta. Revisa este bot en Desktop." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Le bot n’a pas pu accepter cette réponse. Vérifiez ce bot dans Desktop." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Il bot non ha potuto accettare quella risposta. Controlla questo bot in Desktop." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Bot nie mógł przyjąć tej odpowiedzi. Sprawdź tego bota w Desktop." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "O bot não pôde aceitar essa resposta. Confira este bot no Desktop." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "De bot kon dat antwoord niet accepteren. Controleer deze bot in Desktop." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Bot bu yanıtı kabul edemedi. Bu botu Desktop’ta kontrol edin." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Бот не смог принять этот ответ. Проверьте этого бота в Desktop." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "ボットはその回答を受け付けられませんでした。Desktopでこのボットを確認してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "机器人无法接受该回答。请在 Desktop 中检查此机器人。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "봇이 해당 답변을 수락할 수 없습니다. Desktop에서 이 봇을 확인하세요." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "تعذّر على الروبوت قبول تلك الإجابة. راجع هذا الروبوت في Desktop." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "הבוט לא הצליח לקבל את התשובה הזו. יש לבדוק את הבוט הזה ב‑Desktop." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "بوٹ وہ جواب قبول نہیں کر سکا۔ Desktop میں اس بوٹ کو دیکھیں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "機器人無法接受該回答。請在 Desktop 中檢查此機器人。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "機械人無法接受該回答。請在 Desktop 中檢查此機械人。" } } } },
    "The conversation identity changed. Check this bot in Desktop." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Die Identität der Unterhaltung hat sich geändert. Prüfe diesen Bot in Desktop." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "La identidad de la conversación cambió. Revisa este bot en Desktop." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "L’identité de la conversation a changé. Vérifiez ce bot dans Desktop." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "L’identità della conversazione è cambiata. Controlla questo bot in Desktop." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Tożsamość rozmowy uległa zmianie. Sprawdź tego bota w Desktop." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "A identidade da conversa mudou. Confira este bot no Desktop." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "De identiteit van het gesprek is gewijzigd. Controleer deze bot in Desktop." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Konuşma kimliği değişti. Bu botu Desktop’ta kontrol edin." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Идентификатор разговора изменился. Проверьте этого бота в Desktop." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "会話のIDが変更されました。Desktopでこのボットを確認してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "对话身份已更改。请在 Desktop 中检查此机器人。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "대화 ID가 변경되었습니다. Desktop에서 이 봇을 확인하세요." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "تغيّرت هوية المحادثة. راجع هذا الروبوت في Desktop." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "זהות השיחה השתנתה. יש לבדוק את הבוט הזה ב‑Desktop." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "گفتگو کی شناخت بدل گئی۔ Desktop میں اس بوٹ کو دیکھیں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "對話身分已變更。請在 Desktop 中檢查此機器人。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "對話身份已更改。請在 Desktop 中檢查此機械人。" } } } },
    "The Hermes host at this address reports a different identity than the one you connected to. Check the address in the Hermes connection." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Der Hermes-Host unter dieser Adresse meldet eine andere Identität als der, mit dem du dich verbunden hast. Prüfe die Adresse in der Hermes-Verbindung." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "El host de Hermes en esta dirección indica una identidad distinta a la del host al que te conectaste. Revisa la dirección en la conexión de Hermes." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "L’hôte Hermes à cette adresse indique une identité différente de celui auquel vous vous êtes connecté. Vérifiez l’adresse dans la connexion Hermes." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "L’host Hermes a questo indirizzo segnala un’identità diversa da quello a cui ti sei connesso. Controlla l’indirizzo nella connessione Hermes." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Host Hermes pod tym adresem zgłasza inną tożsamość niż ten, z którym się połączono. Sprawdź adres w połączeniu Hermes." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "O host do Hermes neste endereço informa uma identidade diferente daquele ao qual você se conectou. Confira o endereço na conexão do Hermes." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "De Hermes-host op dit adres meldt een andere identiteit dan de host waarmee je verbinding maakte. Controleer het adres in de Hermes-verbinding." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Bu adresteki Hermes sunucusu, bağlandığınız sunucudan farklı bir kimlik bildiriyor. Hermes bağlantısındaki adresi kontrol edin." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Хост Hermes по этому адресу сообщает другой идентификатор, чем тот, к которому вы подключались. Проверьте адрес в подключении Hermes." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "このアドレスの Hermes ホストは、接続したホストとは異なる ID を報告しています。Hermes 接続のアドレスを確認してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "此地址上的 Hermes 主机报告的身份与你之前连接的主机不同。请在 Hermes 连接中检查地址。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "이 주소의 Hermes 호스트가 연결했던 호스트와 다른 ID를 보고합니다. Hermes 연결에서 주소를 확인하세요." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "يُبلغ مضيف Hermes على هذا العنوان عن هوية مختلفة عن المضيف الذي اتصلت به. تحقق من العنوان في اتصال Hermes." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "מארח Hermes בכתובת הזו מדווח על זהות שונה מזו של המארח שאליו התחברת. בדוק את הכתובת בחיבור Hermes." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "اس ایڈریس پر موجود Hermes ہوسٹ اس ہوسٹ سے مختلف شناخت بتا رہا ہے جس سے آپ نے کنیکٹ کیا تھا۔ Hermes کنکشن میں ایڈریس چیک کریں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "此位址上的 Hermes 主機回報的身分與你先前連線的主機不同。請在 Hermes 連線中檢查位址。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "此位址上的 Hermes 主機回報的身分與你先前連線的主機不同。請在 Hermes 連線中檢查位址。" } } } },
    "Connect to this host instead" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Stattdessen mit diesem Host verbinden" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Conectarse a este host en su lugar" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Se connecter plutôt à cet hôte" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Connettiti invece a questo host" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Połącz zamiast tego z tym hostem" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Conectar a este host em vez disso" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "In plaats daarvan met deze host verbinden" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Bunun yerine bu sunucuya bağlan" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Подключиться к этому хосту" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "代わりにこのホストに接続" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "改为连接到此主机" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "대신 이 호스트에 연결" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "الاتصال بهذا المضيف بدلًا من ذلك" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "התחבר למארח הזה במקום" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "اس کے بجائے اس ہوسٹ سے کنیکٹ کریں" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "改為連線到此主機" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "改為連線到此主機" } } } },
    "Connecting to this host instead clears this connection’s drafts, cached chats and notification pairing on this iPhone." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Wenn du dich stattdessen mit diesem Host verbindest, werden die Entwürfe, zwischengespeicherten Chats und die Mitteilungskopplung dieser Verbindung auf diesem iPhone gelöscht." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Si te conectas a este host en su lugar, se borrarán en este iPhone los borradores, los chats en caché y la vinculación de notificaciones de esta conexión." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Se connecter plutôt à cet hôte efface sur cet iPhone les brouillons, les discussions en cache et l’association des notifications de cette connexion." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Connettendoti invece a questo host, su questo iPhone verranno cancellati le bozze, le chat in cache e l’abbinamento delle notifiche di questa connessione." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Połączenie zamiast tego z tym hostem usunie na tym iPhonie wersje robocze, zapisane w pamięci podręcznej czaty i parowanie powiadomień tego połączenia." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Conectar a este host em vez disso apaga neste iPhone os rascunhos, as conversas em cache e o pareamento de notificações desta conexão." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Als je in plaats daarvan met deze host verbindt, worden de concepten, gecachte chats en meldingskoppeling van deze verbinding op deze iPhone gewist." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Bunun yerine bu sunucuya bağlanmak, bu bağlantının taslaklarını, önbelleğe alınmış sohbetlerini ve bildirim eşleştirmesini bu iPhone’dan siler." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Подключение к этому хосту удалит на этом iPhone черновики, кэшированные чаты и привязку уведомлений этого подключения." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "代わりにこのホストに接続すると、この iPhone 上のこの接続の下書き、キャッシュされたチャット、通知のペアリングが消去されます。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "改为连接到此主机会清除此 iPhone 上此连接的草稿、缓存的聊天和通知配对。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "대신 이 호스트에 연결하면 이 iPhone에서 이 연결의 초안, 캐시된 채팅, 알림 페어링이 지워집니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "يؤدي الاتصال بهذا المضيف بدلًا من ذلك إلى مسح مسودات هذا الاتصال ومحادثاته المخزنة مؤقتًا واقتران الإشعارات على هذا الـ iPhone." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "התחברות למארח הזה במקום תמחק ב‑iPhone הזה את הטיוטות, הצ׳אטים השמורים במטמון ואת צימוד ההתראות של החיבור הזה." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "اس کے بجائے اس ہوسٹ سے کنیکٹ کرنے سے اس iPhone پر اس کنکشن کے ڈرافٹس، کیش شدہ چیٹس اور اطلاعاتی پیئرنگ صاف ہو جائیں گی۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "改為連線到此主機會清除此 iPhone 上此連線的草稿、快取的聊天和通知配對。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "改為連線到此主機會清除此 iPhone 上此連線的草稿、快取的聊天和通知配對。" } } } },
    "The room and its history will be removed from every device. All bots in it will stop. The room cannot be restored." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Der Raum und sein Verlauf werden von allen Geräten entfernt. Alle Bots darin werden gestoppt. Der Raum kann nicht wiederhergestellt werden." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "La sala y su historial se eliminarán de todos los dispositivos. Todos los bots de la sala se detendrán. La sala no se podrá restaurar." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Le salon et son historique seront supprimés de tous les appareils. Tous ses bots s’arrêteront. Le salon ne pourra pas être restauré." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "La stanza e la sua cronologia verranno rimosse da tutti i dispositivi. Tutti i bot al suo interno si fermeranno. La stanza non potrà essere ripristinata." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Pokój i jego historia zostaną usunięte ze wszystkich urządzeń. Wszystkie boty w nim zostaną zatrzymane. Pokoju nie można przywrócić." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "A sala e seu histórico serão removidos de todos os dispositivos. Todos os bots nela vão parar. A sala não poderá ser restaurada." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "De ruimte en de geschiedenis ervan worden van elk apparaat verwijderd. Alle bots erin stoppen. De ruimte kan niet worden hersteld." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Oda ve geçmişi tüm cihazlardan kaldırılacak. İçindeki tüm botlar duracak. Oda geri yüklenemez." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Комната и её история будут удалены со всех устройств. Все боты в ней остановятся. Комнату нельзя будет восстановить." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "ルームとその履歴はすべてのデバイスから削除されます。ルーム内のすべてのボットが停止します。ルームを復元することはできません。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "此聊天室及其历史记录将从所有设备中移除。其中的所有机器人都将停止。聊天室无法恢复。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "방과 기록이 모든 기기에서 제거됩니다. 방에 있는 모든 봇이 중지됩니다. 방은 복원할 수 없습니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "ستُزال الغرفة وسجلها من كل الأجهزة. ستتوقف كل الروبوتات فيها. لا يمكن استعادة الغرفة." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "החדר וההיסטוריה שלו יוסרו מכל המכשירים. כל הבוטים בו ייעצרו. לא ניתן לשחזר את החדר." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "کمرہ اور اس کی ہسٹری ہر ڈیوائس سے ہٹا دی جائے گی۔ اس میں موجود تمام بوٹس رک جائیں گے۔ کمرہ بحال نہیں کیا جا سکتا۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "此聊天室及其歷史記錄將從所有裝置中移除。其中的所有機器人都將停止。聊天室無法復原。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "此聊天室及其歷史記錄將從所有裝置中移除。其中的所有機械人都將停止。聊天室無法復原。" } } } },
    "The room is still present. Disband was not confirmed." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Der Raum ist noch vorhanden. Das Auflösen wurde nicht bestätigt." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "La sala sigue existiendo. No se confirmó la disolución." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Le salon existe toujours. La dissolution n’a pas été confirmée." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "La stanza è ancora presente. Lo scioglimento non è stato confermato." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Pokój nadal istnieje. Rozwiązanie nie zostało potwierdzone." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "A sala ainda existe. A dissolução não foi confirmada." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "De ruimte bestaat nog. Opheffen is niet bevestigd." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Oda hâlâ mevcut. Dağıtma onaylanmadı." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Комната всё ещё существует. Роспуск не подтверждён." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "ルームはまだ存在します。解散は確認されませんでした。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "聊天室仍然存在。解散未得到确认。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "방이 아직 남아 있습니다. 해산이 확인되지 않았습니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "لا تزال الغرفة موجودة. لم يتم تأكيد الحل." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "החדר עדיין קיים. הפירוק לא אושר." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "کمرہ ابھی موجود ہے۔ ختم کرنے کی تصدیق نہیں ہوئی۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "聊天室仍然存在。解散未獲確認。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "聊天室仍然存在。解散未獲確認。" } } } },
    "There are no changes to commit." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Es gibt keine Änderungen zum Committen." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "No hay cambios que confirmar." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Il n’y a aucune modification à valider." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Non ci sono modifiche di cui eseguire il commit." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Brak zmian do zatwierdzenia." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Não há alterações para fazer commit." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Er zijn geen wijzigingen om te committen." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Commit edilecek değişiklik yok." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Нет изменений для коммита." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "コミットする変更はありません。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "没有可提交的更改。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "커밋할 변경 사항이 없습니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "لا توجد تغييرات للالتزام بها." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "אין שינויים להתחייבות." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "کمٹ کرنے کے لیے کوئی تبدیلی نہیں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "沒有可提交的更改。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "沒有可提交的更改。" } } } },
    "This Hermes connection does not support Bot chat here." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Diese Hermes-Verbindung unterstützt hier keinen Bot-Chat." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Esta conexión de Hermes no admite aquí el chat con bots." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Cette connexion Hermes ne prend pas en charge les discussions avec des bots ici." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Questa connessione Hermes non supporta qui la chat Bot." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "To połączenie Hermes nie obsługuje tutaj czatu z botami." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Esta conexão do Hermes não oferece suporte ao chat de Bot aqui." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Deze Hermes-verbinding ondersteunt hier geen botchat." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Bu Hermes bağlantısı burada Bot sohbetini desteklemiyor." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Это подключение Hermes не поддерживает здесь чат с ботами." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "このHermes接続では、ここでのボットチャットに対応していません。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "此 Hermes 连接不支持在此处进行机器人聊天。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "이 Hermes 연결은 여기에서 봇 채팅을 지원하지 않습니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "لا يدعم اتصال Hermes هذا دردشة الروبوتات هنا." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "חיבור Hermes זה אינו תומך כאן בצ׳אט בוטים." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "یہ Hermes کنکشن یہاں بوٹ چیٹ کو سپورٹ نہیں کرتا۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "此 Hermes 連線不支援在此進行機器人聊天。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "此 Hermes 連線不支援在此進行機械人聊天。" } } } },
    "This Hermes version cannot organize bots from the phone." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Diese Hermes-Version kann Bots nicht vom Telefon aus organisieren." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Esta versión de Hermes no permite organizar bots desde el teléfono." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Cette version de Hermes ne permet pas d’organiser les bots depuis le téléphone." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Questa versione di Hermes non può organizzare i bot dal telefono." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Ta wersja Hermes nie pozwala porządkować botów z telefonu." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Esta versão do Hermes não consegue organizar bots pelo telefone." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Deze Hermes-versie kan bots niet vanaf de telefoon ordenen." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Bu Hermes sürümü botların telefondan düzenlenmesini desteklemiyor." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Эта версия Hermes не позволяет упорядочивать ботов с телефона." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "このバージョンのHermesでは、電話からボットを整理できません。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "此 Hermes 版本不支持从手机整理机器人。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "이 Hermes 버전에서는 휴대폰에서 봇을 정리할 수 없습니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "لا يستطيع إصدار Hermes هذا تنظيم الروبوتات من الهاتف." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "גרסת Hermes זו אינה יכולה לארגן בוטים מהטלפון." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes کا یہ ورژن فون سے بوٹس کو ترتیب نہیں دے سکتا۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "此 Hermes 版本不支援從手機整理機器人。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "此 Hermes 版本不支援從手機整理機械人。" } } } },
    "This action is no longer current. Refresh the conversation." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Diese Aktion ist nicht mehr aktuell. Aktualisiere die Unterhaltung." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Esta acción ya no está vigente. Actualiza la conversación." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Cette action n’est plus à jour. Actualisez la conversation." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Questa azione non è più attuale. Aggiorna la conversazione." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Ta akcja jest już nieaktualna. Odśwież rozmowę." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Esta ação não é mais atual. Atualize a conversa." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Deze actie is niet meer actueel. Vernieuw het gesprek." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Bu işlem artık güncel değil. Konuşmayı yenileyin." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Это действие устарело. Обновите разговор." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "この操作は最新ではなくなりました。会話を更新してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "此操作已失效。请刷新对话。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "이 작업은 더 이상 최신 상태가 아닙니다. 대화를 새로 고치세요." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "لم يعد هذا الإجراء حاليًا. حدّث المحادثة." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "הפעולה הזו כבר אינה עדכנית. יש לרענן את השיחה." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "یہ کارروائی اب موجودہ نہیں رہی۔ گفتگو ریفریش کریں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "此操作已失效。請重新整理對話。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "此操作已失效。請重新整理對話。" } } } },
    "This attachment type is not supported. Choose an image, PDF, text, audio or document file." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Dieser Anhangstyp wird nicht unterstützt. Wähle eine Bild-, PDF-, Text-, Audio- oder Dokumentdatei." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Este tipo de adjunto no es compatible. Elige una imagen, un PDF, un texto, un audio o un documento." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Ce type de pièce jointe n’est pas pris en charge. Choisissez une image, un PDF, un texte, un audio ou un document." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Questo tipo di allegato non è supportato. Scegli un file immagine, PDF, testo, audio o documento." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Ten typ załącznika nie jest obsługiwany. Wybierz obraz, PDF, plik tekstowy, audio lub dokument." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Este tipo de anexo não é compatível. Escolha um arquivo de imagem, PDF, texto, áudio ou documento." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Dit bijlagetype wordt niet ondersteund. Kies een afbeelding, PDF, tekst-, audio- of documentbestand." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Bu ek türü desteklenmiyor. Görüntü, PDF, metin, ses veya belge dosyası seçin." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Этот тип вложения не поддерживается. Выберите изображение, PDF, текст, аудио или документ." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "この種類の添付ファイルには対応していません。画像、PDF、テキスト、オーディオ、または書類ファイルを選択してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "不支持此附件类型。请选择图片、PDF、文本、音频或文档文件。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "이 첨부 파일 유형은 지원되지 않습니다. 이미지, PDF, 텍스트, 오디오 또는 문서 파일을 선택하세요." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "نوع المرفق هذا غير مدعوم. اختر صورة أو ملف PDF أو نص أو صوت أو مستند." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "סוג הקובץ המצורף אינו נתמך. יש לבחור תמונה, PDF, טקסט, שמע או מסמך." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "اس قسم کا منسلکہ سپورٹ نہیں ہوتا۔ تصویر، PDF، متن، آڈیو یا دستاویز فائل منتخب کریں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "不支援此附件類型。請選擇圖片、PDF、文字、音訊或文件檔案。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "不支援此附件類型。請選擇圖片、PDF、文字、音訊或文件檔案。" } } } },
    "This bot changed in Hermes Desktop. The list was refreshed; try again." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Dieser Bot wurde in Hermes Desktop geändert. Die Liste wurde aktualisiert; versuche es erneut." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Este bot cambió en Hermes Desktop. Se actualizó la lista; inténtalo de nuevo." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Ce bot a été modifié dans Hermes Desktop. La liste a été actualisée ; réessayez." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Questo bot è cambiato in Hermes Desktop. L’elenco è stato aggiornato; riprova." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Ten bot został zmieniony w Hermes Desktop. Lista została odświeżona; spróbuj ponownie." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Este bot mudou no Hermes Desktop. A lista foi atualizada; tente novamente." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Deze bot is gewijzigd in Hermes Desktop. De lijst is vernieuwd; probeer het opnieuw." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Bu bot Hermes Desktop’ta değiştirildi. Liste yenilendi; tekrar deneyin." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Этот бот изменён в Hermes Desktop. Список обновлён; повторите попытку." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "このボットはHermes Desktopで変更されました。リストを更新したので、もう一度お試しください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "此机器人已在 Hermes Desktop 中更改。列表已刷新，请重试。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "이 봇이 Hermes Desktop에서 변경되었습니다. 목록을 새로 고쳤으니 다시 시도하세요." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "تغيّر هذا الروبوت في Hermes Desktop. تم تحديث القائمة؛ حاول مرة أخرى." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "הבוט הזה השתנה ב‑Hermes Desktop. הרשימה רועננה; יש לנסות שוב." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "یہ بوٹ Hermes Desktop میں تبدیل ہوا۔ فہرست ریفریش کر دی گئی؛ دوبارہ کوشش کریں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "此機器人已在 Hermes Desktop 中變更。清單已重新整理，請再試一次。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "此機械人已在 Hermes Desktop 中更改。列表已重新整理，請再試一次。" } } } },
