    "What this bot is for (optional)" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Wofür dieser Bot da ist (optional)" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Para qué sirve este bot (opcional)" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "À quoi sert ce bot (facultatif)" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "A cosa serve questo bot (facoltativo)" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Do czego służy ten bot (opcjonalnie)" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Para que serve este bot (opcional)" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Waar deze bot voor is (optioneel)" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Bu botun amacı (isteğe bağlı)" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Для чего этот бот (необязательно)" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "このボットの用途（任意）" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "此机器人的用途（可选）" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "이 봇의 용도 (선택 사항)" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "الغرض من هذا البوت (اختياري)" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "למה הבוט הזה מיועד (אופציונלי)" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "یہ بوٹ کس لیے ہے (اختیاری)" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "此機器人的用途（選填）" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "此機器人的用途（選填）" } } } },
    "Host default" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Host-Standard" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Predeterminado del host" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Par défaut de l’hôte" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Predefinito dell’host" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Domyślny hosta" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Padrão do host" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Standaard van host" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Ana makine varsayılanı" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "По умолчанию хоста" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "ホストのデフォルト" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "主机默认" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "호스트 기본값" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "الافتراضي للمضيف" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "ברירת המחדל של המארח" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "ہوسٹ ڈیفالٹ" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "主機預設" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "主機預設" } } } },
    "Use this Hermes’s API keys" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "API-Schlüssel dieses Hermes verwenden" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Usar las claves API de este Hermes" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Utiliser les clés API de ce Hermes" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Usa le chiavi API di questo Hermes" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Użyj kluczy API tego Hermesa" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Usar as chaves de API deste Hermes" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "API‑sleutels van deze Hermes gebruiken" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Bu Hermes’in API anahtarlarını kullan" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Использовать ключи API этого Hermes" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "この Hermes の API キーを使う" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "使用此 Hermes 的 API 密钥" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "이 Hermes의 API 키 사용" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "استخدام مفاتيح API لهذا Hermes" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "להשתמש במפתחות ה‑API של Hermes הזה" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "اس Hermes کی API کیز استعمال کریں" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "使用此 Hermes 的 API 金鑰" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "使用此 Hermes 的 API 金鑰" } } } },
    "How this bot should work (optional)" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Wie dieser Bot arbeiten soll (optional)" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Cómo debe trabajar este bot (opcional)" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Comment ce bot doit travailler (facultatif)" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Come deve lavorare questo bot (facoltativo)" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Jak ten bot ma działać (opcjonalnie)" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Como este bot deve trabalhar (opcional)" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Hoe deze bot moet werken (optioneel)" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Bu bot nasıl çalışmalı (isteğe bağlı)" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Как должен работать этот бот (необязательно)" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "このボットの動き方（任意）" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "此机器人的工作方式（可选）" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "이 봇이 일하는 방식 (선택 사항)" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "كيف يجب أن يعمل هذا البوت (اختياري)" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "איך הבוט הזה צריך לעבוד (אופציונלי)" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "یہ بوٹ کیسے کام کرے (اختیاری)" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "此機器人的工作方式（選填）" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "此機器人的工作方式（選填）" } } } },
    "Leave empty to use the host’s default instructions." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Leer lassen, um die Standardanweisungen des Hosts zu verwenden." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Déjalo vacío para usar las instrucciones predeterminadas del host." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Laissez vide pour utiliser les instructions par défaut de l’hôte." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Lascia vuoto per usare le istruzioni predefinite dell’host." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Zostaw puste, aby użyć domyślnych instrukcji hosta." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Deixe vazio para usar as instruções padrão do host." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Laat leeg om de standaardinstructies van de host te gebruiken." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Sunucunun varsayılan talimatlarını kullanmak için boş bırakın." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Оставьте пустым, чтобы использовать инструкции хоста по умолчанию." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "空欄のままにすると、ホストの既定の指示を使います。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "留空则使用主机的默认指令。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "비워 두면 호스트의 기본 지침을 사용합니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "اتركه فارغًا لاستخدام التعليمات الافتراضية للمضيف." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "השאירו ריק כדי להשתמש בהוראות ברירת המחדל של המארח." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "ہوسٹ کی ڈیفالٹ ہدایات استعمال کرنے کے لیے خالی چھوڑیں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "留空則使用主機的預設指示。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "留空則使用主機的預設指示。" } } } },
    "Start without bundled skills" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Ohne mitgelieferte Skills starten" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Empezar sin habilidades incluidas" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Démarrer sans les compétences fournies" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Inizia senza le competenze incluse" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Zacznij bez dołączonych umiejętności" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Começar sem as habilidades incluídas" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Beginnen zonder meegeleverde vaardigheden" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Paketle gelen beceriler olmadan başla" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Начать без встроенных навыков" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "同梱スキルなしで始める" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "不带内置技能开始" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "기본 제공 스킬 없이 시작" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "البدء بدون المهارات المضمّنة" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "להתחיל בלי המיומנויות המצורפות" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "شامل مہارتوں کے بغیر شروع کریں" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "不帶內建技能開始" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "不帶內建技能開始" } } } },
    "Only the host’s essential skills. Add more later from the bot’s settings." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Nur die grundlegenden Skills des Hosts. Weitere kannst du später in den Einstellungen des Bots hinzufügen." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Solo las habilidades esenciales del host. Añade más después desde los ajustes del bot." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Seulement les compétences essentielles de l’hôte. Ajoutez-en d’autres plus tard dans les réglages du bot." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Solo le competenze essenziali dell’host. Aggiungine altre in seguito dalle impostazioni del bot." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Tylko podstawowe umiejętności hosta. Więcej dodasz później w ustawieniach bota." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Só as habilidades essenciais do host. Adicione mais depois nos ajustes do bot." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Alleen de essentiële vaardigheden van de host. Voeg er later meer toe in de instellingen van de bot." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Yalnızca sunucunun temel becerileri. Daha fazlasını sonra botun ayarlarından ekleyin." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Только основные навыки хоста. Остальные можно добавить позже в настройках бота." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "ホストの必須スキルのみです。あとからボットの設定で追加できます。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "仅包含主机的必需技能。之后可在机器人的设置中添加更多。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "호스트의 필수 스킬만 포함합니다. 나중에 봇 설정에서 더 추가하세요." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "مهارات المضيف الأساسية فقط. أضف المزيد لاحقًا من إعدادات البوت." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "רק המיומנויות החיוניות של המארח. אפשר להוסיף עוד מאוחר יותר בהגדרות הבוט." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "صرف ہوسٹ کی بنیادی مہارتیں۔ مزید بعد میں بوٹ کی ترتیبات سے شامل کریں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "僅包含主機的必要技能。之後可在機器人的設定中新增更多。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "僅包含主機的必要技能。之後可在機器人的設定中新增更多。" } } } },
    "The bot starts with every skill that ships with Hermes." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Der Bot startet mit allen Skills, die Hermes mitbringt." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "El bot empieza con todas las habilidades que incluye Hermes." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Le bot démarre avec toutes les compétences fournies avec Hermes." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Il bot parte con tutte le competenze incluse in Hermes." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Bot zaczyna ze wszystkimi umiejętnościami dostarczanymi z Hermes." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "O bot começa com todas as habilidades que vêm com o Hermes." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "De bot begint met alle vaardigheden die bij Hermes horen." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Bot, Hermes ile gelen tüm becerilerle başlar." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Бот начинает со всеми навыками, которые поставляются с Hermes." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "ボットは Hermes に同梱されたすべてのスキルで始まります。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "机器人初始带有 Hermes 附带的全部技能。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "봇은 Hermes에 포함된 모든 스킬로 시작합니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "يبدأ البوت بكل المهارات المرفقة مع Hermes." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "הבוט מתחיל עם כל המיומנויות שמגיעות עם Hermes." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "بوٹ Hermes کے ساتھ آنے والی تمام مہارتوں کے ساتھ شروع ہوتا ہے۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "機器人初始帶有 Hermes 隨附的全部技能。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "機器人初始帶有 Hermes 隨附的全部技能。" } } } },
    "The bot signs in with the keys already saved on the host. Nothing is copied to this phone." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Der Bot meldet sich mit den bereits auf dem Host gespeicherten Schlüsseln an. Nichts wird auf dieses Telefon kopiert." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "El bot inicia sesión con las claves ya guardadas en el host. No se copia nada a este teléfono." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Le bot se connecte avec les clés déjà enregistrées sur l’hôte. Rien n’est copié sur ce téléphone." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Il bot accede con le chiavi già salvate sull’host. Nulla viene copiato su questo telefono." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Bot loguje się kluczami zapisanymi już na hoście. Nic nie jest kopiowane na ten telefon." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "O bot entra com as chaves já salvas no host. Nada é copiado para este telefone." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "De bot meldt zich aan met de sleutels die al op de host zijn opgeslagen. Er wordt niets naar deze telefoon gekopieerd." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Bot, ana makinede kayıtlı anahtarlarla oturum açar. Bu telefona hiçbir şey kopyalanmaz." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Бот входит с ключами, уже сохранёнными на хосте. На этот телефон ничего не копируется." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "ボットはホストに保存済みのキーでサインインします。この iPhone には何もコピーされません。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "机器人使用主机上已保存的密钥登录。不会向此手机复制任何内容。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "봇은 호스트에 이미 저장된 키로 로그인합니다. 이 휴대폰에는 아무것도 복사되지 않습니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "يسجّل البوت الدخول بالمفاتيح المحفوظة بالفعل على المضيف. لا يُنسخ شيء إلى هذا الهاتف." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "הבוט מתחבר עם המפתחות שכבר שמורים במארח. שום דבר לא מועתק לטלפון הזה." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "بوٹ ہوسٹ پر پہلے سے محفوظ کیز سے سائن ان کرتا ہے۔ اس فون پر کچھ کاپی نہیں ہوتا۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "機器人使用主機上已儲存的金鑰登入。不會複製任何內容到此手機。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "機器人使用主機上已儲存的金鑰登入。不會複製任何內容到此手機。" } } } },
    "The bot starts with no API keys. Add them in Hermes Desktop before it can answer." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Der Bot startet ohne API-Schlüssel. Füge sie in Hermes Desktop hinzu, bevor er antworten kann." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "El bot empieza sin claves API. Añádelas en Hermes Desktop antes de que pueda responder." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Le bot démarre sans clés API. Ajoutez-les dans Hermes Desktop avant qu’il puisse répondre." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Il bot parte senza chiavi API. Aggiungile in Hermes Desktop prima che possa rispondere." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Bot zaczyna bez kluczy API. Dodaj je w Hermes Desktop, zanim będzie mógł odpowiadać." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "O bot começa sem chaves de API. Adicione-as no Hermes Desktop antes que ele possa responder." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "De bot begint zonder API‑sleutels. Voeg ze toe in Hermes Desktop voordat hij kan antwoorden." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Bot API anahtarı olmadan başlar. Yanıt verebilmesi için Hermes Desktop’ta ekleyin." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Бот начинает без ключей API. Добавьте их в Hermes Desktop, чтобы он мог отвечать." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "ボットは API キーなしで始まります。返答できるようにするには Hermes Desktop で追加してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "机器人初始没有 API 密钥。请先在 Hermes Desktop 中添加，它才能回答。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "봇은 API 키 없이 시작합니다. 응답하려면 Hermes Desktop에서 추가하세요." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "يبدأ البوت بدون مفاتيح API. أضفها في Hermes Desktop قبل أن يتمكن من الرد." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "הבוט מתחיל ללא מפתחות API. הוסיפו אותם ב‑Hermes Desktop כדי שיוכל לענות." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "بوٹ بغیر API کیز کے شروع ہوتا ہے۔ جواب دینے سے پہلے انہیں Hermes Desktop میں شامل کریں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "機器人初始沒有 API 金鑰。請先在 Hermes Desktop 中新增，它才能回答。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "機器人初始沒有 API 金鑰。請先在 Hermes Desktop 中新增，它才能回答。" } } } },
    "Duplicate Bot" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Bot duplizieren" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Duplicar bot" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Dupliquer le bot" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Duplica bot" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Duplikuj bota" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Duplicar bot" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Bot dupliceren" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Botu Çoğalt" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Дублировать бота" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "ボットを複製" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "复制机器人" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "봇 복제" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "تكرار البوت" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "שכפול בוט" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "بوٹ ڈپلیکیٹ کریں" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "複製機器人" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "複製機器人" } } } },
    "New Bot" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Neuer Bot" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Bot nuevo" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Nouveau bot" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Nuovo bot" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Nowy bot" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Novo bot" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Nieuwe bot" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Yeni Bot" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Новый бот" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "新規ボット" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "新建机器人" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "새 봇" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "بوت جديد" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "בוט חדש" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "نیا بوٹ" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "新增機器人" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "新增機器人" } } } },
    "Hermes did not delete this bot. It is still on the host." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes hat diesen Bot nicht gelöscht. Er ist noch auf dem Host." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes no eliminó este bot. Sigue en el host." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes n’a pas supprimé ce bot. Il est toujours sur l’hôte." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes non ha eliminato questo bot. È ancora sull’host." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes nie usunął tego bota. Nadal jest na hoście." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "O Hermes não excluiu este bot. Ele ainda está no host." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes heeft deze bot niet verwijderd. Hij staat nog op de host." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes bu botu silmedi. Hâlâ ana makinede." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes не удалил этого бота. Он всё ещё на хосте." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes はこのボットを削除しませんでした。ホスト上にまだ残っています。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes 未删除此机器人。它仍在主机上。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes가 이 봇을 삭제하지 않았습니다. 여전히 호스트에 있습니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "لم يحذف Hermes هذا البوت. لا يزال على المضيف." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes לא מחק את הבוט הזה. הוא עדיין במארח." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes نے یہ بوٹ حذف نہیں کیا۔ یہ اب بھی ہوسٹ پر موجود ہے۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes 未刪除此機器人。它仍在主機上。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes 未刪除此機器人。它仍在主機上。" } } } },
    "Could not confirm whether the bot was deleted. Pull down to refresh." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Es konnte nicht bestätigt werden, ob der Bot gelöscht wurde. Zum Aktualisieren nach unten ziehen." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "No se pudo confirmar si el bot se eliminó. Desliza hacia abajo para actualizar." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Impossible de confirmer si le bot a été supprimé. Tirez vers le bas pour actualiser." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Impossibile confermare se il bot è stato eliminato. Trascina verso il basso per aggiornare." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Nie udało się potwierdzić, czy bot został usunięty. Pociągnij w dół, aby odświeżyć." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Não foi possível confirmar se o bot foi excluído. Puxe para baixo para atualizar." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Kon niet bevestigen of de bot is verwijderd. Trek omlaag om te vernieuwen." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Botun silinip silinmediği doğrulanamadı. Yenilemek için aşağı çekin." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Не удалось подтвердить, удалён ли бот. Потяните вниз, чтобы обновить." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "ボットが削除されたか確認できませんでした。下に引いて更新してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "无法确认机器人是否已删除。下拉以刷新。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "봇이 삭제되었는지 확인할 수 없습니다. 아래로 당겨 새로 고치세요." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "تعذّر التأكد مما إذا كان البوت قد حُذف. اسحب لأسفل للتحديث." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "לא ניתן לאשר אם הבוט נמחק. משכו למטה כדי לרענן." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "تصدیق نہیں ہو سکی کہ بوٹ حذف ہوا یا نہیں۔ ریفریش کرنے کے لیے نیچے کھینچیں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "無法確認機器人是否已刪除。下拉以重新整理。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "無法確認機器人是否已刪除。下拉以重新整理。" } } } },
    "No bots yet. Tap + to create one." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Noch keine Bots. Tippe auf +, um einen zu erstellen." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Aún no hay bots. Toca + para crear uno." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Pas encore de bot. Touchez + pour en créer un." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Nessun bot ancora. Tocca + per crearne uno." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Brak botów. Stuknij +, aby utworzyć." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Nenhum bot ainda. Toque em + para criar um." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Nog geen bots. Tik op + om er een te maken." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Henüz bot yok. Oluşturmak için + simgesine dokunun." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Ботов пока нет. Нажмите +, чтобы создать." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "ボットはまだありません。+ をタップして作成してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "还没有机器人。点按 + 创建一个。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "아직 봇이 없습니다. +를 탭하여 만드세요." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "لا توجد بوتات بعد. اضغط + لإنشاء واحد." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "אין עדיין בוטים. הקישו על + כדי ליצור אחד." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "ابھی کوئی بوٹ نہیں۔ ایک بنانے کے لیے + پر ٹیپ کریں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "還沒有機器人。點一下 + 來建立。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "還沒有機器人。點一下 + 來建立。" } } } },
    "New bot" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Neuer Bot" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Bot nuevo" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Nouveau bot" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Nuovo bot" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Nowy bot" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Novo bot" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Nieuwe bot" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Yeni bot" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Новый бот" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "新規ボット" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "新建机器人" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "새 봇" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "بوت جديد" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "בוט חדש" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "نیا بوٹ" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "新增機器人" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "新增機器人" } } } },
    "Delete “%@”?" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "„%@“ löschen?" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "¿Eliminar “%@”?" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Supprimer « %@ » ?" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Eliminare “%@”?" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Usunąć „%@”?" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Excluir “%@”?" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "‘%@’ verwijderen?" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "“%@” silinsin mi?" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Удалить «%@»?" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "「%@」を削除しますか？" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "要删除“%@”吗？" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "“%@”을(를) 삭제하시겠습니까?" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "هل تريد حذف ”%@“؟" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "למחוק את ״%@״?" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "”%@“ حذف کریں؟" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "要刪除「%@」嗎？" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "要刪除「%@」嗎？" } } } },
    "Delete Bot" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Bot löschen" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Eliminar bot" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Supprimer le bot" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Elimina bot" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Usuń bota" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Excluir bot" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Bot verwijderen" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Botu Sil" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Удалить бота" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "ボットを削除" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "删除机器人" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "봇 삭제" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "حذف البوت" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "מחיקת בוט" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "بوٹ حذف کریں" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "刪除機器人" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "刪除機器人" } } } },
    "Hide Instead" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Stattdessen ausblenden" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Ocultar en su lugar" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Masquer plutôt" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Nascondi invece" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Zamiast tego ukryj" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Ocultar em vez disso" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "In plaats daarvan verbergen" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Bunun Yerine Gizle" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Вместо этого скрыть" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "代わりに非表示にする" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "改为隐藏" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "대신 숨기기" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "إخفاء بدلًا من ذلك" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "להסתיר במקום" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "اس کے بجائے چھپائیں" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "改為隱藏" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "改為隱藏" } } } },
    "Deletes this bot’s Profile on %@: its instructions, settings, skills, saved keys and chat history. Drafts on this phone are removed too. This cannot be undone. Hiding keeps everything and only removes it from the list." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Löscht das Profil dieses Bots auf %@: Anweisungen, Einstellungen, Skills, gespeicherte Schlüssel und Chatverlauf. Entwürfe auf diesem Telefon werden ebenfalls entfernt. Das kann nicht rückgängig gemacht werden. Ausblenden behält alles und entfernt ihn nur aus der Liste." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Elimina el perfil de este bot en %@: sus instrucciones, configuración, skills, claves guardadas e historial de chat. Los borradores de este teléfono también se eliminan. Esto no se puede deshacer. Ocultar conserva todo y solo lo quita de la lista." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Supprime le profil de ce bot sur %@ : ses instructions, réglages, skills, clés enregistrées et historique de discussion. Les brouillons sur ce téléphone sont aussi supprimés. Cette action est irréversible. Masquer conserve tout et le retire seulement de la liste." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Elimina il profilo di questo bot su %@: istruzioni, impostazioni, skill, chiavi salvate e cronologia della chat. Anche le bozze su questo telefono vengono rimosse. Non è possibile annullare. Nascondere conserva tutto e lo toglie solo dall’elenco." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Usuwa profil tego bota na %@: instrukcje, ustawienia, umiejętności, zapisane klucze i historię czatu. Wersje robocze na tym telefonie też zostaną usunięte. Nie można tego cofnąć. Ukrycie zachowuje wszystko i tylko usuwa go z listy." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Exclui o perfil deste bot em %@: instruções, configurações, habilidades, chaves salvas e histórico de chat. Os rascunhos neste telefone também são removidos. Isso não pode ser desfeito. Ocultar mantém tudo e só o remove da lista." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Verwijdert het profiel van deze bot op %@: instructies, instellingen, skills, opgeslagen sleutels en chatgeschiedenis. Concepten op deze telefoon worden ook verwijderd. Dit kan niet ongedaan worden gemaakt. Verbergen bewaart alles en haalt hem alleen uit de lijst." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Bu botun %@ üzerindeki profilini siler: talimatları, ayarları, becerileri, kayıtlı anahtarları ve sohbet geçmişi. Bu telefondaki taslaklar da kaldırılır. Bu geri alınamaz. Gizlemek her şeyi korur ve yalnızca listeden kaldırır." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Удаляет профиль этого бота на %@: инструкции, настройки, навыки, сохранённые ключи и историю чата. Черновики на этом телефоне тоже удаляются. Это нельзя отменить. Скрытие сохраняет всё и лишь убирает его из списка." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "%@ 上のこのボットのプロファイル（指示、設定、スキル、保存済みキー、チャット履歴）を削除します。この iPhone の下書きも削除されます。元に戻せません。非表示にすればすべて残り、一覧から消えるだけです。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "删除此机器人在 %@ 上的配置：指令、设置、技能、已保存的密钥和聊天记录。此手机上的草稿也会被删除。此操作无法撤销。隐藏会保留全部内容，仅从列表中移除。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "%@의 이 봇 프로필(지침, 설정, 스킬, 저장된 키, 채팅 기록)을 삭제합니다. 이 휴대폰의 임시 저장도 삭제됩니다. 되돌릴 수 없습니다. 숨기기는 모든 것을 유지하고 목록에서만 제거합니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "يحذف ملف تعريف هذا البوت على %@: تعليماته وإعداداته ومهاراته ومفاتيحه المحفوظة وسجل الدردشة. تُزال المسودات على هذا الهاتف أيضًا. لا يمكن التراجع عن ذلك. الإخفاء يحتفظ بكل شيء ويزيله من القائمة فقط." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "מוחק את הפרופיל של הבוט הזה ב‑%@: ההוראות, ההגדרות, המיומנויות, המפתחות השמורים והיסטוריית הצ׳אט. גם הטיוטות בטלפון הזה יימחקו. לא ניתן לבטל פעולה זו. הסתרה שומרת הכול ורק מסירה אותו מהרשימה." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "%@ پر اس بوٹ کا پروفائل حذف کرتا ہے: اس کی ہدایات، ترتیبات، مہارتیں، محفوظ کیز اور چیٹ ہسٹری۔ اس فون پر موجود ڈرافٹس بھی ہٹا دیے جاتے ہیں۔ اسے واپس نہیں کیا جا سکتا۔ چھپانے سے سب کچھ برقرار رہتا ہے اور صرف فہرست سے ہٹتا ہے۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "刪除此機器人在 %@ 上的設定檔：指令、設定、技能、已儲存的金鑰和聊天記錄。此手機上的草稿也會被移除。此操作無法復原。隱藏會保留全部內容，僅從列表中移除。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "刪除此機器人在 %@ 上的設定檔：指令、設定、技能、已儲存的金鑰和聊天記錄。此手機上的草稿也會被移除。此操作無法復原。隱藏會保留全部內容，僅從列表中移除。" } } } },
    "Auto" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Automatisch" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Automático" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Automatique" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Automatico" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Automatycznie" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Automático" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Automatisch" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Otomatik" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Авто" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "自動" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "自动" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "자동" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "تلقائي" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "אוטומטי" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "خودکار" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "自動" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "自動" } } } },
    "Created, with a note" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Erstellt, mit Hinweis" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Creado, con una nota" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Créé, avec une remarque" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Creato, con una nota" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Utworzono, z uwagą" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Criado, com uma observação" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Aangemaakt, met een opmerking" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Oluşturuldu, bir notla" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Создан, с примечанием" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "作成しました（注意あり）" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "已创建，附说明" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "생성됨, 참고 사항 있음" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "تم الإنشاء، مع ملاحظة" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "נוצר, עם הערה" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "بنایا گیا، ایک نوٹ کے ساتھ" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "已建立，附說明" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "已建立，附說明" } } } },
    "New activity" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Neue Aktivität" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Nueva actividad" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Nouvelle activité" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Nuova attività" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Nowa aktywność" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Nova atividade" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Nieuwe activiteit" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Yeni etkinlik" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Новая активность" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "新しいアクティビティ" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "新活动" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "새로운 활동" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "نشاط جديد" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "פעילות חדשה" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "نئی سرگرمی" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "新活動" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "新活動" } } } }
