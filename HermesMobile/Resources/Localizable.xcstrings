    "Hermes recorded this completion without a result body." : {"localizations":{"de":{"stringUnit":{"state":"needs_review","value":"Hermes hat diesen Abschluss ohne Ergebnisinhalt aufgezeichnet."}},"es":{"stringUnit":{"state":"needs_review","value":"Hermes registró esta finalización sin un resultado."}},"fr":{"stringUnit":{"state":"needs_review","value":"Hermes a enregistré cette fin sans résultat."}},"it":{"stringUnit":{"state":"needs_review","value":"Hermes ha registrato questo completamento senza un risultato."}},"pl":{"stringUnit":{"state":"needs_review","value":"Hermes zapisał to ukończenie bez treści wyniku."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"O Hermes registrou esta conclusão sem um resultado."}},"nl":{"stringUnit":{"state":"needs_review","value":"Hermes heeft deze voltooiing zonder resultaat vastgelegd."}},"tr":{"stringUnit":{"state":"needs_review","value":"Hermes bu tamamlanmayı sonuç içeriği olmadan kaydetti."}},"ru":{"stringUnit":{"state":"needs_review","value":"Hermes записал это завершение без результата."}},"ja":{"stringUnit":{"state":"needs_review","value":"Hermes は結果本文なしでこの完了を記録しました。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"Hermes 记录了此完成事件，但没有结果内容。"}},"ko":{"stringUnit":{"state":"needs_review","value":"Hermes가 결과 내용 없이 이 완료를 기록했습니다."}},"ar":{"stringUnit":{"state":"needs_review","value":"سجّل Hermes هذا الاكتمال من دون محتوى للنتيجة."}},"he":{"stringUnit":{"state":"needs_review","value":"Hermes תיעד השלמה זו ללא תוכן תוצאה."}},"ur":{"stringUnit":{"state":"needs_review","value":"Hermes نے اس تکمیل کو نتیجے کے متن کے بغیر ریکارڈ کیا۔"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"Hermes 已記錄此完成事件，但沒有結果內容。"}},"zh-HK":{"stringUnit":{"state":"needs_review","value":"Hermes 已記錄此完成事件，但沒有結果內容。"}}}},
    "Shows worker status, recent output, and interrupt controls." : {"localizations":{"de":{"stringUnit":{"state":"needs_review","value":"Zeigt Worker-Status, letzte Ausgabe und Steuerelemente zum Unterbrechen."}},"es":{"stringUnit":{"state":"needs_review","value":"Muestra el estado de los workers, la salida reciente y los controles de interrupción."}},"fr":{"stringUnit":{"state":"needs_review","value":"Affiche l’état des workers, leur sortie récente et les commandes d’interruption."}},"it":{"stringUnit":{"state":"needs_review","value":"Mostra lo stato dei worker, l’output recente e i controlli di interruzione."}},"pl":{"stringUnit":{"state":"needs_review","value":"Pokazuje stan procesów roboczych, ostatnie dane wyjściowe i elementy sterujące przerwaniem."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Mostra o status dos workers, a saída recente e os controles de interrupção."}},"nl":{"stringUnit":{"state":"needs_review","value":"Toont workerstatus, recente uitvoer en bediening om te onderbreken."}},"tr":{"stringUnit":{"state":"needs_review","value":"Worker durumunu, son çıktıyı ve kesme denetimlerini gösterir."}},"ru":{"stringUnit":{"state":"needs_review","value":"Показывает состояние воркеров, недавний вывод и элементы управления прерыванием."}},"ja":{"stringUnit":{"state":"needs_review","value":"ワーカーの状態、最新の出力、中断コントロールを表示します。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"显示工作进程状态、近期输出和中断控制。"}},"ko":{"stringUnit":{"state":"needs_review","value":"워커 상태, 최근 출력 및 중단 제어를 표시합니다."}},"ar":{"stringUnit":{"state":"needs_review","value":"يعرض حالة العمليات العاملة والمخرجات الحديثة وعناصر تحكم المقاطعة."}},"he":{"stringUnit":{"state":"needs_review","value":"מציג את מצב תהליכי העבודה, הפלט האחרון ובקרי ההפסקה."}},"ur":{"stringUnit":{"state":"needs_review","value":"ورکر کی حالت، حالیہ آؤٹ پٹ اور روکنے کے کنٹرول دکھاتا ہے۔"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"顯示工作程序狀態、近期輸出和中斷控制。"}},"zh-HK":{"stringUnit":{"state":"needs_review","value":"顯示工作程序狀態、近期輸出和中斷控制。"}}}},
    "Delegated work, %lld active workers" : {"localizations":{"de":{"stringUnit":{"state":"needs_review","value":"Delegierte Arbeit, %lld aktive Worker"}},"es":{"stringUnit":{"state":"needs_review","value":"Trabajo delegado, %lld workers activos"}},"fr":{"stringUnit":{"state":"needs_review","value":"Travail délégué, %lld workers actifs"}},"it":{"stringUnit":{"state":"needs_review","value":"Lavoro delegato, %lld worker attivi"}},"pl":{"stringUnit":{"state":"needs_review","value":"Delegowana praca, aktywne procesy: %lld"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Trabalho delegado, %lld workers ativos"}},"nl":{"stringUnit":{"state":"needs_review","value":"Gedelegeerd werk, %lld actieve workers"}},"tr":{"stringUnit":{"state":"needs_review","value":"Devredilen iş, %lld etkin worker"}},"ru":{"stringUnit":{"state":"needs_review","value":"Делегированная работа, активных воркеров: %lld"}},"ja":{"stringUnit":{"state":"needs_review","value":"委任された作業、アクティブなワーカー %lld 件"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"委派工作，%lld 个活跃工作进程"}},"ko":{"stringUnit":{"state":"needs_review","value":"위임된 작업, 활성 워커 %lld개"}},"ar":{"stringUnit":{"state":"needs_review","value":"العمل المفوّض، %lld عملية عاملة نشطة"}},"he":{"stringUnit":{"state":"needs_review","value":"עבודה מואצלת, %lld תהליכי עבודה פעילים"}},"ur":{"stringUnit":{"state":"needs_review","value":"تفویض شدہ کام، %lld فعال ورکرز"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"委派工作，%lld 個活躍工作程序"}},"zh-HK":{"stringUnit":{"state":"needs_review","value":"委派工作，%lld 個活躍工作程序"}}}},
    "Buy Uzi a coffee" : {"localizations":{"de":{"stringUnit":{"state":"needs_review","value":"Spendier Uzi einen Kaffee"}},"es":{"stringUnit":{"state":"needs_review","value":"Invita a Uzi a un café"}},"fr":{"stringUnit":{"state":"needs_review","value":"Offrir un café à Uzi"}},"it":{"stringUnit":{"state":"needs_review","value":"Offri un caffè a Uzi"}},"pl":{"stringUnit":{"state":"needs_review","value":"Postaw Uzi kawę"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Pague um café para Uzi"}},"nl":{"stringUnit":{"state":"needs_review","value":"Trakteer Uzi op koffie"}},"tr":{"stringUnit":{"state":"needs_review","value":"Uzi’ye bir kahve ısmarla"}},"ru":{"stringUnit":{"state":"needs_review","value":"Угостить Uzi кофе"}},"ja":{"stringUnit":{"state":"needs_review","value":"Uziにコーヒーをごちそうする"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"请 Uzi 喝杯咖啡"}},"ko":{"stringUnit":{"state":"needs_review","value":"Uzi에게 커피 한 잔 사주기"}},"ar":{"stringUnit":{"state":"needs_review","value":"قدّم قهوة إلى Uzi"}},"he":{"stringUnit":{"state":"needs_review","value":"לקנות קפה ל-Uzi"}},"ur":{"stringUnit":{"state":"needs_review","value":"Uzi کو کافی پلائیں"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"請 Uzi 喝杯咖啡"}},"zh-HK":{"stringUnit":{"state":"needs_review","value":"請 Uzi 飲杯咖啡"}}}},
    "Enjoying Hermex?" : {"localizations":{"de":{"stringUnit":{"state":"needs_review","value":"Gefällt dir Hermex?"}},"es":{"stringUnit":{"state":"needs_review","value":"¿Te gusta Hermex?"}},"fr":{"stringUnit":{"state":"needs_review","value":"Vous aimez Hermex ?"}},"it":{"stringUnit":{"state":"needs_review","value":"Ti piace Hermex?"}},"pl":{"stringUnit":{"state":"needs_review","value":"Podoba Ci się Hermex?"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Gostando do Hermex?"}},"nl":{"stringUnit":{"state":"needs_review","value":"Bevalt Hermex?"}},"tr":{"stringUnit":{"state":"needs_review","value":"Hermex’i beğendiniz mi?"}},"ru":{"stringUnit":{"state":"needs_review","value":"Нравится Hermex?"}},"ja":{"stringUnit":{"state":"needs_review","value":"Hermexを気に入っていますか？"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"喜欢 Hermex 吗？"}},"ko":{"stringUnit":{"state":"needs_review","value":"Hermex가 마음에 드시나요?"}},"ar":{"stringUnit":{"state":"needs_review","value":"هل يعجبك Hermex؟"}},"he":{"stringUnit":{"state":"needs_review","value":"נהנים מ-Hermex?"}},"ur":{"stringUnit":{"state":"needs_review","value":"کیا آپ کو Hermex پسند ہے؟"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"喜歡 Hermex 嗎？"}},"zh-HK":{"stringUnit":{"state":"needs_review","value":"喜歡 Hermex 嗎？"}}}},
    "It's free and open source. If it's earned a coffee, that would mean a lot." : {"localizations":{"de":{"stringUnit":{"state":"needs_review","value":"Die App ist kostenlos und Open Source. Wenn sie dir einen Kaffee wert ist, würde mir das viel bedeuten."}},"es":{"stringUnit":{"state":"needs_review","value":"Es gratis y de código abierto. Si se ha ganado un café, significaría mucho para mí."}},"fr":{"stringUnit":{"state":"needs_review","value":"L’application est gratuite et open source. Si elle mérite un café, cela me ferait très plaisir."}},"it":{"stringUnit":{"state":"needs_review","value":"È gratis e open source. Se si è guadagnata un caffè, significherebbe molto per me."}},"pl":{"stringUnit":{"state":"needs_review","value":"Aplikacja jest darmowa i ma otwarty kod. Jeśli zasłużyła na kawę, wiele by to dla mnie znaczyło."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"É grátis e de código aberto. Se mereceu um café, isso significaria muito para mim."}},"nl":{"stringUnit":{"state":"needs_review","value":"De app is gratis en open source. Als hij een kop koffie heeft verdiend, zou dat veel voor me betekenen."}},"tr":{"stringUnit":{"state":"needs_review","value":"Ücretsiz ve açık kaynaklı. Bir kahveyi hak ettiyse, bu benim için çok anlamlı olur."}},"ru":{"stringUnit":{"state":"needs_review","value":"Приложение бесплатное, с открытым исходным кодом. Если оно заслужило чашку кофе, для меня это много значит."}},"ja":{"stringUnit":{"state":"needs_review","value":"無料のオープンソースアプリです。コーヒー一杯分のお役に立てたなら、ご支援いただけると励みになります。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"这是一款免费开源应用。如果它值得一杯咖啡，你的支持对我意义重大。"}},"ko":{"stringUnit":{"state":"needs_review","value":"무료 오픈 소스 앱입니다. 커피 한 잔의 가치가 있었다면, 응원해 주시면 큰 힘이 됩니다."}},"ar":{"stringUnit":{"state":"needs_review","value":"التطبيق مجاني ومفتوح المصدر. إن كان يستحق فنجان قهوة، فذلك سيعني لي الكثير."}},"he":{"stringUnit":{"state":"needs_review","value":"האפליקציה חינמית ובקוד פתוח. אם היא הרוויחה כוס קפה, זה יהיה משמעותי מאוד עבורי."}},"ur":{"stringUnit":{"state":"needs_review","value":"یہ مفت اور اوپن سورس ہے۔ اگر یہ ایک کافی کا حقدار بنا ہے تو یہ میرے لیے بہت معنی رکھے گا۔"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"這是一款免費開源 App。如果它值得一杯咖啡，你的支持對我意義重大。"}},"zh-HK":{"stringUnit":{"state":"needs_review","value":"這是一款免費開源 App。如果它值得一杯咖啡，你的支持對我意義重大。"}}}},
    "Buy Uzi a coffee, opens in browser" : {"localizations":{"de":{"stringUnit":{"state":"needs_review","value":"Spendier Uzi einen Kaffee, öffnet den Browser"}},"es":{"stringUnit":{"state":"needs_review","value":"Invita a Uzi a un café, se abre en el navegador"}},"fr":{"stringUnit":{"state":"needs_review","value":"Offrir un café à Uzi, ouvre le navigateur"}},"it":{"stringUnit":{"state":"needs_review","value":"Offri un caffè a Uzi, apre il browser"}},"pl":{"stringUnit":{"state":"needs_review","value":"Postaw Uzi kawę, otwiera przeglądarkę"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Pague um café para Uzi, abre no navegador"}},"nl":{"stringUnit":{"state":"needs_review","value":"Trakteer Uzi op koffie, opent de browser"}},"tr":{"stringUnit":{"state":"needs_review","value":"Uzi’ye bir kahve ısmarla, tarayıcıda açılır"}},"ru":{"stringUnit":{"state":"needs_review","value":"Угостить Uzi кофе, открывается в браузере"}},"ja":{"stringUnit":{"state":"needs_review","value":"Uziにコーヒーをごちそうする、ブラウザで開きます"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"请 Uzi 喝杯咖啡，在浏览器中打开"}},"ko":{"stringUnit":{"state":"needs_review","value":"Uzi에게 커피 한 잔 사주기, 브라우저에서 열기"}},"ar":{"stringUnit":{"state":"needs_review","value":"قدّم قهوة إلى Uzi، يفتح في المتصفح"}},"he":{"stringUnit":{"state":"needs_review","value":"לקנות קפה ל-Uzi, נפתח בדפדפן"}},"ur":{"stringUnit":{"state":"needs_review","value":"Uzi کو کافی پلائیں، براؤزر میں کھلتا ہے"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"請 Uzi 喝杯咖啡，在瀏覽器中開啟"}},"zh-HK":{"stringUnit":{"state":"needs_review","value":"請 Uzi 飲杯咖啡，在瀏覽器中開啟"}}}},
    "Not now" : {"localizations":{"de":{"stringUnit":{"state":"needs_review","value":"Jetzt nicht"}},"es":{"stringUnit":{"state":"needs_review","value":"Ahora no"}},"fr":{"stringUnit":{"state":"needs_review","value":"Pas maintenant"}},"it":{"stringUnit":{"state":"needs_review","value":"Non ora"}},"pl":{"stringUnit":{"state":"needs_review","value":"Nie teraz"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Agora não"}},"nl":{"stringUnit":{"state":"needs_review","value":"Nu niet"}},"tr":{"stringUnit":{"state":"needs_review","value":"Şimdi değil"}},"ru":{"stringUnit":{"state":"needs_review","value":"Не сейчас"}},"ja":{"stringUnit":{"state":"needs_review","value":"今はしない"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"暂时不用"}},"ko":{"stringUnit":{"state":"needs_review","value":"나중에"}},"ar":{"stringUnit":{"state":"needs_review","value":"ليس الآن"}},"he":{"stringUnit":{"state":"needs_review","value":"לא עכשיו"}},"ur":{"stringUnit":{"state":"needs_review","value":"ابھی نہیں"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"暫時不要"}},"zh-HK":{"stringUnit":{"state":"needs_review","value":"暫時不用"}}}},
