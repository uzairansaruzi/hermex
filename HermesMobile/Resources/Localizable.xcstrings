    "Open Hermex on a new chat pinned to a specific profile." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermex mit einem neuen Chat öffnen, der einem bestimmten Profil zugeordnet ist." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Abre Hermex en un chat nuevo vinculado a un perfil concreto." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Ouvre Hermex sur une nouvelle discussion associée à un profil précis." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Apri Hermex su una nuova chat associata a un profilo specifico." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Otwórz Hermex w nowym czacie przypisanym do wybranego profilu." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Abrir o Hermex em um novo chat fixado em um perfil específico." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Open Hermex met een nieuwe chat die aan een specifiek profiel is gekoppeld." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermex’i belirli bir profile sabitlenmiş yeni bir sohbette aç." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Открыть Hermex в новом чате, привязанном к определённому профилю." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "特定のプロファイルに固定した新規チャットでHermexを開きます。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "打开 Hermex 并在指定配置文件中新建聊天。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "특정 프로필에 고정된 새 채팅으로 Hermex를 엽니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "افتح Hermex على دردشة جديدة مثبتة على ملف تعريف محدد." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "פתיחת Hermex בצ׳אט חדש המוצמד לפרופיל מסוים." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermex میں کسی مخصوص پروفائل پر مقرر نئی چیٹ کھولیں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "開啟 Hermex 並在指定設定檔中新增聊天。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "開啟 Hermex 並在指定設定檔中新增聊天。" } } } },
    "Open Next" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Nächstes öffnen" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Abrir siguiente" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Ouvrir le suivant" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Apri successivo" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Otwórz następny" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Abrir próximo" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Volgende openen" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Sonrakini Aç" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Открыть следующий" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "次を開く" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "打开下一个" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "다음 열기" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "فتح التالي" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "פתיחת הבא" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "اگلا کھولیں" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "開啟下一個" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "開啟下一個" } } } },
    "Open Settings" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Einstellungen öffnen" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Abrir Ajustes" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Ouvrir Réglages" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Apri Impostazioni" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Otwórz Ustawienia" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Abrir Ajustes" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Instellingen openen" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Ayarlar’ı Aç" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Открыть Настройки" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "設定を開く" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "打开设置" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "설정 열기" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "فتح الإعدادات" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "פתיחת הגדרות" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "ترتیبات کھولیں" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "開啟設定" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "開啟設定" } } } },
    "Open each bot’s Bot Chat in Desktop first. Do not start a second backend using the same Profile storage." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Öffne zuerst den Bot-Chat jedes Bots in Desktop. Starte kein zweites Backend, das denselben Profilspeicher verwendet." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Abre primero el Bot Chat de cada bot en Desktop. No inicies un segundo backend que use el mismo almacenamiento de perfiles." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Ouvrez d’abord le Bot Chat de chaque bot dans Desktop. Ne démarrez pas un second backend utilisant le même stockage de profil." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Apri prima la Bot Chat di ogni bot in Desktop. Non avviare un secondo backend che usa lo stesso archivio del profilo." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Najpierw otwórz „Bot Chat” każdego bota w Desktop. Nie uruchamiaj drugiego backendu korzystającego z tej samej pamięci profilu." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Abra primeiro o Bot Chat de cada bot no Desktop. Não inicie um segundo backend usando o mesmo armazenamento de perfil." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Open eerst de botchat van elke bot in Desktop. Start geen tweede backend die dezelfde profielopslag gebruikt." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Önce her botun “Bot Chat” ekranını Desktop’ta açın. Aynı Profil depolamasını kullanan ikinci bir arka uç başlatmayın." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Сначала откройте «Bot Chat» каждого бота в Desktop. Не запускайте второй бэкенд с тем же хранилищем профиля." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "まずDesktopで各ボットのボットチャットを開いてください。同じプロファイルのストレージを使う2つ目のバックエンドは起動しないでください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "请先在 Desktop 中打开每个机器人的“机器人聊天”。不要使用相同的配置文件存储启动第二个后端。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "먼저 Desktop에서 각 봇의 봇 채팅을 여세요. 같은 프로필 저장소를 사용하는 두 번째 백엔드를 시작하지 마세요." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "افتح Bot Chat لكل روبوت في Desktop أولًا. لا تبدأ خلفية ثانية تستخدم تخزين ملف التعريف نفسه." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "יש לפתוח קודם את Bot Chat של כל בוט ב‑Desktop. אין להפעיל שרת שני שמשתמש באותו אחסון פרופיל." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "پہلے Desktop میں ہر بوٹ کی Bot Chat کھولیں۔ اسی پروفائل اسٹوریج کو استعمال کرنے والا دوسرا بیک اینڈ شروع نہ کریں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "請先在 Desktop 中開啟每個機器人的「機器人聊天」。請勿使用相同的設定檔儲存空間啟動第二個後端。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "請先在 Desktop 中開啟每個機械人的「機械人聊天」。請勿使用相同的設定檔儲存空間啟動第二個後端。" } } } },
    "Open it when you are done with this draft." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Öffne es, wenn du mit diesem Entwurf fertig bist." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Ábrelo cuando termines este borrador." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Ouvrez-le quand vous aurez terminé ce brouillon." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Aprilo quando hai finito con questa bozza." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Otwórz go po zakończeniu tego szkicu." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Abra-o quando terminar este rascunho." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Open het wanneer je klaar bent met dit concept." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Bu taslakla işiniz bitince açın." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Откройте его, когда закончите с этим черновиком." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "この下書きが終わったら開いてください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "完成此草稿后再打开它。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "이 초안 작업을 마친 후 여세요." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "افتحه عند الانتهاء من هذه المسودة." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "אפשר לפתוח אותו לאחר סיום הטיוטה הזו." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "اس ڈرافٹ سے فارغ ہو کر اسے کھولیں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "完成此草稿後再開啟它。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "完成此草稿後再開啟它。" } } } },
    "Open media video %@" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Video %@ öffnen" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Abrir vídeo %@" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Ouvrir la vidéo %@" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Apri video %@" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Otwórz wideo %@" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Abrir vídeo %@" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Video %@ openen" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Videoyu aç: %@" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Открыть видео %@" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "ビデオ %@ を開く" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "打开媒体视频 %@" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "동영상 %@ 열기" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "فتح فيديو الوسائط %@" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "פתיחת סרטון המדיה %@" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "میڈیا ویڈیو %@ کھولیں" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "開啟媒體影片 %@" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "開啟媒體影片 %@" } } } },
    "Open this bot’s chat in Hermes Desktop, then refresh." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Öffne den Chat dieses Bots in Hermes Desktop und aktualisiere dann." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Abre el chat de este bot en Hermes Desktop y luego actualiza." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Ouvrez la discussion de ce bot dans Hermes Desktop, puis actualisez." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Apri la chat di questo bot in Hermes Desktop, poi aggiorna." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Otwórz czat tego bota w Hermes Desktop, a następnie odśwież." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Abra o chat deste bot no Hermes Desktop e atualize." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Open de chat van deze bot in Hermes Desktop en vernieuw daarna." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Bu botun sohbetini Hermes Desktop’ta açın, ardından yenileyin." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Откройте чат этого бота в Hermes Desktop, затем обновите." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktopでこのボットのチャットを開いてから、更新してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "请在 Hermes Desktop 中打开此机器人的聊天，然后刷新。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes Desktop에서 이 봇의 채팅을 연 후 새로 고치세요." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "افتح دردشة هذا الروبوت في Hermes Desktop، ثم حدّث." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "יש לפתוח את הצ׳אט של הבוט הזה ב‑Hermes Desktop ואז לרענן." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "اس بوٹ کی چیٹ Hermes Desktop میں کھولیں، پھر ریفریش کریں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "請在 Hermes Desktop 中開啟此機器人的聊天，然後重新整理。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "請在 Hermes Desktop 中開啟此機械人的聊天，然後重新整理。" } } } },
    "Outcome unknown. Try Again checks the same group creation; it will not create a second room." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Ergebnis unbekannt. „Erneut versuchen“ prüft dieselbe Gruppenerstellung; es wird kein zweiter Raum erstellt." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Resultado desconocido. «Intentar de nuevo» comprueba la misma creación de grupo; no creará una segunda sala." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Résultat inconnu. « Réessayer » vérifie la même création de groupe ; aucun second salon ne sera créé." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Esito sconosciuto. «Riprova» verifica la stessa creazione del gruppo; non verrà creata una seconda stanza." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Wynik nieznany. „Spróbuj ponownie” sprawdzi to samo tworzenie grupy; nie utworzy drugiego pokoju." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Resultado desconhecido. “Tentar novamente” verifica a mesma criação de grupo; não será criada uma segunda sala." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Resultaat onbekend. ‘Opnieuw proberen’ controleert dezelfde groepsaanmaak; er wordt geen tweede ruimte aangemaakt." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Sonuç bilinmiyor. Yeniden Dene aynı grup oluşturma işlemini kontrol eder; ikinci bir oda oluşturmaz." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Результат неизвестен. «Повторить» проверит то же создание группы; вторая комната не будет создана." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "結果は不明です。「再試行」は同じグループ作成を確認するだけで、2つ目のルームは作成されません。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "结果未知。“重试”会检查同一次群组创建，不会创建第二个聊天室。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "결과를 알 수 없습니다. ‘다시 시도’는 동일한 그룹 생성을 확인하며 두 번째 방을 만들지 않습니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "النتيجة غير معروفة. يتحقق «حاول مرة أخرى» من عملية إنشاء المجموعة نفسها؛ ولن ينشئ غرفة ثانية." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "התוצאה אינה ידועה. ״נסה שוב״ בודק את אותה יצירת קבוצה; הוא לא ייצור חדר שני." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "نتیجہ معلوم نہیں۔ «دوبارہ کوشش کریں» اسی گروپ کی تخلیق کو چیک کرتا ہے؛ یہ دوسرا کمرہ نہیں بنائے گا۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "結果未知。「重試」會檢查同一次群組建立，不會建立第二個聊天室。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "結果未知。「重試」會檢查同一次群組建立，不會建立第二個聊天室。" } } } },
    "Pause %@" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "%@ pausieren" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Pausar %@" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Mettre en pause %@" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Metti in pausa %@" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Wstrzymaj %@" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Pausar %@" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "%@ pauzeren" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Duraklat: %@" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Приостановить %@" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "%@を一時停止" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "暂停 %@" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "%@ 일시정지" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "إيقاف %@ مؤقتًا" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "השהיית %@" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "%@ موقوف کریں" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "暫停 %@" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "暫停 %@" } } } },
