    "Session controls" : {"localizations": {"de": {"stringUnit": {"state": "needs_review", "value": "Sitzungssteuerung"}}, "es": {"stringUnit": {"state": "needs_review", "value": "Controles de sesión"}}, "fr": {"stringUnit": {"state": "needs_review", "value": "Commandes de session"}}, "it": {"stringUnit": {"state": "needs_review", "value": "Controlli sessione"}}, "pl": {"stringUnit": {"state": "needs_review", "value": "Sterowanie sesją"}}, "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Controles da sessão"}}, "nl": {"stringUnit": {"state": "needs_review", "value": "Sessiebesturing"}}, "tr": {"stringUnit": {"state": "needs_review", "value": "Oturum kontrolleri"}}, "ru": {"stringUnit": {"state": "needs_review", "value": "Управление сеансом"}}, "ja": {"stringUnit": {"state": "needs_review", "value": "セッション操作"}}, "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "会话控制"}}, "ko": {"stringUnit": {"state": "needs_review", "value": "세션 제어"}}, "ar": {"stringUnit": {"state": "needs_review", "value": "عناصر تحكم الجلسة"}}, "he": {"stringUnit": {"state": "needs_review", "value": "פקדי הפעלה"}}, "ur": {"stringUnit": {"state": "needs_review", "value": "سیشن کے کنٹرول"}}, "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "工作階段控制"}}, "zh-HK": {"stringUnit": {"state": "needs_review", "value": "工作階段控制"}}}},
    "Change session control?" : {"localizations": {"de": {"stringUnit": {"state": "needs_review", "value": "Sitzungssteuerung ändern?"}}, "es": {"stringUnit": {"state": "needs_review", "value": "¿Cambiar el control de la sesión?"}}, "fr": {"stringUnit": {"state": "needs_review", "value": "Modifier la commande de session ?"}}, "it": {"stringUnit": {"state": "needs_review", "value": "Modificare il controllo della sessione?"}}, "pl": {"stringUnit": {"state": "needs_review", "value": "Zmienić sterowanie sesją?"}}, "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Alterar o controle da sessão?"}}, "nl": {"stringUnit": {"state": "needs_review", "value": "Sessiebesturing wijzigen?"}}, "tr": {"stringUnit": {"state": "needs_review", "value": "Oturum kontrolü değiştirilsin mi?"}}, "ru": {"stringUnit": {"state": "needs_review", "value": "Изменить управление сеансом?"}}, "ja": {"stringUnit": {"state": "needs_review", "value": "セッション操作を変更しますか？"}}, "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "更改会话控制？"}}, "ko": {"stringUnit": {"state": "needs_review", "value": "세션 제어를 변경할까요?"}}, "ar": {"stringUnit": {"state": "needs_review", "value": "هل تريد تغيير التحكم في الجلسة؟"}}, "he": {"stringUnit": {"state": "needs_review", "value": "לשנות את בקרת ההפעלה?"}}, "ur": {"stringUnit": {"state": "needs_review", "value": "کیا سیشن کا کنٹرول بدلیں؟"}}, "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "變更工作階段控制？"}}, "zh-HK": {"stringUnit": {"state": "needs_review", "value": "變更工作階段控制？"}}}},
    "Next turn: %@" : {"localizations": {"de": {"stringUnit": {"state": "needs_review", "value": "Nächster Durchlauf: %@"}}, "es": {"stringUnit": {"state": "needs_review", "value": "Siguiente turno: %@"}}, "fr": {"stringUnit": {"state": "needs_review", "value": "Prochain tour : %@"}}, "it": {"stringUnit": {"state": "needs_review", "value": "Prossimo turno: %@"}}, "pl": {"stringUnit": {"state": "needs_review", "value": "Następna tura: %@"}}, "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Próximo turno: %@"}}, "nl": {"stringUnit": {"state": "needs_review", "value": "Volgende beurt: %@"}}, "tr": {"stringUnit": {"state": "needs_review", "value": "Sonraki tur: %@"}}, "ru": {"stringUnit": {"state": "needs_review", "value": "Следующий ход: %@"}}, "ja": {"stringUnit": {"state": "needs_review", "value": "次のターン：%@"}}, "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "下一轮：%@"}}, "ko": {"stringUnit": {"state": "needs_review", "value": "다음 턴: %@"}}, "ar": {"stringUnit": {"state": "needs_review", "value": "الدور التالي: %@"}}, "he": {"stringUnit": {"state": "needs_review", "value": "התור הבא: %@"}}, "ur": {"stringUnit": {"state": "needs_review", "value": "اگلی باری: %@"}}, "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "下一輪：%@"}}, "zh-HK": {"stringUnit": {"state": "needs_review", "value": "下一輪：%@"}}}},
    "Change chat model?" : {"localizations": {"de": {"stringUnit": {"state": "needs_review", "value": "Chatmodell ändern?"}}, "es": {"stringUnit": {"state": "needs_review", "value": "¿Cambiar el modelo del chat?"}}, "fr": {"stringUnit": {"state": "needs_review", "value": "Changer le modèle de discussion ?"}}, "it": {"stringUnit": {"state": "needs_review", "value": "Cambiare il modello della chat?"}}, "pl": {"stringUnit": {"state": "needs_review", "value": "Zmienić model czatu?"}}, "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Alterar o modelo da conversa?"}}, "nl": {"stringUnit": {"state": "needs_review", "value": "Chatmodel wijzigen?"}}, "tr": {"stringUnit": {"state": "needs_review", "value": "Sohbet modeli değiştirilsin mi?"}}, "ru": {"stringUnit": {"state": "needs_review", "value": "Сменить модель чата?"}}, "ja": {"stringUnit": {"state": "needs_review", "value": "チャットのモデルを変更しますか？"}}, "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "更换聊天模型？"}}, "ko": {"stringUnit": {"state": "needs_review", "value": "채팅 모델을 변경할까요?"}}, "ar": {"stringUnit": {"state": "needs_review", "value": "هل تريد تغيير نموذج المحادثة؟"}}, "he": {"stringUnit": {"state": "needs_review", "value": "להחליף את מודל הצ׳אט?"}}, "ur": {"stringUnit": {"state": "needs_review", "value": "کیا چیٹ کا ماڈل بدلیں؟"}}, "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "更換聊天模型？"}}, "zh-HK": {"stringUnit": {"state": "needs_review", "value": "更換聊天模型？"}}}},
    "Change model" : {"localizations": {"de": {"stringUnit": {"state": "needs_review", "value": "Modell ändern"}}, "es": {"stringUnit": {"state": "needs_review", "value": "Cambiar modelo"}}, "fr": {"stringUnit": {"state": "needs_review", "value": "Changer de modèle"}}, "it": {"stringUnit": {"state": "needs_review", "value": "Cambia modello"}}, "pl": {"stringUnit": {"state": "needs_review", "value": "Zmień model"}}, "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Alterar modelo"}}, "nl": {"stringUnit": {"state": "needs_review", "value": "Model wijzigen"}}, "tr": {"stringUnit": {"state": "needs_review", "value": "Modeli değiştir"}}, "ru": {"stringUnit": {"state": "needs_review", "value": "Сменить модель"}}, "ja": {"stringUnit": {"state": "needs_review", "value": "モデルを変更"}}, "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "更换模型"}}, "ko": {"stringUnit": {"state": "needs_review", "value": "모델 변경"}}, "ar": {"stringUnit": {"state": "needs_review", "value": "تغيير النموذج"}}, "he": {"stringUnit": {"state": "needs_review", "value": "החלפת מודל"}}, "ur": {"stringUnit": {"state": "needs_review", "value": "ماڈل بدلیں"}}, "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "更換模型"}}, "zh-HK": {"stringUnit": {"state": "needs_review", "value": "更換模型"}}}},
    "Ask anything..." : {"localizations": {"de": {"stringUnit": {"state": "needs_review", "value": "Frag etwas..."}}, "es": {"stringUnit": {"state": "needs_review", "value": "Pregunta lo que quieras..."}}, "fr": {"stringUnit": {"state": "needs_review", "value": "Posez une question..."}}, "it": {"stringUnit": {"state": "needs_review", "value": "Chiedi qualcosa..."}}, "pl": {"stringUnit": {"state": "needs_review", "value": "Zapytaj o cokolwiek..."}}, "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Pergunte qualquer coisa..."}}, "nl": {"stringUnit": {"state": "needs_review", "value": "Vraag maar raak..."}}, "tr": {"stringUnit": {"state": "needs_review", "value": "Bir şey sorun..."}}, "ru": {"stringUnit": {"state": "needs_review", "value": "Задайте любой вопрос..."}}, "ja": {"stringUnit": {"state": "needs_review", "value": "何でも聞いてください..."}}, "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "随便问点什么..."}}, "ko": {"stringUnit": {"state": "needs_review", "value": "무엇이든 물어보세요..."}}, "ar": {"stringUnit": {"state": "needs_review", "value": "اسأل أي شيء..."}}, "he": {"stringUnit": {"state": "needs_review", "value": "אפשר לשאול כל דבר..."}}, "ur": {"stringUnit": {"state": "needs_review", "value": "کچھ بھی پوچھیں..."}}, "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "隨意問點什麼..."}}, "zh-HK": {"stringUnit": {"state": "needs_review", "value": "隨便問點甚麼..."}}}},
    "Change the working directory for this chat. The host must accept the path before it changes." : {"localizations": {"de": {"stringUnit": {"state": "needs_review", "value": "Ändere das Arbeitsverzeichnis für diesen Chat. Der Host muss den Pfad akzeptieren, bevor er geändert wird."}}, "es": {"stringUnit": {"state": "needs_review", "value": "Cambia el directorio de trabajo de este chat. El host debe aceptar la ruta antes de cambiarla."}}, "fr": {"stringUnit": {"state": "needs_review", "value": "Changez le répertoire de travail de cette discussion. L’hôte doit accepter le chemin avant sa modification."}}, "it": {"stringUnit": {"state": "needs_review", "value": "Cambia la directory di lavoro di questa chat. L’host deve accettare il percorso prima della modifica."}}, "pl": {"stringUnit": {"state": "needs_review", "value": "Zmień katalog roboczy tego czatu. Host musi zaakceptować ścieżkę przed jej zmianą."}}, "pt-BR": {"stringUnit": {"state": "needs_review", "value": "Altere o diretório de trabalho desta conversa. O host precisa aceitar o caminho antes da alteração."}}, "nl": {"stringUnit": {"state": "needs_review", "value": "Wijzig de werkmap voor deze chat. De host moet het pad accepteren voordat het verandert."}}, "tr": {"stringUnit": {"state": "needs_review", "value": "Bu sohbetin çalışma dizinini değiştirin. Değişiklikten önce ana makinenin yolu kabul etmesi gerekir."}}, "ru": {"stringUnit": {"state": "needs_review", "value": "Измените рабочий каталог этого чата. Хост должен принять путь до его изменения."}}, "ja": {"stringUnit": {"state": "needs_review", "value": "このチャットの作業ディレクトリを変更します。変更前にホストがパスを受け入れる必要があります。"}}, "zh-Hans": {"stringUnit": {"state": "needs_review", "value": "更改此聊天的工作目录。主机必须先接受该路径才能更改。"}}, "ko": {"stringUnit": {"state": "needs_review", "value": "이 채팅의 작업 디렉터리를 변경합니다. 변경 전에 호스트가 경로를 수락해야 합니다."}}, "ar": {"stringUnit": {"state": "needs_review", "value": "غيّر دليل العمل لهذه المحادثة. يجب أن يقبل المضيف المسار قبل تغييره."}}, "he": {"stringUnit": {"state": "needs_review", "value": "שינוי תיקיית העבודה של הצ׳אט הזה. המארח חייב לאשר את הנתיב לפני השינוי."}}, "ur": {"stringUnit": {"state": "needs_review", "value": "اس چیٹ کی ورکنگ ڈائریکٹری بدلیں۔ تبدیلی سے پہلے میزبان کا راستہ قبول کرنا ضروری ہے۔"}}, "zh-Hant": {"stringUnit": {"state": "needs_review", "value": "變更此聊天的工作目錄。主機必須先接受該路徑才能變更。"}}, "zh-HK": {"stringUnit": {"state": "needs_review", "value": "變更此聊天的工作目錄。主機必須先接受該路徑才能變更。"}}}},
    "Add guidance to the current work without interrupting it." : {"extractionState" : "manual", "localizations" : {"de" : {"stringUnit" : {"state" : "needs_review", "value" : "Gib Hinweise zur aktuellen Arbeit, ohne sie zu unterbrechen."}}, "es" : {"stringUnit" : {"state" : "needs_review", "value" : "Añade indicaciones al trabajo actual sin interrumpirlo."}}, "fr" : {"stringUnit" : {"state" : "needs_review", "value" : "Ajoutez des indications au travail en cours sans l’interrompre."}}, "it" : {"stringUnit" : {"state" : "needs_review", "value" : "Aggiungi indicazioni al lavoro in corso senza interromperlo."}}, "pl" : {"stringUnit" : {"state" : "needs_review", "value" : "Dodaj wskazówki do bieżącej pracy bez jej przerywania."}}, "pt-BR" : {"stringUnit" : {"state" : "needs_review", "value" : "Adicione orientações ao trabalho atual sem interrompê-lo."}}, "nl" : {"stringUnit" : {"state" : "needs_review", "value" : "Geef aanwijzingen voor het huidige werk zonder het te onderbreken."}}, "tr" : {"stringUnit" : {"state" : "needs_review", "value" : "Mevcut işi kesintiye uğratmadan yönlendirme ekleyin."}}, "ru" : {"stringUnit" : {"state" : "needs_review", "value" : "Добавьте указания к текущей работе, не прерывая её."}}, "ja" : {"stringUnit" : {"state" : "needs_review", "value" : "現在の作業を中断せずに指示を追加します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "needs_review", "value" : "为当前工作添加指导，不中断工作。"}}, "ko" : {"stringUnit" : {"state" : "needs_review", "value" : "현재 작업을 중단하지 않고 지침을 추가합니다."}}, "ar" : {"stringUnit" : {"state" : "needs_review", "value" : "أضف توجيهات إلى العمل الحالي دون مقاطعته."}}, "he" : {"stringUnit" : {"state" : "needs_review", "value" : "הוספת הנחיות לעבודה הנוכחית בלי להפריע לה."}}, "ur" : {"stringUnit" : {"state" : "needs_review", "value" : "موجودہ کام کو روکے بغیر رہنمائی شامل کریں۔"}}, "zh-Hant" : {"stringUnit" : {"state" : "needs_review", "value" : "為目前的工作加入指引，不中斷工作。"}}, "zh-HK" : {"stringUnit" : {"state" : "needs_review", "value" : "為目前的工作加入指引，不中斷工作。"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Add guidance to the current work without interrupting it."}}}},
    "Could not save the draft. Your message was not sent." : {"extractionState" : "manual", "localizations" : {"de" : {"stringUnit" : {"state" : "needs_review", "value" : "Der Entwurf konnte nicht gespeichert werden. Deine Nachricht wurde nicht gesendet."}}, "es" : {"stringUnit" : {"state" : "needs_review", "value" : "No se pudo guardar el borrador. Tu mensaje no se envió."}}, "fr" : {"stringUnit" : {"state" : "needs_review", "value" : "Impossible d’enregistrer le brouillon. Votre message n’a pas été envoyé."}}, "it" : {"stringUnit" : {"state" : "needs_review", "value" : "Impossibile salvare la bozza. Il messaggio non è stato inviato."}}, "pl" : {"stringUnit" : {"state" : "needs_review", "value" : "Nie udało się zapisać szkicu. Wiadomość nie została wysłana."}}, "pt-BR" : {"stringUnit" : {"state" : "needs_review", "value" : "Não foi possível salvar o rascunho. Sua mensagem não foi enviada."}}, "nl" : {"stringUnit" : {"state" : "needs_review", "value" : "Het concept kon niet worden opgeslagen. Je bericht is niet verzonden."}}, "tr" : {"stringUnit" : {"state" : "needs_review", "value" : "Taslak kaydedilemedi. Mesajınız gönderilmedi."}}, "ru" : {"stringUnit" : {"state" : "needs_review", "value" : "Не удалось сохранить черновик. Сообщение не отправлено."}}, "ja" : {"stringUnit" : {"state" : "needs_review", "value" : "下書きを保存できませんでした。メッセージは送信されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "needs_review", "value" : "无法保存草稿。消息未发送。"}}, "ko" : {"stringUnit" : {"state" : "needs_review", "value" : "초안을 저장하지 못했습니다. 메시지가 전송되지 않았습니다."}}, "ar" : {"stringUnit" : {"state" : "needs_review", "value" : "تعذر حفظ المسودة. لم تُرسل رسالتك."}}, "he" : {"stringUnit" : {"state" : "needs_review", "value" : "לא ניתן לשמור את הטיוטה. ההודעה לא נשלחה."}}, "ur" : {"stringUnit" : {"state" : "needs_review", "value" : "مسودہ محفوظ نہیں ہو سکا۔ آپ کا پیغام نہیں بھیجا گیا۔"}}, "zh-Hant" : {"stringUnit" : {"state" : "needs_review", "value" : "無法儲存草稿。訊息未傳送。"}}, "zh-HK" : {"stringUnit" : {"state" : "needs_review", "value" : "無法儲存草稿。訊息未傳送。"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Could not save the draft. Your message was not sent."}}}},
    "Follow-up queued. Stop can cancel queued work." : {"extractionState" : "manual", "localizations" : {"de" : {"stringUnit" : {"state" : "needs_review", "value" : "Folgenachricht eingereiht. Stoppen kann eingereihte Arbeit abbrechen."}}, "es" : {"stringUnit" : {"state" : "needs_review", "value" : "Mensaje de seguimiento en cola. Detener puede cancelar el trabajo en cola."}}, "fr" : {"stringUnit" : {"state" : "needs_review", "value" : "Message suivant en attente. Arrêter peut annuler le travail en attente."}}, "it" : {"stringUnit" : {"state" : "needs_review", "value" : "Messaggio successivo in coda. Interrompere può annullare il lavoro in coda."}}, "pl" : {"stringUnit" : {"state" : "needs_review", "value" : "Kolejna wiadomość w kolejce. Zatrzymanie może anulować pracę w kolejce."}}, "pt-BR" : {"stringUnit" : {"state" : "needs_review", "value" : "Mensagem seguinte na fila. Parar pode cancelar o trabalho na fila."}}, "nl" : {"stringUnit" : {"state" : "needs_review", "value" : "Vervolgbericht in de wachtrij. Stoppen kan werk in de wachtrij annuleren."}}, "tr" : {"stringUnit" : {"state" : "needs_review", "value" : "Takip mesajı sıraya alındı. Durdurmak, sıradaki işleri iptal edebilir."}}, "ru" : {"stringUnit" : {"state" : "needs_review", "value" : "Следующее сообщение в очереди. Остановка может отменить работу в очереди."}}, "ja" : {"stringUnit" : {"state" : "needs_review", "value" : "次のメッセージをキューに追加しました。停止するとキュー内の作業が取り消されることがあります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "needs_review", "value" : "后续消息已排队。停止可能会取消排队中的工作。"}}, "ko" : {"stringUnit" : {"state" : "needs_review", "value" : "후속 메시지가 대기열에 추가되었습니다. 중지하면 대기 중인 작업이 취소될 수 있습니다."}}, "ar" : {"stringUnit" : {"state" : "needs_review", "value" : "أُضيفت رسالة المتابعة إلى قائمة الانتظار. قد يؤدي الإيقاف إلى إلغاء العمل المنتظر."}}, "he" : {"stringUnit" : {"state" : "needs_review", "value" : "הודעת ההמשך נוספה לתור. עצירה עשויה לבטל עבודה שבתור."}}, "ur" : {"stringUnit" : {"state" : "needs_review", "value" : "اگلا پیغام قطار میں شامل ہو گیا۔ روکنے سے قطار میں موجود کام منسوخ ہو سکتا ہے۔"}}, "zh-Hant" : {"stringUnit" : {"state" : "needs_review", "value" : "後續訊息已排入佇列。停止可能會取消佇列中的工作。"}}, "zh-HK" : {"stringUnit" : {"state" : "needs_review", "value" : "後續訊息已加入佇列。停止可能會取消佇列中的工作。"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Follow-up queued. Stop can cancel queued work."}}}},
    "Guidance queued. The bot may not have read it yet." : {"extractionState" : "manual", "localizations" : {"de" : {"stringUnit" : {"state" : "needs_review", "value" : "Hinweis eingereiht. Der Bot hat ihn möglicherweise noch nicht gelesen."}}, "es" : {"stringUnit" : {"state" : "needs_review", "value" : "Indicaciones en cola. Puede que el bot aún no las haya leído."}}, "fr" : {"stringUnit" : {"state" : "needs_review", "value" : "Indications en attente. Le bot ne les a peut-être pas encore lues."}}, "it" : {"stringUnit" : {"state" : "needs_review", "value" : "Indicazioni in coda. Il bot potrebbe non averle ancora lette."}}, "pl" : {"stringUnit" : {"state" : "needs_review", "value" : "Wskazówki w kolejce. Bot mógł ich jeszcze nie przeczytać."}}, "pt-BR" : {"stringUnit" : {"state" : "needs_review", "value" : "Orientações na fila. O bot pode ainda não ter lido."}}, "nl" : {"stringUnit" : {"state" : "needs_review", "value" : "Aanwijzingen in de wachtrij. De bot heeft ze mogelijk nog niet gelezen."}}, "tr" : {"stringUnit" : {"state" : "needs_review", "value" : "Yönlendirme sıraya alındı. Bot henüz okumamış olabilir."}}, "ru" : {"stringUnit" : {"state" : "needs_review", "value" : "Указания в очереди. Возможно, бот ещё не прочитал их."}}, "ja" : {"stringUnit" : {"state" : "needs_review", "value" : "指示をキューに追加しました。ボットはまだ読んでいない可能性があります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "needs_review", "value" : "指导已排队。机器人可能尚未读取。"}}, "ko" : {"stringUnit" : {"state" : "needs_review", "value" : "지침이 대기열에 추가되었습니다. 봇이 아직 읽지 않았을 수 있습니다."}}, "ar" : {"stringUnit" : {"state" : "needs_review", "value" : "أُضيفت التوجيهات إلى قائمة الانتظار. ربما لم يقرأها البوت بعد."}}, "he" : {"stringUnit" : {"state" : "needs_review", "value" : "ההנחיות נוספו לתור. ייתכן שהבוט עדיין לא קרא אותן."}}, "ur" : {"stringUnit" : {"state" : "needs_review", "value" : "رہنمائی قطار میں شامل ہو گئی۔ ممکن ہے بوٹ نے ابھی اسے نہ پڑھا ہو۔"}}, "zh-Hant" : {"stringUnit" : {"state" : "needs_review", "value" : "指引已排入佇列。機器人可能尚未讀取。"}}, "zh-HK" : {"stringUnit" : {"state" : "needs_review", "value" : "指引已加入佇列。機械人可能尚未讀取。"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Guidance queued. The bot may not have read it yet."}}}},
    "Interrupt current work and change direction. During startup, this may queue a follow-up." : {"extractionState" : "manual", "localizations" : {"de" : {"stringUnit" : {"state" : "needs_review", "value" : "Unterbrich die aktuelle Arbeit und ändere die Richtung. Beim Start kann dies eine Folgenachricht einreihen."}}, "es" : {"stringUnit" : {"state" : "needs_review", "value" : "Interrumpe el trabajo actual y cambia de dirección. Durante el inicio, puede poner un seguimiento en cola."}}, "fr" : {"stringUnit" : {"state" : "needs_review", "value" : "Interrompez le travail en cours et changez de direction. Au démarrage, cela peut mettre un message suivant en attente."}}, "it" : {"stringUnit" : {"state" : "needs_review", "value" : "Interrompi il lavoro in corso e cambia direzione. Durante l’avvio, potrebbe accodare un messaggio successivo."}}, "pl" : {"stringUnit" : {"state" : "needs_review", "value" : "Przerwij bieżącą pracę i zmień kierunek. Podczas uruchamiania może to dodać kolejną wiadomość do kolejki."}}, "pt-BR" : {"stringUnit" : {"state" : "needs_review", "value" : "Interrompa o trabalho atual e mude de direção. Durante a inicialização, isso pode colocar uma mensagem seguinte na fila."}}, "nl" : {"stringUnit" : {"state" : "needs_review", "value" : "Onderbreek het huidige werk en verander van richting. Tijdens het opstarten kan dit een vervolgbericht in de wachtrij plaatsen."}}, "tr" : {"stringUnit" : {"state" : "needs_review", "value" : "Mevcut işi kesip yönünü değiştirin. Başlatma sırasında bu, bir takip mesajını sıraya alabilir."}}, "ru" : {"stringUnit" : {"state" : "needs_review", "value" : "Прервите текущую работу и измените направление. При запуске это может поставить следующее сообщение в очередь."}}, "ja" : {"stringUnit" : {"state" : "needs_review", "value" : "現在の作業を中断して方針を変更します。起動中の場合は次のメッセージとしてキューに追加されることがあります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "needs_review", "value" : "中断当前工作并改变方向。启动期间可能会将其作为后续消息排队。"}}, "ko" : {"stringUnit" : {"state" : "needs_review", "value" : "현재 작업을 중단하고 방향을 바꿉니다. 시작 중에는 후속 메시지로 대기열에 추가될 수 있습니다."}}, "ar" : {"stringUnit" : {"state" : "needs_review", "value" : "قاطع العمل الحالي وغيّر الاتجاه. أثناء بدء التشغيل، قد تُضاف رسالة متابعة إلى قائمة الانتظار."}}, "he" : {"stringUnit" : {"state" : "needs_review", "value" : "הפסקת העבודה הנוכחית ושינוי כיוון. בזמן האתחול, הפעולה עשויה להוסיף הודעת המשך לתור."}}, "ur" : {"stringUnit" : {"state" : "needs_review", "value" : "موجودہ کام روک کر سمت بدلیں۔ آغاز کے دوران یہ اگلا پیغام قطار میں شامل کر سکتا ہے۔"}}, "zh-Hant" : {"stringUnit" : {"state" : "needs_review", "value" : "中斷目前的工作並改變方向。啟動期間可能會將其作為後續訊息排入佇列。"}}, "zh-HK" : {"stringUnit" : {"state" : "needs_review", "value" : "中斷目前的工作並改變方向。啟動期間可能會將其作為後續訊息加入佇列。"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Interrupt current work and change direction. During startup, this may queue a follow-up."}}}},
    "Interrupt current work and send this direction? During startup, the server may queue it for the next turn." : {"extractionState" : "manual", "localizations" : {"de" : {"stringUnit" : {"state" : "needs_review", "value" : "Aktuelle Arbeit unterbrechen und diese neue Richtung senden? Beim Start kann der Server sie für den nächsten Durchgang einreihen."}}, "es" : {"stringUnit" : {"state" : "needs_review", "value" : "¿Interrumpir el trabajo actual y enviar esta nueva dirección? Durante el inicio, el servidor puede ponerla en cola para el siguiente turno."}}, "fr" : {"stringUnit" : {"state" : "needs_review", "value" : "Interrompre le travail en cours et envoyer cette nouvelle direction ? Au démarrage, le serveur peut la mettre en attente pour le prochain tour."}}, "it" : {"stringUnit" : {"state" : "needs_review", "value" : "Interrompere il lavoro in corso e inviare questa nuova direzione? Durante l’avvio, il server potrebbe accodarla per il turno successivo."}}, "pl" : {"stringUnit" : {"state" : "needs_review", "value" : "Przerwać bieżącą pracę i wysłać nowy kierunek? Podczas uruchamiania serwer może dodać go do kolejki na następną turę."}}, "pt-BR" : {"stringUnit" : {"state" : "needs_review", "value" : "Interromper o trabalho atual e enviar esta nova direção? Durante a inicialização, o servidor pode colocá-la na fila para o próximo turno."}}, "nl" : {"stringUnit" : {"state" : "needs_review", "value" : "Het huidige werk onderbreken en deze nieuwe richting versturen? Tijdens het opstarten kan de server dit voor de volgende beurt in de wachtrij plaatsen."}}, "tr" : {"stringUnit" : {"state" : "needs_review", "value" : "Mevcut iş kesilip bu yeni yön gönderilsin mi? Başlatma sırasında sunucu bunu sonraki tur için sıraya alabilir."}}, "ru" : {"stringUnit" : {"state" : "needs_review", "value" : "Прервать текущую работу и отправить новое направление? При запуске сервер может поставить его в очередь на следующий ход."}}, "ja" : {"stringUnit" : {"state" : "needs_review", "value" : "現在の作業を中断してこの新しい方針を送信しますか？起動中の場合、サーバーは次のターンのキューに追加することがあります。"}}, "zh-Hans" : {"stringUnit" : {"state" : "needs_review", "value" : "中断当前工作并发送这个新方向吗？启动期间，服务器可能会将其排入下一轮。"}}, "ko" : {"stringUnit" : {"state" : "needs_review", "value" : "현재 작업을 중단하고 이 새 방향을 보낼까요? 시작 중에는 서버가 다음 차례의 대기열에 추가할 수 있습니다."}}, "ar" : {"stringUnit" : {"state" : "needs_review", "value" : "هل تريد مقاطعة العمل الحالي وإرسال هذا الاتجاه الجديد؟ أثناء بدء التشغيل، قد يضعه الخادم في قائمة الانتظار للدور التالي."}}, "he" : {"stringUnit" : {"state" : "needs_review", "value" : "להפסיק את העבודה הנוכחית ולשלוח את הכיוון החדש? בזמן האתחול, השרת עשוי להוסיף אותו לתור לסבב הבא."}}, "ur" : {"stringUnit" : {"state" : "needs_review", "value" : "موجودہ کام روک کر یہ نئی سمت بھیجیں؟ آغاز کے دوران سرور اسے اگلی باری کے لیے قطار میں شامل کر سکتا ہے۔"}}, "zh-Hant" : {"stringUnit" : {"state" : "needs_review", "value" : "中斷目前的工作並傳送這個新方向嗎？啟動期間，伺服器可能會將其排入下一輪。"}}, "zh-HK" : {"stringUnit" : {"state" : "needs_review", "value" : "中斷目前的工作並傳送這個新方向嗎？啟動期間，伺服器可能會將其排入下一輪。"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Interrupt current work and send this direction? During startup, the server may queue it for the next turn."}}}},
    "Message accepted. Starting work." : {"extractionState" : "manual", "localizations" : {"de" : {"stringUnit" : {"state" : "needs_review", "value" : "Nachricht angenommen. Die Arbeit beginnt."}}, "es" : {"stringUnit" : {"state" : "needs_review", "value" : "Mensaje aceptado. Iniciando el trabajo."}}, "fr" : {"stringUnit" : {"state" : "needs_review", "value" : "Message accepté. Démarrage du travail."}}, "it" : {"stringUnit" : {"state" : "needs_review", "value" : "Messaggio accettato. Avvio del lavoro."}}, "pl" : {"stringUnit" : {"state" : "needs_review", "value" : "Wiadomość przyjęta. Rozpoczynanie pracy."}}, "pt-BR" : {"stringUnit" : {"state" : "needs_review", "value" : "Mensagem aceita. Iniciando o trabalho."}}, "nl" : {"stringUnit" : {"state" : "needs_review", "value" : "Bericht geaccepteerd. Het werk begint."}}, "tr" : {"stringUnit" : {"state" : "needs_review", "value" : "Mesaj kabul edildi. İş başlıyor."}}, "ru" : {"stringUnit" : {"state" : "needs_review", "value" : "Сообщение принято. Работа начинается."}}, "ja" : {"stringUnit" : {"state" : "needs_review", "value" : "メッセージを受け付けました。作業を開始します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "needs_review", "value" : "消息已接受。正在开始工作。"}}, "ko" : {"stringUnit" : {"state" : "needs_review", "value" : "메시지가 수락되었습니다. 작업을 시작합니다."}}, "ar" : {"stringUnit" : {"state" : "needs_review", "value" : "قُبلت الرسالة. جارٍ بدء العمل."}}, "he" : {"stringUnit" : {"state" : "needs_review", "value" : "ההודעה התקבלה. העבודה מתחילה."}}, "ur" : {"stringUnit" : {"state" : "needs_review", "value" : "پیغام قبول ہو گیا۔ کام شروع ہو رہا ہے۔"}}, "zh-Hant" : {"stringUnit" : {"state" : "needs_review", "value" : "訊息已接受。正在開始工作。"}}, "zh-HK" : {"stringUnit" : {"state" : "needs_review", "value" : "訊息已接受。正在開始工作。"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Message accepted. Starting work."}}}},
    "Message action: %@" : {"extractionState" : "manual", "localizations" : {"de" : {"stringUnit" : {"state" : "needs_review", "value" : "Nachrichtenaktion: %@"}}, "es" : {"stringUnit" : {"state" : "needs_review", "value" : "Acción del mensaje: %@"}}, "fr" : {"stringUnit" : {"state" : "needs_review", "value" : "Action du message : %@"}}, "it" : {"stringUnit" : {"state" : "needs_review", "value" : "Azione del messaggio: %@"}}, "pl" : {"stringUnit" : {"state" : "needs_review", "value" : "Działanie wiadomości: %@"}}, "pt-BR" : {"stringUnit" : {"state" : "needs_review", "value" : "Ação da mensagem: %@"}}, "nl" : {"stringUnit" : {"state" : "needs_review", "value" : "Berichtactie: %@"}}, "tr" : {"stringUnit" : {"state" : "needs_review", "value" : "Mesaj eylemi: %@"}}, "ru" : {"stringUnit" : {"state" : "needs_review", "value" : "Действие с сообщением: %@"}}, "ja" : {"stringUnit" : {"state" : "needs_review", "value" : "メッセージの操作：%@"}}, "zh-Hans" : {"stringUnit" : {"state" : "needs_review", "value" : "消息操作：%@"}}, "ko" : {"stringUnit" : {"state" : "needs_review", "value" : "메시지 동작: %@"}}, "ar" : {"stringUnit" : {"state" : "needs_review", "value" : "إجراء الرسالة: %@"}}, "he" : {"stringUnit" : {"state" : "needs_review", "value" : "פעולת הודעה: %@"}}, "ur" : {"stringUnit" : {"state" : "needs_review", "value" : "پیغام کی کارروائی: %@"}}, "zh-Hant" : {"stringUnit" : {"state" : "needs_review", "value" : "訊息動作：%@"}}, "zh-HK" : {"stringUnit" : {"state" : "needs_review", "value" : "訊息操作：%@"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Message action: %@"}}}},
    "Message outcome unknown. Check the conversation in Desktop before sending again." : {"extractionState" : "manual", "localizations" : {"de" : {"stringUnit" : {"state" : "needs_review", "value" : "Nachrichtenstatus unbekannt. Prüfe den Chat in Desktop, bevor du erneut sendest."}}, "es" : {"stringUnit" : {"state" : "needs_review", "value" : "Resultado del mensaje desconocido. Revisa la conversación en Desktop antes de volver a enviarlo."}}, "fr" : {"stringUnit" : {"state" : "needs_review", "value" : "Résultat du message inconnu. Vérifiez la conversation dans Desktop avant de renvoyer."}}, "it" : {"stringUnit" : {"state" : "needs_review", "value" : "Esito del messaggio sconosciuto. Controlla la conversazione in Desktop prima di inviare di nuovo."}}, "pl" : {"stringUnit" : {"state" : "needs_review", "value" : "Wynik wysłania nieznany. Sprawdź rozmowę w Desktop przed ponownym wysłaniem."}}, "pt-BR" : {"stringUnit" : {"state" : "needs_review", "value" : "Resultado da mensagem desconhecido. Confira a conversa no Desktop antes de enviar novamente."}}, "nl" : {"stringUnit" : {"state" : "needs_review", "value" : "Uitkomst van het bericht onbekend. Controleer het gesprek in Desktop voordat je opnieuw verstuurt."}}, "tr" : {"stringUnit" : {"state" : "needs_review", "value" : "Mesajın sonucu bilinmiyor. Tekrar göndermeden önce Desktop'ta konuşmayı kontrol edin."}}, "ru" : {"stringUnit" : {"state" : "needs_review", "value" : "Результат отправки неизвестен. Проверьте разговор в Desktop перед повторной отправкой."}}, "ja" : {"stringUnit" : {"state" : "needs_review", "value" : "メッセージの結果が不明です。再送信する前にDesktopで会話を確認してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "needs_review", "value" : "消息结果未知。再次发送前，请在 Desktop 中检查对话。"}}, "ko" : {"stringUnit" : {"state" : "needs_review", "value" : "메시지 결과를 알 수 없습니다. 다시 보내기 전에 Desktop에서 대화를 확인하세요."}}, "ar" : {"stringUnit" : {"state" : "needs_review", "value" : "نتيجة الرسالة غير معروفة. راجع المحادثة في Desktop قبل الإرسال مجددًا."}}, "he" : {"stringUnit" : {"state" : "needs_review", "value" : "תוצאת ההודעה אינה ידועה. יש לבדוק את השיחה ב-Desktop לפני שליחה חוזרת."}}, "ur" : {"stringUnit" : {"state" : "needs_review", "value" : "پیغام کا نتیجہ معلوم نہیں۔ دوبارہ بھیجنے سے پہلے Desktop میں گفتگو دیکھیں۔"}}, "zh-Hant" : {"stringUnit" : {"state" : "needs_review", "value" : "訊息結果未知。再次傳送前，請在 Desktop 中檢查對話。"}}, "zh-HK" : {"stringUnit" : {"state" : "needs_review", "value" : "訊息結果未知。再次傳送前，請在 Desktop 中檢查對話。"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Message outcome unknown. Check the conversation in Desktop before sending again."}}}},
    "Queue" : {"extractionState" : "manual", "localizations" : {"de" : {"stringUnit" : {"state" : "needs_review", "value" : "Einreihen"}}, "es" : {"stringUnit" : {"state" : "needs_review", "value" : "Encolar"}}, "fr" : {"stringUnit" : {"state" : "needs_review", "value" : "Mettre en attente"}}, "it" : {"stringUnit" : {"state" : "needs_review", "value" : "Accoda"}}, "pl" : {"stringUnit" : {"state" : "needs_review", "value" : "Do kolejki"}}, "pt-BR" : {"stringUnit" : {"state" : "needs_review", "value" : "Enfileirar"}}, "nl" : {"stringUnit" : {"state" : "needs_review", "value" : "In wachtrij"}}, "tr" : {"stringUnit" : {"state" : "needs_review", "value" : "Sıraya al"}}, "ru" : {"stringUnit" : {"state" : "needs_review", "value" : "В очередь"}}, "ja" : {"stringUnit" : {"state" : "needs_review", "value" : "キューに追加"}}, "zh-Hans" : {"stringUnit" : {"state" : "needs_review", "value" : "排队"}}, "ko" : {"stringUnit" : {"state" : "needs_review", "value" : "대기열에 추가"}}, "ar" : {"stringUnit" : {"state" : "needs_review", "value" : "إضافة للانتظار"}}, "he" : {"stringUnit" : {"state" : "needs_review", "value" : "הוספה לתור"}}, "ur" : {"stringUnit" : {"state" : "needs_review", "value" : "قطار میں ڈالیں"}}, "zh-Hant" : {"stringUnit" : {"state" : "needs_review", "value" : "排入佇列"}}, "zh-HK" : {"stringUnit" : {"state" : "needs_review", "value" : "加入佇列"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Queue"}}}},
    "Redirect" : {"extractionState" : "manual", "localizations" : {"de" : {"stringUnit" : {"state" : "needs_review", "value" : "Umlenken"}}, "es" : {"stringUnit" : {"state" : "needs_review", "value" : "Redirigir"}}, "fr" : {"stringUnit" : {"state" : "needs_review", "value" : "Rediriger"}}, "it" : {"stringUnit" : {"state" : "needs_review", "value" : "Reindirizza"}}, "pl" : {"stringUnit" : {"state" : "needs_review", "value" : "Zmień kierunek"}}, "pt-BR" : {"stringUnit" : {"state" : "needs_review", "value" : "Redirecionar"}}, "nl" : {"stringUnit" : {"state" : "needs_review", "value" : "Bijsturen"}}, "tr" : {"stringUnit" : {"state" : "needs_review", "value" : "Yönü değiştir"}}, "ru" : {"stringUnit" : {"state" : "needs_review", "value" : "Перенаправить"}}, "ja" : {"stringUnit" : {"state" : "needs_review", "value" : "方針を変更"}}, "zh-Hans" : {"stringUnit" : {"state" : "needs_review", "value" : "重定向"}}, "ko" : {"stringUnit" : {"state" : "needs_review", "value" : "방향 변경"}}, "ar" : {"stringUnit" : {"state" : "needs_review", "value" : "تغيير الاتجاه"}}, "he" : {"stringUnit" : {"state" : "needs_review", "value" : "שינוי כיוון"}}, "ur" : {"stringUnit" : {"state" : "needs_review", "value" : "سمت بدلیں"}}, "zh-Hant" : {"stringUnit" : {"state" : "needs_review", "value" : "重新導向"}}, "zh-HK" : {"stringUnit" : {"state" : "needs_review", "value" : "重新導向"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Redirect"}}}},
    "Redirect accepted." : {"extractionState" : "manual", "localizations" : {"de" : {"stringUnit" : {"state" : "needs_review", "value" : "Neue Richtung angenommen."}}, "es" : {"stringUnit" : {"state" : "needs_review", "value" : "Redirección aceptada."}}, "fr" : {"stringUnit" : {"state" : "needs_review", "value" : "Redirection acceptée."}}, "it" : {"stringUnit" : {"state" : "needs_review", "value" : "Reindirizzamento accettato."}}, "pl" : {"stringUnit" : {"state" : "needs_review", "value" : "Zmiana kierunku przyjęta."}}, "pt-BR" : {"stringUnit" : {"state" : "needs_review", "value" : "Redirecionamento aceito."}}, "nl" : {"stringUnit" : {"state" : "needs_review", "value" : "Nieuwe richting geaccepteerd."}}, "tr" : {"stringUnit" : {"state" : "needs_review", "value" : "Yön değişikliği kabul edildi."}}, "ru" : {"stringUnit" : {"state" : "needs_review", "value" : "Перенаправление принято."}}, "ja" : {"stringUnit" : {"state" : "needs_review", "value" : "方針変更を受け付けました。"}}, "zh-Hans" : {"stringUnit" : {"state" : "needs_review", "value" : "已接受重定向。"}}, "ko" : {"stringUnit" : {"state" : "needs_review", "value" : "방향 변경이 수락되었습니다."}}, "ar" : {"stringUnit" : {"state" : "needs_review", "value" : "قُبل تغيير الاتجاه."}}, "he" : {"stringUnit" : {"state" : "needs_review", "value" : "שינוי הכיוון התקבל."}}, "ur" : {"stringUnit" : {"state" : "needs_review", "value" : "سمت کی تبدیلی قبول ہو گئی۔"}}, "zh-Hant" : {"stringUnit" : {"state" : "needs_review", "value" : "已接受重新導向。"}}, "zh-HK" : {"stringUnit" : {"state" : "needs_review", "value" : "已接受重新導向。"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Redirect accepted."}}}},
    "Redirect queued for the next turn during startup." : {"extractionState" : "manual", "localizations" : {"de" : {"stringUnit" : {"state" : "needs_review", "value" : "Neue Richtung beim Start für den nächsten Durchgang eingereiht."}}, "es" : {"stringUnit" : {"state" : "needs_review", "value" : "Redirección en cola para el siguiente turno durante el inicio."}}, "fr" : {"stringUnit" : {"state" : "needs_review", "value" : "Redirection mise en attente au démarrage pour le prochain tour."}}, "it" : {"stringUnit" : {"state" : "needs_review", "value" : "Reindirizzamento accodato durante l’avvio per il turno successivo."}}, "pl" : {"stringUnit" : {"state" : "needs_review", "value" : "Zmiana kierunku dodana podczas uruchamiania do kolejki na następną turę."}}, "pt-BR" : {"stringUnit" : {"state" : "needs_review", "value" : "Redirecionamento enfileirado durante a inicialização para o próximo turno."}}, "nl" : {"stringUnit" : {"state" : "needs_review", "value" : "Nieuwe richting tijdens het opstarten in de wachtrij geplaatst voor de volgende beurt."}}, "tr" : {"stringUnit" : {"state" : "needs_review", "value" : "Yön değişikliği başlatma sırasında sonraki tur için sıraya alındı."}}, "ru" : {"stringUnit" : {"state" : "needs_review", "value" : "При запуске перенаправление поставлено в очередь на следующий ход."}}, "ja" : {"stringUnit" : {"state" : "needs_review", "value" : "起動中のため、方針変更を次のターンのキューに追加しました。"}}, "zh-Hans" : {"stringUnit" : {"state" : "needs_review", "value" : "启动期间，重定向已排入下一轮。"}}, "ko" : {"stringUnit" : {"state" : "needs_review", "value" : "시작 중에 방향 변경이 다음 차례의 대기열에 추가되었습니다."}}, "ar" : {"stringUnit" : {"state" : "needs_review", "value" : "أُضيف تغيير الاتجاه أثناء بدء التشغيل إلى قائمة الانتظار للدور التالي."}}, "he" : {"stringUnit" : {"state" : "needs_review", "value" : "שינוי הכיוון נוסף בזמן האתחול לתור לסבב הבא."}}, "ur" : {"stringUnit" : {"state" : "needs_review", "value" : "آغاز کے دوران سمت کی تبدیلی اگلی باری کے لیے قطار میں شامل ہو گئی۔"}}, "zh-Hant" : {"stringUnit" : {"state" : "needs_review", "value" : "啟動期間，重新導向已排入下一輪。"}}, "zh-HK" : {"stringUnit" : {"state" : "needs_review", "value" : "啟動期間，重新導向已排入下一輪。"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Redirect queued for the next turn during startup."}}}},
    "Redirect this bot's current work?" : {"extractionState" : "manual", "localizations" : {"de" : {"stringUnit" : {"state" : "needs_review", "value" : "Aktuelle Arbeit dieses Bots umlenken?"}}, "es" : {"stringUnit" : {"state" : "needs_review", "value" : "¿Redirigir el trabajo actual de este bot?"}}, "fr" : {"stringUnit" : {"state" : "needs_review", "value" : "Rediriger le travail en cours de ce bot ?"}}, "it" : {"stringUnit" : {"state" : "needs_review", "value" : "Reindirizzare il lavoro attuale di questo bot?"}}, "pl" : {"stringUnit" : {"state" : "needs_review", "value" : "Zmienić kierunek bieżącej pracy tego bota?"}}, "pt-BR" : {"stringUnit" : {"state" : "needs_review", "value" : "Redirecionar o trabalho atual deste bot?"}}, "nl" : {"stringUnit" : {"state" : "needs_review", "value" : "Het huidige werk van deze bot bijsturen?"}}, "tr" : {"stringUnit" : {"state" : "needs_review", "value" : "Bu botun mevcut işinin yönü değiştirilsin mi?"}}, "ru" : {"stringUnit" : {"state" : "needs_review", "value" : "Перенаправить текущую работу этого бота?"}}, "ja" : {"stringUnit" : {"state" : "needs_review", "value" : "このボットの現在の作業方針を変更しますか？"}}, "zh-Hans" : {"stringUnit" : {"state" : "needs_review", "value" : "重定向此机器人的当前工作吗？"}}, "ko" : {"stringUnit" : {"state" : "needs_review", "value" : "이 봇의 현재 작업 방향을 바꿀까요?"}}, "ar" : {"stringUnit" : {"state" : "needs_review", "value" : "هل تريد تغيير اتجاه العمل الحالي لهذا البوت؟"}}, "he" : {"stringUnit" : {"state" : "needs_review", "value" : "לשנות את כיוון העבודה הנוכחית של הבוט הזה?"}}, "ur" : {"stringUnit" : {"state" : "needs_review", "value" : "اس بوٹ کے موجودہ کام کی سمت بدلیں؟"}}, "zh-Hant" : {"stringUnit" : {"state" : "needs_review", "value" : "重新導向此機器人目前的工作嗎？"}}, "zh-HK" : {"stringUnit" : {"state" : "needs_review", "value" : "重新導向此機械人目前的工作嗎？"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Redirect this bot's current work?"}}}},
    "Run after current work, or immediately if it has finished." : {"extractionState" : "manual", "localizations" : {"de" : {"stringUnit" : {"state" : "needs_review", "value" : "Nach der aktuellen Arbeit ausführen, oder sofort, falls sie beendet ist."}}, "es" : {"stringUnit" : {"state" : "needs_review", "value" : "Ejecutar después del trabajo actual, o inmediatamente si ya terminó."}}, "fr" : {"stringUnit" : {"state" : "needs_review", "value" : "Exécuter après le travail en cours, ou immédiatement s’il est terminé."}}, "it" : {"stringUnit" : {"state" : "needs_review", "value" : "Esegui dopo il lavoro attuale, o subito se è terminato."}}, "pl" : {"stringUnit" : {"state" : "needs_review", "value" : "Uruchom po bieżącej pracy lub od razu, jeśli się zakończyła."}}, "pt-BR" : {"stringUnit" : {"state" : "needs_review", "value" : "Executar após o trabalho atual, ou imediatamente se ele já terminou."}}, "nl" : {"stringUnit" : {"state" : "needs_review", "value" : "Uitvoeren na het huidige werk, of meteen als het al klaar is."}}, "tr" : {"stringUnit" : {"state" : "needs_review", "value" : "Mevcut işten sonra veya iş bittiyse hemen çalıştırın."}}, "ru" : {"stringUnit" : {"state" : "needs_review", "value" : "Выполнить после текущей работы или сразу, если она уже завершена."}}, "ja" : {"stringUnit" : {"state" : "needs_review", "value" : "現在の作業が終わってから実行します。すでに終了している場合はすぐに実行します。"}}, "zh-Hans" : {"stringUnit" : {"state" : "needs_review", "value" : "在当前工作完成后执行；如果已经完成，则立即执行。"}}, "ko" : {"stringUnit" : {"state" : "needs_review", "value" : "현재 작업 후에 실행하거나, 이미 끝났다면 즉시 실행합니다."}}, "ar" : {"stringUnit" : {"state" : "needs_review", "value" : "التنفيذ بعد العمل الحالي، أو فورًا إذا كان قد انتهى."}}, "he" : {"stringUnit" : {"state" : "needs_review", "value" : "הרצה אחרי העבודה הנוכחית, או מיד אם היא כבר הסתיימה."}}, "ur" : {"stringUnit" : {"state" : "needs_review", "value" : "موجودہ کام کے بعد چلائیں، یا اگر وہ ختم ہو گیا ہے تو فوراً چلائیں۔"}}, "zh-Hant" : {"stringUnit" : {"state" : "needs_review", "value" : "在目前的工作完成後執行；如果已經完成，則立即執行。"}}, "zh-HK" : {"stringUnit" : {"state" : "needs_review", "value" : "在目前的工作完成後執行；如果已經完成，則立即執行。"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Run after current work, or immediately if it has finished."}}}},
    "Speech stopped. No new message was started." : {"extractionState" : "manual", "localizations" : {"de" : {"stringUnit" : {"state" : "needs_review", "value" : "Sprachausgabe gestoppt. Keine neue Nachricht gestartet."}}, "es" : {"stringUnit" : {"state" : "needs_review", "value" : "Voz detenida. No se inició ningún mensaje nuevo."}}, "fr" : {"stringUnit" : {"state" : "needs_review", "value" : "Voix arrêtée. Aucun nouveau message n’a été lancé."}}, "it" : {"stringUnit" : {"state" : "needs_review", "value" : "Riproduzione vocale interrotta. Nessun nuovo messaggio avviato."}}, "pl" : {"stringUnit" : {"state" : "needs_review", "value" : "Mowa zatrzymana. Nie rozpoczęto nowej wiadomości."}}, "pt-BR" : {"stringUnit" : {"state" : "needs_review", "value" : "Fala interrompida. Nenhuma nova mensagem foi iniciada."}}, "nl" : {"stringUnit" : {"state" : "needs_review", "value" : "Spraak gestopt. Er is geen nieuw bericht gestart."}}, "tr" : {"stringUnit" : {"state" : "needs_review", "value" : "Ses durduruldu. Yeni bir mesaj başlatılmadı."}}, "ru" : {"stringUnit" : {"state" : "needs_review", "value" : "Озвучивание остановлено. Новое сообщение не запущено."}}, "ja" : {"stringUnit" : {"state" : "needs_review", "value" : "音声を停止しました。新しいメッセージは開始されていません。"}}, "zh-Hans" : {"stringUnit" : {"state" : "needs_review", "value" : "语音已停止。未启动新消息。"}}, "ko" : {"stringUnit" : {"state" : "needs_review", "value" : "음성이 중지되었습니다. 새 메시지는 시작되지 않았습니다."}}, "ar" : {"stringUnit" : {"state" : "needs_review", "value" : "توقف الكلام. لم تبدأ رسالة جديدة."}}, "he" : {"stringUnit" : {"state" : "needs_review", "value" : "הדיבור נעצר. לא התחילה הודעה חדשה."}}, "ur" : {"stringUnit" : {"state" : "needs_review", "value" : "آواز روک دی گئی۔ کوئی نیا پیغام شروع نہیں ہوا۔"}}, "zh-Hant" : {"stringUnit" : {"state" : "needs_review", "value" : "語音已停止。未啟動新訊息。"}}, "zh-HK" : {"stringUnit" : {"state" : "needs_review", "value" : "語音已停止。未啟動新訊息。"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Speech stopped. No new message was started."}}}},
    "Start a new turn. If the bot becomes busy, wait for that work to finish." : {"extractionState" : "manual", "localizations" : {"de" : {"stringUnit" : {"state" : "needs_review", "value" : "Starte einen neuen Durchgang. Falls der Bot beschäftigt ist, warte, bis diese Arbeit beendet ist."}}, "es" : {"stringUnit" : {"state" : "needs_review", "value" : "Inicia un nuevo turno. Si el bot está ocupado, espera a que termine ese trabajo."}}, "fr" : {"stringUnit" : {"state" : "needs_review", "value" : "Commencez un nouveau tour. Si le bot est occupé, attendez la fin de ce travail."}}, "it" : {"stringUnit" : {"state" : "needs_review", "value" : "Inizia un nuovo turno. Se il bot è occupato, attendi che quel lavoro finisca."}}, "pl" : {"stringUnit" : {"state" : "needs_review", "value" : "Rozpocznij nową turę. Jeśli bot jest zajęty, poczekaj na zakończenie tej pracy."}}, "pt-BR" : {"stringUnit" : {"state" : "needs_review", "value" : "Inicie um novo turno. Se o bot estiver ocupado, espere esse trabalho terminar."}}, "nl" : {"stringUnit" : {"state" : "needs_review", "value" : "Begin een nieuwe beurt. Als de bot bezig is, wacht tot dat werk klaar is."}}, "tr" : {"stringUnit" : {"state" : "needs_review", "value" : "Yeni bir tur başlatın. Bot meşgul olursa işin bitmesini bekleyin."}}, "ru" : {"stringUnit" : {"state" : "needs_review", "value" : "Начните новый ход. Если бот занят, дождитесь завершения этой работы."}}, "ja" : {"stringUnit" : {"state" : "needs_review", "value" : "新しいターンを開始します。ボットが作業中になった場合は、その作業が終わるまで待ちます。"}}, "zh-Hans" : {"stringUnit" : {"state" : "needs_review", "value" : "开始新一轮。如果机器人变为忙碌，请等待该工作完成。"}}, "ko" : {"stringUnit" : {"state" : "needs_review", "value" : "새 차례를 시작합니다. 봇이 바빠지면 해당 작업이 끝날 때까지 기다립니다."}}, "ar" : {"stringUnit" : {"state" : "needs_review", "value" : "ابدأ دورًا جديدًا. إذا أصبح البوت مشغولًا، فانتظر انتهاء ذلك العمل."}}, "he" : {"stringUnit" : {"state" : "needs_review", "value" : "התחלת סבב חדש. אם הבוט נעשה עסוק, יש להמתין לסיום העבודה הזאת."}}, "ur" : {"stringUnit" : {"state" : "needs_review", "value" : "نئی باری شروع کریں۔ اگر بوٹ مصروف ہو جائے تو اس کام کے ختم ہونے کا انتظار کریں۔"}}, "zh-Hant" : {"stringUnit" : {"state" : "needs_review", "value" : "開始新一輪。如果機器人變為忙碌，請等待該工作完成。"}}, "zh-HK" : {"stringUnit" : {"state" : "needs_review", "value" : "開始新一輪。如果機械人變為忙碌，請等待該工作完成。"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Start a new turn. If the bot becomes busy, wait for that work to finish."}}}},
    "Steer" : {"extractionState" : "manual", "localizations" : {"de" : {"stringUnit" : {"state" : "needs_review", "value" : "Anleiten"}}, "es" : {"stringUnit" : {"state" : "needs_review", "value" : "Guiar"}}, "fr" : {"stringUnit" : {"state" : "needs_review", "value" : "Guider"}}, "it" : {"stringUnit" : {"state" : "needs_review", "value" : "Guida"}}, "pl" : {"stringUnit" : {"state" : "needs_review", "value" : "Pokieruj"}}, "pt-BR" : {"stringUnit" : {"state" : "needs_review", "value" : "Orientar"}}, "nl" : {"stringUnit" : {"state" : "needs_review", "value" : "Aanwijzingen"}}, "tr" : {"stringUnit" : {"state" : "needs_review", "value" : "Yönlendir"}}, "ru" : {"stringUnit" : {"state" : "needs_review", "value" : "Дать указания"}}, "ja" : {"stringUnit" : {"state" : "needs_review", "value" : "指示を追加"}}, "zh-Hans" : {"stringUnit" : {"state" : "needs_review", "value" : "指导"}}, "ko" : {"stringUnit" : {"state" : "needs_review", "value" : "지침 추가"}}, "ar" : {"stringUnit" : {"state" : "needs_review", "value" : "توجيه"}}, "he" : {"stringUnit" : {"state" : "needs_review", "value" : "הנחיה"}}, "ur" : {"stringUnit" : {"state" : "needs_review", "value" : "رہنمائی کریں"}}, "zh-Hant" : {"stringUnit" : {"state" : "needs_review", "value" : "指引"}}, "zh-HK" : {"stringUnit" : {"state" : "needs_review", "value" : "指引"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Steer"}}}},
    "The bot did not accept this message. Your draft is still here." : {"extractionState" : "manual", "localizations" : {"de" : {"stringUnit" : {"state" : "needs_review", "value" : "Der Bot hat diese Nachricht nicht angenommen. Dein Entwurf ist noch da."}}, "es" : {"stringUnit" : {"state" : "needs_review", "value" : "El bot no aceptó este mensaje. Tu borrador sigue aquí."}}, "fr" : {"stringUnit" : {"state" : "needs_review", "value" : "Le bot n’a pas accepté ce message. Votre brouillon est toujours là."}}, "it" : {"stringUnit" : {"state" : "needs_review", "value" : "Il bot non ha accettato questo messaggio. La bozza è ancora qui."}}, "pl" : {"stringUnit" : {"state" : "needs_review", "value" : "Bot nie przyjął tej wiadomości. Szkic nadal tu jest."}}, "pt-BR" : {"stringUnit" : {"state" : "needs_review", "value" : "O bot não aceitou esta mensagem. Seu rascunho continua aqui."}}, "nl" : {"stringUnit" : {"state" : "needs_review", "value" : "De bot heeft dit bericht niet geaccepteerd. Je concept staat er nog."}}, "tr" : {"stringUnit" : {"state" : "needs_review", "value" : "Bot bu mesajı kabul etmedi. Taslağınız hâlâ burada."}}, "ru" : {"stringUnit" : {"state" : "needs_review", "value" : "Бот не принял это сообщение. Черновик сохранён."}}, "ja" : {"stringUnit" : {"state" : "needs_review", "value" : "ボットはこのメッセージを受け付けませんでした。下書きは残っています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "needs_review", "value" : "机器人未接受此消息。草稿仍然保留。"}}, "ko" : {"stringUnit" : {"state" : "needs_review", "value" : "봇이 이 메시지를 수락하지 않았습니다. 초안은 그대로 있습니다."}}, "ar" : {"stringUnit" : {"state" : "needs_review", "value" : "لم يقبل البوت هذه الرسالة. مسودتك لا تزال هنا."}}, "he" : {"stringUnit" : {"state" : "needs_review", "value" : "הבוט לא קיבל את ההודעה. הטיוטה עדיין כאן."}}, "ur" : {"stringUnit" : {"state" : "needs_review", "value" : "بوٹ نے یہ پیغام قبول نہیں کیا۔ آپ کا مسودہ یہیں موجود ہے۔"}}, "zh-Hant" : {"stringUnit" : {"state" : "needs_review", "value" : "機器人未接受此訊息。草稿仍然保留。"}}, "zh-HK" : {"stringUnit" : {"state" : "needs_review", "value" : "機械人未接受此訊息。草稿仍然保留。"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The bot did not accept this message. Your draft is still here."}}}},
    "The work changed before this message could be sent. Choose an action again." : {"extractionState" : "manual", "localizations" : {"de" : {"stringUnit" : {"state" : "needs_review", "value" : "Die Arbeit hat sich vor dem Senden geändert. Wähle erneut eine Aktion."}}, "es" : {"stringUnit" : {"state" : "needs_review", "value" : "El trabajo cambió antes de enviar el mensaje. Elige una acción de nuevo."}}, "fr" : {"stringUnit" : {"state" : "needs_review", "value" : "Le travail a changé avant l’envoi du message. Choisissez à nouveau une action."}}, "it" : {"stringUnit" : {"state" : "needs_review", "value" : "Il lavoro è cambiato prima dell’invio del messaggio. Scegli di nuovo un’azione."}}, "pl" : {"stringUnit" : {"state" : "needs_review", "value" : "Praca zmieniła się przed wysłaniem wiadomości. Wybierz działanie ponownie."}}, "pt-BR" : {"stringUnit" : {"state" : "needs_review", "value" : "O trabalho mudou antes do envio da mensagem. Escolha uma ação novamente."}}, "nl" : {"stringUnit" : {"state" : "needs_review", "value" : "Het werk veranderde voordat dit bericht kon worden verzonden. Kies opnieuw een actie."}}, "tr" : {"stringUnit" : {"state" : "needs_review", "value" : "Mesaj gönderilmeden önce iş değişti. Yeniden bir eylem seçin."}}, "ru" : {"stringUnit" : {"state" : "needs_review", "value" : "Работа изменилась до отправки сообщения. Выберите действие снова."}}, "ja" : {"stringUnit" : {"state" : "needs_review", "value" : "送信前に作業が変わりました。操作をもう一度選んでください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "needs_review", "value" : "消息发送前，工作发生了变化。请重新选择操作。"}}, "ko" : {"stringUnit" : {"state" : "needs_review", "value" : "메시지를 보내기 전에 작업이 변경되었습니다. 동작을 다시 선택하세요."}}, "ar" : {"stringUnit" : {"state" : "needs_review", "value" : "تغيّر العمل قبل إرسال هذه الرسالة. اختر إجراءً مرة أخرى."}}, "he" : {"stringUnit" : {"state" : "needs_review", "value" : "העבודה השתנתה לפני שניתן היה לשלוח את ההודעה. יש לבחור פעולה מחדש."}}, "ur" : {"stringUnit" : {"state" : "needs_review", "value" : "پیغام بھیجنے سے پہلے کام بدل گیا۔ کارروائی دوبارہ منتخب کریں۔"}}, "zh-Hant" : {"stringUnit" : {"state" : "needs_review", "value" : "訊息傳送前，工作發生了變化。請重新選擇動作。"}}, "zh-HK" : {"stringUnit" : {"state" : "needs_review", "value" : "訊息傳送前，工作發生了變化。請重新選擇操作。"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "The work changed before this message could be sent. Choose an action again."}}}},
    "This action is unavailable for the bot's current work. Your draft is still here." : {"extractionState" : "manual", "localizations" : {"de" : {"stringUnit" : {"state" : "needs_review", "value" : "Diese Aktion ist für die aktuelle Arbeit des Bots nicht verfügbar. Dein Entwurf ist noch da."}}, "es" : {"stringUnit" : {"state" : "needs_review", "value" : "Esta acción no está disponible para el trabajo actual del bot. Tu borrador sigue aquí."}}, "fr" : {"stringUnit" : {"state" : "needs_review", "value" : "Cette action n’est pas disponible pour le travail actuel du bot. Votre brouillon est toujours là."}}, "it" : {"stringUnit" : {"state" : "needs_review", "value" : "Questa azione non è disponibile per il lavoro attuale del bot. La bozza è ancora qui."}}, "pl" : {"stringUnit" : {"state" : "needs_review", "value" : "To działanie jest niedostępne dla bieżącej pracy bota. Szkic nadal tu jest."}}, "pt-BR" : {"stringUnit" : {"state" : "needs_review", "value" : "Esta ação não está disponível para o trabalho atual do bot. Seu rascunho continua aqui."}}, "nl" : {"stringUnit" : {"state" : "needs_review", "value" : "Deze actie is niet beschikbaar voor het huidige werk van de bot. Je concept staat er nog."}}, "tr" : {"stringUnit" : {"state" : "needs_review", "value" : "Bu eylem botun mevcut işi için kullanılamıyor. Taslağınız hâlâ burada."}}, "ru" : {"stringUnit" : {"state" : "needs_review", "value" : "Это действие недоступно для текущей работы бота. Черновик сохранён."}}, "ja" : {"stringUnit" : {"state" : "needs_review", "value" : "この操作はボットの現在の作業では利用できません。下書きは残っています。"}}, "zh-Hans" : {"stringUnit" : {"state" : "needs_review", "value" : "此操作不适用于机器人当前的工作。草稿仍然保留。"}}, "ko" : {"stringUnit" : {"state" : "needs_review", "value" : "이 동작은 봇의 현재 작업에서 사용할 수 없습니다. 초안은 그대로 있습니다."}}, "ar" : {"stringUnit" : {"state" : "needs_review", "value" : "هذا الإجراء غير متاح لعمل البوت الحالي. مسودتك لا تزال هنا."}}, "he" : {"stringUnit" : {"state" : "needs_review", "value" : "הפעולה אינה זמינה לעבודה הנוכחית של הבוט. הטיוטה עדיין כאן."}}, "ur" : {"stringUnit" : {"state" : "needs_review", "value" : "یہ کارروائی بوٹ کے موجودہ کام کے لیے دستیاب نہیں۔ آپ کا مسودہ یہیں موجود ہے۔"}}, "zh-Hant" : {"stringUnit" : {"state" : "needs_review", "value" : "此動作不適用於機器人目前的工作。草稿仍然保留。"}}, "zh-HK" : {"stringUnit" : {"state" : "needs_review", "value" : "此操作不適用於機械人目前的工作。草稿仍然保留。"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "This action is unavailable for the bot's current work. Your draft is still here."}}}},
    "Work finished. Choose Send to start a new turn." : {"extractionState" : "manual", "localizations" : {"de" : {"stringUnit" : {"state" : "needs_review", "value" : "Arbeit beendet. Wähle Senden, um einen neuen Durchgang zu starten."}}, "es" : {"stringUnit" : {"state" : "needs_review", "value" : "Trabajo terminado. Elige Enviar para iniciar un nuevo turno."}}, "fr" : {"stringUnit" : {"state" : "needs_review", "value" : "Travail terminé. Choisissez Envoyer pour commencer un nouveau tour."}}, "it" : {"stringUnit" : {"state" : "needs_review", "value" : "Lavoro terminato. Scegli Invia per iniziare un nuovo turno."}}, "pl" : {"stringUnit" : {"state" : "needs_review", "value" : "Praca zakończona. Wybierz Wyślij, aby rozpocząć nową turę."}}, "pt-BR" : {"stringUnit" : {"state" : "needs_review", "value" : "Trabalho concluído. Escolha Enviar para iniciar um novo turno."}}, "nl" : {"stringUnit" : {"state" : "needs_review", "value" : "Werk klaar. Kies Verzenden om een nieuwe beurt te beginnen."}}, "tr" : {"stringUnit" : {"state" : "needs_review", "value" : "İş bitti. Yeni bir tur başlatmak için Gönder'i seçin."}}, "ru" : {"stringUnit" : {"state" : "needs_review", "value" : "Работа завершена. Выберите «Отправить», чтобы начать новый ход."}}, "ja" : {"stringUnit" : {"state" : "needs_review", "value" : "作業が終了しました。「送信」を選んで新しいターンを開始してください。"}}, "zh-Hans" : {"stringUnit" : {"state" : "needs_review", "value" : "工作已完成。选择“发送”开始新一轮。"}}, "ko" : {"stringUnit" : {"state" : "needs_review", "value" : "작업이 끝났습니다. 보내기를 선택하여 새 차례를 시작하세요."}}, "ar" : {"stringUnit" : {"state" : "needs_review", "value" : "انتهى العمل. اختر إرسال لبدء دور جديد."}}, "he" : {"stringUnit" : {"state" : "needs_review", "value" : "העבודה הסתיימה. יש לבחור שליחה כדי להתחיל סבב חדש."}}, "ur" : {"stringUnit" : {"state" : "needs_review", "value" : "کام ختم ہو گیا۔ نئی باری شروع کرنے کے لیے بھیجیں منتخب کریں۔"}}, "zh-Hant" : {"stringUnit" : {"state" : "needs_review", "value" : "工作已完成。選擇「傳送」開始新一輪。"}}, "zh-HK" : {"stringUnit" : {"state" : "needs_review", "value" : "工作已完成。選擇「傳送」開始新一輪。"}}, "en" : {"stringUnit" : {"state" : "translated", "value" : "Work finished. Choose Send to start a new turn."}}}},
