    "Sent to this bot's Mac to run this command. Hermex never saves it." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "An den Mac dieses Bots gesendet, um diesen Befehl auszuführen. Hermex speichert es nie." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Se envía al Mac de este bot para ejecutar este comando. Hermex nunca lo guarda." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Envoyé au Mac de ce bot pour exécuter cette commande. Hermex ne l’enregistre jamais." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Inviata al Mac di questo bot per eseguire questo comando. Hermex non la salva mai." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Wysłano na Maca tego bota, aby uruchomić to polecenie. Hermex nigdy tego nie zapisuje." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Enviada ao Mac deste bot para executar este comando. O Hermex nunca a salva." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Verstuurd naar de Mac van deze bot om deze opdracht uit te voeren. Hermex bewaart het nooit." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Bu komutu çalıştırmak için bu botun Mac’ine gönderildi. Hermex bunu asla kaydetmez." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Отправлено на Mac этого бота для выполнения этой команды. Hermex никогда это не сохраняет." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "このコマンドを実行するため、このボットのMacに送信されます。Hermexには保存されません。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "将发送到此机器人的 Mac 以运行此命令。Hermex 绝不会保存它。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "이 명령을 실행하기 위해 이 봇의 Mac으로 전송됩니다. Hermex는 이 값을 저장하지 않습니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "تُرسل إلى جهاز Mac الخاص بهذا الروبوت لتشغيل هذا الأمر. لا يحفظها Hermex أبدًا." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "נשלח ל‑Mac של הבוט הזה כדי להריץ את הפקודה. ‏Hermex לעולם אינו שומר אותו." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "یہ کمانڈ چلانے کے لیے اس بوٹ کے Mac کو بھیجا جاتا ہے۔ Hermex اسے کبھی محفوظ نہیں کرتا۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "會傳送至此機器人的 Mac 以執行此指令。Hermex 絕不會儲存它。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "會傳送至此機械人的 Mac 以執行此命令。Hermex 絕不會儲存它。" } } } },
