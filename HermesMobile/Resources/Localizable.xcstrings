    "Saving replaces this Profile’s complete instructions." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Beim Speichern werden die vollständigen Anweisungen dieses Profils ersetzt." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Al guardar, se reemplazan todas las instrucciones de este perfil." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "L’enregistrement remplace toutes les instructions de ce profil." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Il salvataggio sostituisce tutte le istruzioni di questo profilo." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Zapisanie zastąpi wszystkie instrukcje tego profilu." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Salvar substitui todas as instruções deste perfil." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Opslaan vervangt alle instructies van dit profiel." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Kaydetmek bu profilin tüm talimatlarını değiştirir." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "При сохранении все инструкции этого профиля будут заменены." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "保存すると、このプロファイルの指示全体が置き換えられます。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "保存会替换此个人资料的全部指令。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "저장하면 이 프로필의 전체 지침이 대체됩니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "يستبدل الحفظ تعليمات هذا الملف الشخصي بالكامل." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "השמירה מחליפה את כל ההוראות של הפרופיל הזה." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "محفوظ کرنے سے اس پروفائل کی مکمل ہدایات بدل جائیں گی۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "儲存會取代此個人檔案的完整指示。" } }, "zh-HK" : { "stringUnit" 