      "ko" : { "stringUnit" : { "state" : "translated", "value" : "보드를 검토했습니다" } },
      "ar" : { "stringUnit" : { "state" : "translated", "value" : "راجعت اللوحة" } },
      "he" : { "stringUnit" : { "state" : "translated", "value" : "בדקתי את הלוח" } },
      "ur" : { "stringUnit" : { "state" : "translated", "value" : "میں نے بورڈ کا جائزہ لے لیا ہے" } },
      "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "我已檢查看板" } },
      "zh-HK" : { "stringUnit" : { "state" : "translated", "value" : "我已檢查看板" } }
    } },
    "Preview Dispatch" : { "localizations" : {
      "de" : { "stringUnit" : { "state" : "translated", "value" : "Dispatch-Vorschau" } },
      "es" : { "stringUnit" : { "state" : "translated", "value" : "Vista previa del despacho" } },
      "fr" : { "stringUnit" : { "state" : "translated", "value" : "Aperçu de la répartition" } },
      "it" : { "stringUnit" : { "state" : "translated", "value" : "Anteprima dispatch" } },
      "pl" : { "stringUnit" : { "state" : "translated", "value" : "Podgląd dyspozycji" } },
      "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Prévia do despacho" } },
      "nl" : { "stringUnit" : { "state" : "translated", "value" : "Dispatch-voorbeeld" } },
      "tr" : { "stringUnit" : { "state" : "translated", "value" : "Dağıtım Önizlemesi" } },
      "ru" : { "stringUnit" : { "state" : "translated", "value" : "Предпросмотр диспетчеризации" } },
      "ja" : { "stringUnit" : { "state" : "translated", "value" : "ディスパッチをプレビュー" } },
      "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "预览调度" } },
      "ko" : { "stringUnit" : { "state" : "translated", "value" : "디스패치 미리보기" } },
      "ar" : { "stringUnit" : { "state" : "translated", "value" : "معاينة التوزيع" } },
      "he" : { "stringUnit" : { "state" : "translated", "value" : "תצוגה מקדימה של ההפצה" } },
      "ur" : { "stringUnit" : { "state" : "translated", "value" : "ڈسپیچ پیش منظر" } },
      "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "預覽調度" } },
      "zh-HK" : { "stringUnit" : { "state" : "translated", "value" : "預覽調度" } }
    } },
    "Preview is advisory and may become stale. It never starts workers." : { "localizations" : {
      "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Vorschau ist unverbindlich und kann veralten. Sie startet niemals Worker." } },
      "es" : { "stringUnit" : { "state" : "translated", "value" : "La vista previa es orientativa y puede quedar obsoleta. Nunca inicia trabajadores." } },
      "fr" : { "stringUnit" : { "state" : "translated", "value" : "L’aperçu est indicatif et peut devenir obsolète. Il ne démarre jamais de workers." } },
      "it" : { "stringUnit" : { "state" : "translated", "value" : "L’anteprima è indicativa e può diventare obsoleta. Non avvia mai worker." } },
      "pl" : { "stringUnit" : { "state" : "translated", "value" : "Podgląd ma charakter informacyjny i może się zdezaktualizować. Nigdy nie uruchamia procesów roboczych." } },
      "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A prévia é apenas informativa e pode ficar desatualizada. Ela nunca inicia workers." } },
      "nl" : { "stringUnit" : { "state" : "translated", "value" : "Het voorbeeld is adviserend en kan verouderd raken. Het start nooit workers." } },
      "tr" : { "stringUnit" : { "state" : "translated", "value" : "Önizleme yalnızca bilgi amaçlıdır ve eskiyebilir. Asla worker başlatmaz." } },
      "ru" : { "stringUnit" : { "state" : "translated", "value" : "Предпросмотр носит информационный характер и может устареть. Он никогда не запускает воркеры." } },
      "ja" : { "stringUnit" : { "state" : "translated", "value" : "プレビューは参考情報であり、古くなることがあります。ワーカーを起動することはありません。" } },
      "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "预览仅供参考，可能会过时。它绝不会启动工作进程。" } },
      "ko" : { "stringUnit" : { "state" : "translated", "value" : "미리보기는 참고용이며 오래된 정보가 될 수 있습니다. 워커를 시작하지 않습니다." } },
      "ar" : { "stringUnit" : { "state" : "translated", "value" : "المعاينة إرشادية وقد تصبح قديمة. وهي لا تبدأ أي عمليات عاملة." } },
      "he" : { "stringUnit" : { "state" : "translated", "value" : "התצוגה המקדימה היא להמלצה בלבד ועלולה להתיישן. היא לעולם אינה מפעילה תהליכי עבודה." } },
      "ur" : { "stringUnit" : { "state" : "translated", "value" : "پیش منظر صرف رہنمائی کے لیے ہے اور پرانا ہو سکتا ہے۔ یہ کبھی ورکرز شروع نہیں کرتا۔" } },
      "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "預覽僅供參考，可能會過時。它絕不會啟動工作程序。" } },
      "zh-HK" : { "stringUnit" : { "state" : "translated", "value" : "預覽僅供參考，可能會過時。它絕不會啟動工作程序。" } }
    } },
