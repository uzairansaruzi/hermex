    "Maximum Runtime must be a whole number of seconds greater than 0." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "يجب أن يكون الحد الأقصى لوقت التشغيل عددًا صحيحًا من الثواني أكبر من 0." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die maximale Laufzeit muss eine ganze Zahl von Sekunden größer als 0 sein." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "El tiempo de ejecución máximo debe ser un número entero de segundos mayor que 0." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "La durée d'exécution maximale doit être un nombre entier de secondes supérieur à 0." } },
        "he" : { "stringUnit" : { "state" : "translated", "value" : "זמן הריצה המרבי חייב להיות מספר שלם של שניות גדול מ-0." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Il tempo di esecuzione massimo deve essere un numero intero di secondi maggiore di 0." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "最大実行時間は、0 より大きい秒数の整数である必要があります。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "최대 런타임은 0보다 큰 정수(초)여야 합니다." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "De maximale looptijd moet een geheel aantal seconden groter dan 0 zijn." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Maksymalny czas działania musi być liczbą całkowitą sekund większą niż 0." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O tempo de execução máximo deve ser um número inteiro de segundos maior que 0." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Максимальное время выполнения должно быть на целое число секунд больше 0." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Maksimum Çalışma Süresi, 0'dan büyük bir tamsayı saniye olmalıdır." } },
        "ur" : { "stringUnit" : { "state" : "translated", "value" : "زیادہ سے زیادہ رن ٹائم 0 سے زیادہ سیکنڈز کی پوری تعداد کا ہونا چاہیے۔" } },
        "zh-HK" : { "stringUnit" : { "state" : "translated", "value" : "最大運轉時間必須是大於 0 的整數秒。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "最大运行时间必须是大于 0 的整数秒。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "最大運轉時間必須是大於 0 的整數秒。" } }
      }
    },
