    "The Board is refreshing." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Das Board wird aktualisiert." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "El tablero se está actualizando." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Le tableau est en cours d’actualisation." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "La bacheca è in fase di aggiornamento." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Tablica jest odświeżana." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "O quadro está sendo atualizado." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Het bord wordt vernieuwd." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Pano yenileniyor." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Доска обновляется." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "ボードを更新しています。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "看板正在刷新。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "보드를 새로 고치는 중입니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "جارٍ تحديث اللوحة." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "הלוח מתרענן." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "بورڈ ریفریش ہو رہا ہے۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "看板正在重新整理。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "看板正在重新整理。" } } } },
    "The selection is no longer available. Refresh the Board and select the Cards again." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Die Auswahl ist nicht mehr verfügbar. Aktualisiere das Board und wähle die Karten erneut aus." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "La selección ya no está disponible. Actualiza el tablero y vuelve a seleccionar las tarjetas." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "La sélection n’est plus disponible. Actualisez le tableau et sélectionnez à nouveau les cartes." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "La selezione non è più disponibile. Aggiorna la bacheca e seleziona di nuovo le schede." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Wybór nie jest już dostępny. Odśwież tablicę i ponownie wybierz karty." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "A seleção não está mais disponível. Atualize o quadro e selecione os cartões novamente." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "De selectie is niet meer beschikbaar. Vernieuw het bord en selecteer de kaarten opnieuw." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Seçim artık kullanılamıyor. Panoyu yenileyin ve Kartları tekrar seçin." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Выбранные карточки больше недоступны. Обновите доску и выберите карточки снова." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "選択項目は利用できなくなりました。ボードを更新して、カードをもう一度選択してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "所选内容已不可用。请刷新看板并重新选择卡片。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "선택 항목을 더 이상 사용할 수 없습니다. 보드를 새로 고친 후 카드를 다시 선택하세요." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "لم يعد التحديد متاحًا. حدّث اللوحة وحدد البطاقات مرة أخرى." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "הבחירה אינה זמינה עוד. יש לרענן את הלוח ולבחור שוב את הכרטיסים." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "انتخاب اب دستیاب نہیں ہے۔ بورڈ ریفریش کریں اور کارڈز دوبارہ منتخب کریں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "所選項目已無法使用。請重新整理看板並再次選取卡片。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "所選項目已無法使用。請重新整理看板並再次選取卡片。" } } } },
    "The selected Cards will be moved to the archive." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Die ausgewählten Karten werden ins Archiv verschoben." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Las tarjetas seleccionadas se moverán al archivo." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Les cartes sélectionnées seront placées dans les archives." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Le schede selezionate verranno spostate nell’archivio." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Wybrane karty zostaną przeniesione do archiwum." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Os cartões selecionados serão movidos para o arquivo." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "De geselecteerde kaarten worden naar het archief verplaatst." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Seçilen Kartlar arşive taşınacak." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Выбранные карточки будут перемещены в архив." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "選択したカードはアーカイブに移動されます。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "所选卡片将移至归档。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "선택한 카드가 보관함으로 이동됩니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "سيتم نقل البطاقات المحددة إلى الأرشيف." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "הכרטיסים שנבחרו יועברו לארכיון." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "منتخب کارڈز آرکائیو میں منتقل کر دیے جائیں گے۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "所選卡片將移至封存區。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "所選卡片將移至封存區。" } } } },
