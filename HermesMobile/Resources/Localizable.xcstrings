    "Couldn't read the recorded voice note. Try again." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Die aufgenommene Sprachnotiz konnte nicht gelesen werden. Versuche es erneut." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "No se pudo leer la nota de voz grabada. Inténtalo de nuevo." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Impossible de lire la note vocale enregistrée. Réessayez." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Impossibile leggere la nota vocale registrata. Riprova." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Nie można odczytać nagranej notatki głosowej. Spróbuj ponownie." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Não foi possível ler a nota de voz gravada. Tente novamente." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Kan de opgenomen spraaknotitie niet lezen. Probeer het opnieuw." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Kaydedilen sesli not okunamadı. Tekrar deneyin." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Не удалось прочитать записанное голосовое сообщение. Повторите попытку." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "録音した音声メモを読み込めませんでした。もう一度お試しください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "无法读取录制的语音消息。请重试。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "녹음한 음성 메모를 읽을 수 없습니다. 다시 시도하세요." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "تعذّرت قراءة الملاحظة الصوتية المسجلة. حاول مرة أخرى." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "לא ניתן לקרוא את ההודעה הקולית שהוקלטה. יש לנסות שוב." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "ریکارڈ شدہ صوتی نوٹ پڑھا نہیں جا سکا۔ دوبارہ کوشش کریں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "無法讀取錄製的語音訊息。請再試一次。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "無法讀取錄製的語音訊息。請再試一次。" } } } },
    "Couldn't start recording. Try again." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Aufnahme konnte nicht gestartet werden. Versuche es erneut." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "No se pudo iniciar la grabación. Inténtalo de nuevo." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Impossible de démarrer l’enregistrement. Réessayez." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Impossibile avviare la registrazione. Riprova." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Nie można rozpocząć nagrywania. Spróbuj ponownie." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Não foi possível iniciar a gravação. Tente novamente." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Kan opname niet starten. Probeer het opnieuw." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Kayıt başlatılamadı. Tekrar deneyin." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Не удалось начать запись. Повторите попытку." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "録音を開始できませんでした。もう一度お試しください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "无法开始录音。请重试。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "녹음을 시작할 수 없습니다. 다시 시도하세요." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "تعذّر بدء التسجيل. حاول مرة أخرى." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "לא ניתן להתחיל הקלטה. יש לנסות שוב." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "ریکارڈنگ شروع نہیں ہو سکی۔ دوبارہ کوشش کریں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "無法開始錄音。請再試一次。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "無法開始錄音。請再試一次。" } } } },
    "Couldn't transcribe that voice note. Try recording again." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Diese Sprachnotiz konnte nicht transkribiert werden. Nimm sie erneut auf." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "No se pudo transcribir esa nota de voz. Vuelve a grabarla." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Impossible de transcrire cette note vocale. Réessayez l’enregistrement." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Impossibile trascrivere la nota vocale. Prova a registrare di nuovo." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Nie można przetranskrybować tej notatki głosowej. Nagraj ją ponownie." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Não foi possível transcrever essa nota de voz. Tente gravar novamente." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Kan die spraaknotitie niet transcriberen. Neem opnieuw op." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Bu sesli not metne dönüştürülemedi. Yeniden kaydetmeyi deneyin." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Не удалось расшифровать это голосовое сообщение. Запишите его снова." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "その音声メモを文字起こしできませんでした。もう一度録音してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "无法转写该语音消息。请重新录制。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "해당 음성 메모를 텍스트로 변환할 수 없습니다. 다시 녹음하세요." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "تعذّر تحويل هذه الملاحظة الصوتية إلى نص. حاول التسجيل مرة أخرى." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "לא ניתן לתמלל את ההודעה הקולית הזו. יש לנסות להקליט שוב." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "اس صوتی نوٹ کی ٹرانسکرپشن نہیں ہو سکی۔ دوبارہ ریکارڈ کرنے کی کوشش کریں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "無法轉寫該語音訊息。請重新錄製。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "無法轉寫該語音訊息。請重新錄製。" } } } },
    "Couldn’t add media" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Medien konnten nicht hinzugefügt werden" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "No se pudo añadir el contenido multimedia" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Impossible d’ajouter le média" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Impossibile aggiungere i media" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Nie można dodać multimediów" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Não foi possível adicionar mídia" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Kan media niet toevoegen" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Medya eklenemedi" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Не удалось добавить медиа" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "メディアを追加できませんでした" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "无法添加媒体" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "미디어를 추가할 수 없음" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "تعذّرت إضافة الوسائط" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "לא ניתן להוסיף מדיה" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "میڈیا شامل نہیں ہو سکا" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "無法加入媒體" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "無法加入媒體" } } } },
    "Creating…" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Wird erstellt…" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Creando…" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Création…" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Creazione…" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Tworzenie…" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Criando…" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Aanmaken…" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Oluşturuluyor…" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Создание…" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "作成中…" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "正在创建…" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "생성 중…" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "جارٍ الإنشاء…" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "יוצר…" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "بنایا جا رہا ہے…" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "正在建立…" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "正在建立…" } } } },
    "Deny" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Ablehnen" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Denegar" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Refuser" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Nega" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Odmów" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Negar" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Weigeren" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Reddet" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Отклонить" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "拒否" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "拒绝" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "거부" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "رفض" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "דחייה" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "مسترد کریں" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "拒絕" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "拒絕" } } } },
    "Desktop and Hermex must use the same password-protected backend. Remote gateway connects Desktop to a backend; it does not expose Desktop’s private local backend to your phone." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Desktop und Hermex müssen dasselbe passwortgeschützte Backend verwenden. Das Remote-Gateway verbindet Desktop mit einem Backend; es macht das private lokale Backend von Desktop nicht für dein Telefon zugänglich." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Desktop y Hermex deben usar el mismo backend protegido con contraseña. La pasarela remota conecta Desktop a un backend; no expone el backend local privado de Desktop a tu teléfono." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Desktop et Hermex doivent utiliser le même backend protégé par mot de passe. La passerelle distante connecte Desktop à un backend ; elle n’expose pas le backend local privé de Desktop à votre téléphone." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Desktop e Hermex devono usare lo stesso backend protetto da password. Remote gateway collega Desktop a un backend; non espone al telefono il backend locale privato di Desktop." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Desktop i Hermex muszą używać tego samego backendu chronionego hasłem. „Remote gateway” łączy Desktop z backendem; nie udostępnia prywatnego lokalnego backendu Desktop Twojemu telefonowi." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "O Desktop e o Hermex precisam usar o mesmo backend protegido por senha. O Remote gateway conecta o Desktop a um backend; ele não expõe o backend local privado do Desktop ao seu telefone." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Desktop en Hermex moeten dezelfde met een wachtwoord beveiligde backend gebruiken. Remote gateway verbindt Desktop met een backend; het maakt de privé lokale backend van Desktop niet toegankelijk voor je telefoon." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Desktop ve Hermex aynı parola korumalı arka ucu kullanmalıdır. “Remote gateway”, Desktop’u bir arka uca bağlar; Desktop’un özel yerel arka ucunu telefonunuza açmaz." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Desktop и Hermex должны использовать один и тот же защищённый паролем бэкенд. «Remote gateway» подключает Desktop к бэкенду; он не открывает вашему телефону доступ к частному локальному бэкенду Desktop." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "DesktopとHermexは、パスワードで保護された同じバックエンドを使用する必要があります。リモートゲートウェイはDesktopをバックエンドに接続するもので、Desktopのプライベートなローカルバックエンドを電話に公開するものではありません。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "Desktop 和 Hermex 必须使用同一个受密码保护的后端。远程网关会将 Desktop 连接到后端，但不会向你的手机公开 Desktop 的私有本地后端。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "Desktop과 Hermex는 비밀번호로 보호된 동일한 백엔드를 사용해야 합니다. 원격 게이트웨이는 Desktop을 백엔드에 연결할 뿐이며, Desktop의 비공개 로컬 백엔드를 휴대폰에 노출하지 않습니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "يجب أن يستخدم Desktop وHermex الخلفية نفسها المحمية بكلمة مرور. تربط البوابة البعيدة Desktop بخلفية؛ ولا تكشف الخلفية المحلية الخاصة بـ Desktop لهاتفك." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "‏Desktop ו‑Hermex חייבים להשתמש באותו שרת מוגן בסיסמה. שער מרוחק מחבר את Desktop לשרת; הוא אינו חושף לטלפון שלך את השרת המקומי הפרטי של Desktop." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "Desktop اور Hermex کو ایک ہی پاس ورڈ سے محفوظ بیک اینڈ استعمال کرنا ہوگا۔ ریموٹ گیٹ وے Desktop کو کسی بیک اینڈ سے جوڑتا ہے؛ یہ Desktop کا نجی مقامی بیک اینڈ آپ کے فون کے لیے نہیں کھولتا۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "Desktop 和 Hermex 必須使用同一個受密碼保護的後端。遠端閘道會將 Desktop 連接到後端，但不會向你的手機公開 Desktop 的私有本機後端。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "Desktop 和 Hermex 必須使用同一個受密碼保護的後端。遠端閘道會將 Desktop 連接到後端，但不會向你的手機公開 Desktop 的私有本機後端。" } } } },
    "Dictation Provider" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Diktieranbieter" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Proveedor de dictado" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Service de dictée" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Provider di dettatura" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Dostawca dyktowania" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Provedor de ditado" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Dicteerprovider" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Dikte Sağlayıcısı" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Провайдер диктовки" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "音声入力のプロバイダ" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "听写提供方" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "받아쓰기 제공업체" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "مزوّد الإملاء" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "ספק הכתבה" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "ڈکٹیشن فراہم کنندہ" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "聽寫提供者" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "聽寫提供者" } } } },
    "Diff was large; message may be partial." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Der Diff war groß; die Nachricht ist möglicherweise unvollständig." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "El diff era grande; puede que el mensaje esté incompleto." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Le diff était volumineux ; le message peut être incomplet." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Il diff era grande; il messaggio potrebbe essere parziale." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Różnice były duże; komunikat może być niepełny." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "O diff era grande; a mensagem pode estar incompleta." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Diff was groot; bericht is mogelijk onvolledig." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Fark büyüktü; mesaj eksik olabilir." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Изменения были большими; сообщение может быть неполным." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "diffが大きいため、メッセージは一部のみの可能性があります。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "差异较大；提交信息可能不完整。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "diff가 커서 메시지가 일부만 생성되었을 수 있습니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "كان الفرق كبيرًا؛ قد تكون الرسالة جزئية." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "ה‑diff היה גדול; ייתכן שההודעה חלקית." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "diff بڑا تھا؛ پیغام نامکمل ہو سکتا ہے۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "差異較大；提交訊息可能不完整。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "差異較大；提交訊息可能不完整。" } } } },
    "Disable" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Deaktivieren" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Desactivar" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Désactiver" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Disattiva" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Wyłącz" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Desativar" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Uitschakelen" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Devre Dışı Bırak" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Выключить" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "無効にする" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "停用" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "비활성화" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "تعطيل" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "השבתה" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "غیر فعال کریں" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "停用" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "停用" } } } },
