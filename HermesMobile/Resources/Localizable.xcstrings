    "Skipped—No Assignee" : { "localizations" : {
      "de" : { "stringUnit" : { "state" : "translated", "value" : "Übersprungen—nicht zugewiesen" } },
      "es" : { "stringUnit" : { "state" : "translated", "value" : "Omitidos—sin asignar" } },
      "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ignorés—sans assignation" } },
      "it" : { "stringUnit" : { "state" : "translated", "value" : "Saltati—non assegnati" } },
      "pl" : { "stringUnit" : { "state" : "translated", "value" : "Pominięto—brak przypisania" } },
      "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Ignorados—sem responsável" } },
      "nl" : { "stringUnit" : { "state" : "translated", "value" : "Overgeslagen—niet toegewezen" } },
      "tr" : { "stringUnit" : { "state" : "translated", "value" : "Atlandı—atanan yok" } },
