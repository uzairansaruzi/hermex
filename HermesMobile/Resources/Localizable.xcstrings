    "Committed — push failed" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Committet — Push fehlgeschlagen" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Confirmado — falló el push" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Commit effectué — échec du push" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Commit eseguito — push non riuscito" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Zatwierdzono — wypchnięcie nie powiodło się" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Commit feito — falha no push" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Gecommit — push mislukt" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Commit edildi — push başarısız" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Коммит создан — отправка не удалась" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "コミット済み — プッシュに失敗" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "已提交 — 推送失败" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "커밋됨 — 푸시 실패" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "تم الالتزام — فشل الدفع" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "ההתחייבות בוצעה — הדחיפה נכשלה" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "کمٹ ہو گیا — پش ناکام" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "已提交 — 推送失敗" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "已提交 — 推送失敗" } } } },
    "Committed, but the push failed." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Committet, aber der Push ist fehlgeschlagen." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Confirmado, pero falló el push." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Commit effectué, mais le push a échoué." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Commit eseguito, ma il push non è riuscito." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Zatwierdzono, ale wypchnięcie nie powiodło się." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Commit feito, mas o push falhou." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Gecommit, maar de push is mislukt." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Commit edildi ancak push başarısız oldu." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Коммит создан, но отправка не удалась." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "コミットしましたが、プッシュに失敗しました。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "已提交，但推送失败。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "커밋했지만 푸시에 실패했습니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "تم الالتزام، لكن فشل الدفع." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "ההתחייבות בוצעה, אך הדחיפה נכשלה." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "کمٹ ہو گیا، لیکن پش ناکام رہا۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "已提交，但推送失敗。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "已提交，但推送失敗。" } } } },
    "Committing..." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Wird committet..." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Confirmando..." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Validation..." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Commit in corso..." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Zatwierdzanie..." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Fazendo commit..." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Committen..." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Commit ediliyor..." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Создание коммита..." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "コミット中..." } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "正在提交..." } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "커밋 중..." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "جارٍ الالتزام..." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "מבצע התחייבות..." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "کمٹ ہو رہا ہے..." } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "正在提交..." } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "正在提交..." } } } },
    "Connecting…" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Wird verbunden…" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Conectando…" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Connexion…" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Connessione…" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Łączenie…" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Conectando…" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Verbinden…" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Bağlanıyor…" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Подключение…" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "接続中…" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "正在连接…" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "연결 중…" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "جارٍ الاتصال…" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "מתחבר…" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "منسلک ہو رہا ہے…" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "正在連線…" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "正在連線…" } } } },
    "Connection lost. The bot may still be working. Reconnect to check its current conversation." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Verbindung unterbrochen. Der Bot arbeitet möglicherweise noch. Verbinde dich neu, um seine aktuelle Unterhaltung zu prüfen." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Se perdió la conexión. Puede que el bot siga trabajando. Vuelve a conectarte para comprobar su conversación actual." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Connexion perdue. Le bot est peut-être encore au travail. Reconnectez-vous pour vérifier sa conversation en cours." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Connessione persa. Il bot potrebbe essere ancora al lavoro. Riconnettiti per controllare la sua conversazione attuale." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Utracono połączenie. Bot może nadal pracować. Połącz się ponownie, aby sprawdzić jego bieżącą rozmowę." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Conexão perdida. O bot pode ainda estar trabalhando. Reconecte-se para verificar a conversa atual dele." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Verbinding verbroken. De bot is mogelijk nog bezig. Maak opnieuw verbinding om het huidige gesprek te controleren." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Bağlantı kesildi. Bot hâlâ çalışıyor olabilir. Geçerli konuşmasını kontrol etmek için yeniden bağlanın." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Соединение потеряно. Бот может ещё работать. Переподключитесь, чтобы проверить его текущий разговор." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "接続が切れました。ボットはまだ作業中の可能性があります。再接続して現在の会話を確認してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "连接已断开。机器人可能仍在工作。请重新连接以查看其当前对话。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "연결이 끊겼습니다. 봇이 아직 작업 중일 수 있습니다. 다시 연결하여 현재 대화를 확인하세요." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "انقطع الاتصال. قد يكون الروبوت لا يزال يعمل. أعد الاتصال للتحقق من محادثته الحالية." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "החיבור אבד. ייתכן שהבוט עדיין עובד. יש להתחבר מחדש כדי לבדוק את השיחה הנוכחית שלו." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "کنکشن ٹوٹ گیا۔ ممکن ہے بوٹ اب بھی کام کر رہا ہو۔ اس کی موجودہ گفتگو دیکھنے کے لیے دوبارہ جڑیں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "連線已中斷。機器人可能仍在工作。請重新連線以查看其目前的對話。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "連線已中斷。機械人可能仍在工作。請重新連線以查看其當前對話。" } } } },
    "Context usage loading" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Kontextnutzung wird geladen" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Cargando el uso del contexto" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Chargement de l’utilisation du contexte" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Caricamento utilizzo del contesto" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Ładowanie użycia kontekstu" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Carregando uso de contexto" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Contextgebruik laden" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Bağlam kullanımı yükleniyor" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Загрузка использования контекста" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "コンテキスト使用量を読み込み中" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "正在加载上下文用量" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "컨텍스트 사용량 불러오는 중" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "جارٍ تحميل استخدام السياق" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "נתוני השימוש בהקשר נטענים" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "سیاق کا استعمال لوڈ ہو رہا ہے" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "正在載入上下文用量" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "正在載入上下文用量" } } } },
