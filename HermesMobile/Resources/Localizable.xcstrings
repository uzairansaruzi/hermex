    "Saved on this bot's Mac as %@. Hermex never saves it." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Auf dem Mac dieses Bots als %@ gespeichert. Hermex speichert es nie." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Se guarda en el Mac de este bot como %@. Hermex nunca lo guarda." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Enregistré sur le Mac de ce bot sous %@. Hermex ne l’enregistre jamais." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Salvato sul Mac di questo bot come %@. Hermex non lo salva mai." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Zapisano na Macu tego bota jako %@. Hermex nigdy tego nie zapisuje." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Salvo no Mac deste bot como %@. O Hermex nunca o salva." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Bewaard op de Mac van deze bot als %@. Hermex bewaart het nooit." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Bu botun Mac’inde %@ olarak kaydedildi. Hermex bunu asla kaydetmez." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Сохранено на Mac этого бота как %@. Hermex никогда это не сохраняет." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "このボットのMacに%@として保存されます。Hermexには保存されません。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "已以 %@ 保存在此机器人的 Mac 上。Hermex 绝不会保存它。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "이 봇의 Mac에 %@(으)로 저장됩니다. Hermex는 이 값을 저장하지 않습니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "محفوظ على جهاز Mac الخاص بهذا الروبوت باسم %@. لا يحفظه Hermex أبدًا." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "נשמר ב‑Mac של הבוט הזה בשם %@. ‏Hermex לעולם אינו שומר אותו." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "اس بوٹ کے Mac پر %@ کے طور پر