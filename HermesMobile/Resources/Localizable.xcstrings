    "Steer was unavailable, so the message was queued and the current response was stopped." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "التوجيه غير متاح، لذا وُضعت الرسالة في قائمة الانتظار وأُوقف الرد الحالي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Steuern war nicht verfügbar, daher wurde die Nachricht in die Warteschlange gestellt und die aktuelle Antwort gestoppt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La dirección no estaba disponible, por lo que el mensaje se puso en cola y la respuesta actual se detuvo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L'orientation était indisponible ; le message a été mis en attente et la réponse actuelle a été arrêtée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הכוונה לא הייתה זמינה, ולכן ההודעה הוכנסה לתור והתגובה הנוכחית נעצרה."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La guida non era disponibile, il messaggio è stato messo in coda e la risposta corrente è stata interrotta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "誘導を利用できなかったため、メッセージはキューに入れられ、現在の応答は停止されました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "유도를 사용할 수 없어 메시지가 대기열에 추가되고 현재 응답이 중지되었어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bijsturen was niet beschikbaar, dus het bericht is in de wachtrij geplaatst en het huidige antwoord is gestopt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sterowanie było niedostępne, więc wiadomość została dodana do kolejki, a bieżąca odpowiedź została zatrzymana."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O direcionamento estava indisponível, então a mensagem foi colocada na fila e a resposta atual foi parada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Направление было недоступно, поэтому сообщение поставлено в очередь, а текущий ответ остановлен."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yönlendirme kullanılamadı, bu yüzden mesaj kuyruğa alındı ve mevcut yanıt durduruldu."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "رہنمائی دستیاب نہیں تھی، اس لیے پیغام قطار میں ڈال دیا گیا اور موجودہ جواب بند کر دیا گیا۔"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "引導功能無法使用，因此訊息已排隊，目前的回應已停止。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "引导功能不可用，因此消息已排队，当前响应已停止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "引導功能無法使用，因此訊息已排隊，目前的回應已停止。"
          }
        }
      }
    },
