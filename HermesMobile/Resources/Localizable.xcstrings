    "Leaving the model on Server default lets the server use the selected profile's model." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "إذا تركت النموذج على الإعداد الافتراضي للخادم، فسيستخدم الخادم نموذج ملف التعريف المحدد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wenn das Modell auf „Serverstandard“ bleibt, verwendet der Server das Modell des ausgewählten Profils."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si dejas el modelo en el valor por omisión del servidor, el servidor usa el modelo del perfil seleccionado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
