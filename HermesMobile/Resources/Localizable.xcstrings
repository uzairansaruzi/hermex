        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קובץ מקומי בסביבת העבודה עוקף את הקשר הפרויקט הגלובלי."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
