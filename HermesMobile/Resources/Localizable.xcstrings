    "Check that the Hermes server is awake, then try again." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Prüfe, ob der Hermes-Server aktiv ist, und versuche es dann erneut." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Comprueba que el servidor de Hermes esté activo e inténtalo de nuevo." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Vérifiez que le serveur Hermes est actif, puis réessayez." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Verifica che il server Hermes sia attivo, poi riprova." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Sprawdź, czy serwer Hermes działa, i spróbuj ponownie." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Verifique se o servidor Hermes está ativo e tente novamente." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Controleer of de Hermes-server actief is en probeer het opnieuw." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes sunucusunun çalıştığını kontrol edin ve tekrar deneyin." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Убедитесь, что сервер Hermes работает, и повторите попытку." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermesサーバーが起動していることを確認してから、もう一度お試しください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "请确认 Hermes 服务器处于唤醒状态，然后重试。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "Hermes 서버가 깨어 있는지 확인한 후 다시 시도하세요." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "تأكد من أن خادم Hermes يعمل، ثم حاول مرة أخرى." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "יש לוודא ששרת Hermes פעיל ולנסות שוב." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "یقینی بنائیں کہ Hermes سرور چل رہا ہے، پھر دوبارہ کوشش کریں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "請確認 Hermes 伺服器處於喚醒狀態，然後再試一次。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "請確認 Hermes 伺服器處於喚醒狀態，然後再試一次。" } } } },
    "Check your connection, then try again." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Prüfe deine Verbindung und versuche es dann erneut." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Comprueba tu conexión e inténtalo de nuevo." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Vérifiez votre connexion, puis réessayez." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Controlla la connessione, poi riprova." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Sprawdź połączenie i spróbuj ponownie." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Verifique sua conexão e tente novamente." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Controleer je verbinding en probeer het opnieuw." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Bağlantınızı kontrol edin ve tekrar deneyin." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Проверьте подключение и повторите попытку." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "接続を確認してから、もう一度お試しください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "请检查网络连接，然后重试。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "연결을 확인한 후 다시 시도하세요." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "تحقق من اتصالك، ثم حاول مرة أخرى." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "יש לבדוק את החיבור ולנסות שוב." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "اپنا کنکشن چیک کریں، پھر دوبارہ کوشش کریں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "請檢查網路連線，然後再試一次。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "請檢查網絡連線，然後再試一次。" } } } },
    "Checking for updates…" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Suche nach Updates…" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Buscando actualizaciones…" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Recherche de mises à jour…" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Verifica aggiornamenti…" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Sprawdzanie aktualizacji…" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Verificando atualizações…" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Zoeken naar updates…" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Güncellemeler denetleniyor…" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Проверка обновлений…" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "アップデートを確認中…" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "正在检查更新…" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "업데이트 확인 중…" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "جارٍ التحقق من وجود تحديثات…" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "בודק עדכונים…" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "اپ ڈیٹس چیک ہو رہی ہیں…" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "正在檢查更新…" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "正在檢查更新…" } } } },
    "Choose a session from the sidebar or start a new chat." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Wähle eine Sitzung in der Seitenleiste oder starte einen neuen Chat." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Elige una sesión en la barra lateral o inicia un chat nuevo." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Choisissez une session dans la barre latérale ou démarrez une nouvelle discussion." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Scegli una sessione dalla barra laterale o avvia una nuova chat." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Wybierz sesję z paska bocznego lub rozpocznij nowy czat." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Escolha uma sessão na barra lateral ou inicie um novo chat." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Kies een sessie in de zijbalk of start een nieuwe chat." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Kenar çubuğundan bir oturum seçin veya yeni bir sohbet başlatın." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Выберите сессию на боковой панели или начните новый чат." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "サイドバーからセッションを選択するか、新規チャットを開始してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "从边栏中选择一个会话，或开始新聊天。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "사이드바에서 세션을 선택하거나 새 채팅을 시작하세요." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "اختر جلسة من الشريط الجانبي أو ابدأ دردشة جديدة." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "יש לבחור מפגש מסרגל הצד או להתחיל צ׳אט חדש." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "سائیڈ بار سے کوئی سیشن منتخب کریں یا نئی چیٹ شروع کریں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "從側邊欄選擇一個工作階段，或開始新聊天。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "從側邊欄選擇一個工作階段，或開始新聊天。" } } } },
    "Choose another Status or refresh the Board." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Wähle einen anderen Status oder aktualisiere das Board." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Elige otro estado o actualiza el tablero." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Choisissez un autre statut ou actualisez le tableau." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Scegli un altro stato o aggiorna la bacheca." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Wybierz inny status lub odśwież tablicę." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Escolha outro status ou atualize o quadro." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Kies een andere status of vernieuw het bord." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Başka bir Durum seçin veya Panoyu yenileyin." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Выберите другой статус или обновите доску." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "別のステータスを選択するか、ボードを更新してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "选择其他状态或刷新看板。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "다른 상태를 선택하거나 보드를 새로 고치세요." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "اختر حالة أخرى أو حدّث اللوحة." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "יש לבחור סטטוס אחר או לרענן את הלוח." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "کوئی اور حیثیت منتخب کریں یا بورڈ ریفریش کریں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "選擇其他狀態或重新整理看板。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "選擇其他狀態或重新整理看板。" } } } },
    "Choose two to six bots." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Wähle zwei bis sechs Bots." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Elige de dos a seis bots." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Choisissez de deux à six bots." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Scegli da due a sei bot." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Wybierz od dwóch do sześciu botów." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Escolha de dois a seis bots." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Kies twee tot zes bots." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "İki ila altı bot seçin." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Выберите от двух до шести ботов." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "ボットを2〜6体選択してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "选择 2 到 6 个机器人。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "봇을 2~6개 선택하세요." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "اختر من روبوتين إلى ستة روبوتات." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "יש לבחור בין שניים לשישה בוטים." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "دو سے چھ بوٹس منتخب کریں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "選擇 2 至 6 個機器人。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "選擇 2 至 6 個機械人。" } } } },
    "Clear Conversation?" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Unterhaltung leeren?" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "¿Borrar la conversación?" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Effacer la conversation ?" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Cancellare la conversazione?" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Wyczyścić rozmowę?" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Limpar conversa?" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Gesprek wissen?" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Konuşma Temizlensin mi?" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Очистить разговор?" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "会話を消去しますか？" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "清除对话？" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "대화를 지울까요?" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "مسح المحادثة؟" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "לנקות את השיחה?" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "گفتگو صاف کریں؟" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "清除對話？" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "清除對話？" } } } },
    "Clear this conversation on the server" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Diese Unterhaltung auf dem Server leeren" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Borrar esta conversación en el servidor" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Effacer cette conversation sur le serveur" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Cancella questa conversazione sul server" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Wyczyść tę rozmowę na serwerze" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Limpar esta conversa no servidor" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Wis dit gesprek op de server" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Bu konuşmayı sunucuda temizle" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Очистить этот разговор на сервере" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "サーバー上のこの会話を消去" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "清除服务器上的此对话" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "서버에서 이 대화 지우기" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "مسح هذه المحادثة على الخادم" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "ניקוי השיחה הזו בשרת" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "سرور پر یہ گفتگو صاف کریں" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "清除伺服器上的此對話" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "清除伺服器上的此對話" } } } },
    "Cleared on the server, but the offline copy of this conversation could not be updated." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Auf dem Server geleert, aber die Offline-Kopie dieser Unterhaltung konnte nicht aktualisiert werden." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Se borró en el servidor, pero no se pudo actualizar la copia sin conexión de esta conversación." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Effacée sur le serveur, mais la copie hors ligne de cette conversation n’a pas pu être mise à jour." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Cancellata sul server, ma non è stato possibile aggiornare la copia offline di questa conversazione." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Wyczyszczono na serwerze, ale nie udało się zaktualizować kopii offline tej rozmowy." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "A conversa foi limpa no servidor, mas não foi possível atualizar a cópia offline dela." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Gewist op de server, maar de offline kopie van dit gesprek kon niet worden bijgewerkt." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Sunucuda temizlendi ancak bu konuşmanın çevrimdışı kopyası güncellenemedi." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Очищено на сервере, но не удалось обновить офлайн-копию этого разговора." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "サーバー上では消去されましたが、この会話のオフラインコピーを更新できませんでした。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "已在服务器上清除，但无法更新此对话的离线副本。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "서버에서는 지워졌지만 이 대화의 오프라인 사본을 업데이트할 수 없습니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "تم المسح على الخادم، لكن تعذّر تحديث النسخة غير المتصلة من هذه المحادثة." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "השיחה נוקתה בשרת, אך לא ניתן היה לעדכן את העותק הלא מקוון שלה." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "سرور پر صاف ہو گئی، لیکن اس گفتگو کی آف لائن کاپی اپ ڈیٹ نہیں ہو سکی۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "已在伺服器上清除，但無法更新此對話的離線副本。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "已在伺服器上清除，但無法更新此對話的離線副本。" } } } },
