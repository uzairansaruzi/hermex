    "Showing the first 100 matches. Refine your search to find more." : {"localizations":{"de":{"stringUnit":{"state":"needs_review","value":"Die ersten 100 Treffer werden angezeigt. Grenze die Suche ein, um weitere zu finden."}},"es":{"stringUnit":{"state":"needs_review","value":"Se muestran las primeras 100 coincidencias. Afina la búsqueda para encontrar más."}},"fr":{"stringUnit":{"state":"needs_review","value":"Les 100 premiers résultats sont affichés. Affinez la recherche pour en trouver davantage."}},"it":{"stringUnit":{"state":"needs_review","value":"Sono mostrate le prime 100 corrispondenze. Affina la ricerca per trovarne altre."}},"pl":{"stringUnit":{"state":"needs_review","value":"Wyświetlono pierwsze 100 wyników. Zawęź wyszukiwanie, aby znaleźć więcej."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Exibindo os primeiros 100 resultados. Refine a busca para encontrar mais."}},"nl":{"stringUnit":{"state":"needs_review","value":"De eerste 100 resultaten worden getoond. Verfijn je zoekopdracht om meer te vinden."}},"tr":{"stringUnit":{"state":"needs_review","value":"İlk 100 eşleşme gösteriliyor. Daha fazlasını bulmak için aramanızı daraltın."}},"ru":{"stringUnit":{"state":"needs_review","value":"Показаны первые 100 результатов. Уточните запрос, чтобы найти больше."}},"ja":{"stringUnit":{"state":"needs_review","value":"最初の100件を表示しています。検索条件を絞り込むと、さらに見つけられます。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"显示前 100 条匹配结果。请缩小搜索范围以查找更多结果。"}},"ko":{"stringUnit":{"state":"needs_review","value":"처음 100개의 결과를 표시합니다. 검색 범위를 좁히면 더 많은 결과를 찾을 수 있습니다."}},"ar":{"stringUnit":{"state":"needs_review","value":"يتم عرض أول 100 نتيجة. حدّد بحثك للعثور على المزيد."}},"he":{"stringUnit":{"state":"needs_review","value":"מוצגות 100 ההתאמות הראשונות. יש למקד את החיפוש כדי למצוא עוד."}},"ur":{"stringUnit":{"state":"needs_review","value":"پہلے 100 نتائج دکھائے جا رہے ہیں۔ مزید تلاش کرنے کے لیے اپنی تلاش محدود کریں۔"}},"zh-Hant":{"stringUnit":{"state":"needs_review",