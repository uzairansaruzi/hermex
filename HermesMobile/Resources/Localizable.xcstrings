    "One of the selected photos is too large to attach." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Eines der ausgewählten Fotos ist zu groß zum Anhängen." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Una de las fotos seleccionadas es demasiado grande para adjuntarla." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "L’une des photos sélectionnées est trop volumineuse pour être jointe." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Una delle foto selezionate è troppo grande per essere allegata." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Jedno z wybranych zdjęć jest za duże, aby je załączyć." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Uma das fotos selecionadas é grande demais para anexar." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Een van de geselecteerde foto's is te groot om bij te voegen." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Seçilen fotoğraflardan biri eklenemeyecek kadar büyük." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Одно из выбранных фото слишком большое для вложения." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "選択した写真の1枚が大きすぎて添付できません。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "所选照片中有一张太大，无法附加。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "선택한 사진 중 하나가 너무 커서 첨부할 수 없습니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "إحدى الصور المحددة كبيرة جدًا لإرفاقها." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "אחת התמונות שנבחרו גדולה מכדי לצרף אותה." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "منتخب تصاویر میں سے ایک منسلک کرنے کے لیے بہت بڑی ہے۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "所選照片中有一張太大，無法附加。" } }, "zh-HK" : { "stringUnit" : { "state" : "