    "Reconnect to the server to clear the conversation." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Verbinde dich erneut mit dem Server, um die Unterhaltung zu leeren." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Vuelve a conectarte al servidor para borrar la conversación." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Reconnectez-vous au serveur pour effacer la conversation." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Riconnettiti al server per cancellare la conversazione." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Połącz się ponownie z serwerem, aby wyczyścić rozmowę." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Reconecte-se ao servidor para limpar a conversa." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Maak opnieuw verbinding met de server om het gesprek te wissen." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Konuşmayı temizlemek için sunucuya yeniden bağlanın." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Переподключитесь к серверу, чтобы очистить разговор." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "会話を消去するには、サーバーに再接続してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "重新连接服务器以清除对话。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "대화를 지우려면 서버에 다시 연결하세요." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "أعد الاتصال بالخادم لمسح المحادثة." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "יש להתחבר מחדש לשרת כדי לנקות את השיחה." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "گفتگو صاف کرنے کے لیے سرور سے دوبارہ منسلک ہوں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "重新連線至伺服器以清除對話。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "重新連線伺服器以清除對話。" } }