    "Interrupted the current response and queued your message to send next." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تمّت مقاطعة الردّ الحالي وأُدرجت رسالتك في قائمة الانتظار لإرسالها تاليًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die aktuelle Antwort wurde unterbrochen und deine Nachricht wird als Nächstes gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se interrumpió la respuesta actual y se puso en cola tu mensaje para enviarlo a continuación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La réponse en cours a été interrompue et votre message est en file d'attente."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "התשובה הנוכחית הופסקה וההודעה שלך נוספה לתור לשליחה הבאה."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Risposta corrente interrotta e messaggio accodato per il prossimo invio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "現在の応答を中断し、メッセージを次に送信するためキューに追加しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "현재 응답을 중단하고 메시지를 다음에 보내도록 대기열에 추가했어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Het huidige antwoord is onderbroken en uw bericht is in de wachtrij gezet om als volgende te verzenden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przerwano bieżącą odpowiedź i dodano wiadomość do kolejki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A resposta atual foi interrompida e sua mensagem foi colocada na fila para ser enviada em seguida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
