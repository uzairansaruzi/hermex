    "Hermex refreshed the Board, but cannot prove whether workers started. Review the current Board before running Dispatcher again." : { "localizations" : {
      "de" : { "stringUnit" : { "state" : "translated", "value" : "Hermex hat das Board aktualisiert, kann aber nicht bestätigen, ob Worker gestartet wurden. Prüfe das aktuelle Board, bevor du den Dispatcher erneut ausführst." } },
      "es" : { "stringUnit" : { "state" : "translated", "value" : "Hermex actualizó el tablero, pero no puede confirmar si se iniciaron trabajadores. Revisa el tablero actual antes de volver a ejecutar el despachador." } },
      "fr" : { "stringUnit" : { "state" : "translated", "value" : "Hermex a actualisé le tableau, mais ne peut pas confirmer si des workers ont démarré. Vérifiez le tableau actuel avant de relancer le répartiteur." } },
      "it" : { "stringUnit" : { "state" : "translated", "value" : "Hermex ha aggiornato la bacheca, ma non può confermare se siano stati avviati worker. Controlla la bacheca attuale prima di eseguire di nuovo il dispatcher." } },
      "pl" : { "stringUnit" : { "state" : "translated", "value" : "Hermex odświeżył tablicę, ale nie może potwierdzić, czy uruchomiono procesy robocze. Sprawdź bieżącą tablicę przed ponownym uruchomieniem dyspozytora." } },
      "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O Hermex atualizou o quadro, mas não pode confirmar se os workers foram iniciados. Revise o quadro atual antes de executar o despachador novamente." } },
      "nl" : { "stringUnit" : { "state" : "translated", "value" : "Hermex heeft het bord vernieuwd, maar kan niet bevestigen of workers zijn gestart. Controleer het huidige bord voordat je de dispatcher opnieuw uitvoert." } },
      "tr" : { "stringUnit" : { "state" : "translated", "value" : "Hermex panoyu yeniledi ancak worker'ların başlayıp başlamadığını doğrulayamıyor. Dağıtıcıyı yeniden çalıştırmadan önce mevcut panoyu inceleyin." } },
      "ru" : { "stringUnit" : { "state" : "translated", "value" : "Hermex обновил доску, но не может подтвердить запуск воркеров. Проверьте текущую доску перед повторным запуском диспетчера." } },
      "ja" : { "stringUnit" : { "state" : "translated", "value" : "Hermex はボードを更新しましたが、ワーカーが起動したかどうかを確認できません。ディスパッチャーを再実行する前に現在のボードを確認してください。" } },
      "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Hermex 已刷新看板，但无法确认工作进程是否已启动。再次运行调度器前，请检查当前看板。" } },
      "ko" : { "stringUnit" : { "state" : "translated", "value" : "Hermex가 보드를 새로 고쳤지만 워커가 시작되었는지는 확인할 수 없습니다. 디스패처를 다시 실행하기 전에 현재 보드를 검토하세요." } },
      "ar" : { "stringUnit" : { "state" : "translated", "value" : "حدّث Hermex اللوحة، لكنه لا يستطيع تأكيد ما إذا كانت العمليات العاملة قد بدأت. راجع اللوحة الحالية قبل تشغيل الموزّع مرة أخرى." } },
      "he" : { "stringUnit" : { "state" : "translated", "value" : "Hermex רענן את הלוח, אך אינו יכול לאשר אם תהליכי העבודה הופעלו. יש לבדוק את הלוח הנוכחי לפני הפעלת המפיץ שוב." } },
      "ur" : { "stringUnit" : { "state" : "translated", "value" : "Hermex نے بورڈ ریفریش کیا، لیکن یہ تصدیق نہیں کر سکتا کہ ورکرز شروع ہوئے یا نہیں۔ ڈسپیچر دوبارہ چلانے سے پہلے موجودہ بورڈ کا جائزہ لیں۔" } },
      "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Hermex 已重新整理看板，但無法確認工作程序是否已啟動。再次執行調度器前，請檢查看板目前狀態。" } },
      "zh-HK" : { "stringUnit" : { "state" : "translated", "value" : "Hermex 已重新整理看板，但無法確認工作程序是否已啟動。再次執行調度器前，請檢查看板目前狀態。" } }
    } },
    "I Reviewed the Board" : { "localizations" : {
      "de" : { "stringUnit" : { "state" : "translated", "value" : "Ich habe das Board überprüft" } },
      "es" : { "stringUnit" : { "state" : "translated", "value" : "He revisado el tablero" } },
      "fr" : { "stringUnit" : { "state" : "translated", "value" : "J’ai vérifié le tableau" } },
      "it" : { "stringUnit" : { "state" : "translated", "value" : "Ho controllato la bacheca" } },
      "pl" : { "stringUnit" : { "state" : "translated", "value" : "Tablica została sprawdzona" } },
      "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Revisei o quadro" } },
      "nl" : { "stringUnit" : { "state" : "translated", "value" : "Ik heb het bord gecontroleerd" } },
      "tr" : { "stringUnit" : { "state" : "translated", "value" : "Panoyu inceledim" } },
      "ru" : { "stringUnit" : { "state" : "translated", "value" : "Доска проверена" } },
