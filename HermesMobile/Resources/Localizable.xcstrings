    "Could not start that skill. Your draft is still here." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Dieser Skill konnte nicht gestartet werden. Dein Entwurf ist noch da." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "No se pudo iniciar esa habilidad. Tu borrador sigue aquí." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Impossible de lancer cette compétence. Votre brouillon est toujours là." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Impossibile avviare quella competenza. La tua bozza è ancora qui." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Nie można uruchomić tej umiejętności. Twój szkic nadal tu jest." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Não foi possível iniciar essa habilidade. Seu rascunho continua aqui." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Kan die vaardigheid niet starten. Je concept staat er nog." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Bu beceri başlatılamadı. Taslağınız hâlâ burada." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Не удалось запустить этот навык. Ваш черновик сохранён." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "そのスキルを開始できませんでした。下書きは残っています。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "无法启动该技能。你的草稿仍在此处。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "해당 스킬을 시작할 수 없습니다. 초안은 그대로 있습니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "تعذّر بدء هذه المهارة. لا تزال مسودتك هنا." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "לא ניתן להפעיל את המיומנות הזו. הטיוטה שלך עדיין כאן." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "وہ مہارت شروع نہیں ہو سکی۔ آپ کا ڈرافٹ ابھی یہیں ہے۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "無法啟動該技能。你的草