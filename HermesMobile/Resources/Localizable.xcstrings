    "Title is required." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "العنوان مطلوب." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Titel ist erforderlich." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Se requiere título." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le titre est requis." } },
        "he" : { "stringUnit" : { "state" : "translated", "value" : "נדרשת כותרת." } },
