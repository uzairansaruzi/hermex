        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hermes 서버에서 예약된 작업을 제거해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hiermee wordt de geplande taak van de Hermes-server verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usuwa zaplanowane zadanie z serwera Hermes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Isso remove a tarefa agendada do servidor Hermes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Это удаляет запланированную задачу с сервера Hermes."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bu, zamanlanmış görevi Hermes sunucusundan kaldırır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "یہ شیڈول شدہ ٹاسک کو Hermes سرور سے ہٹا دیتا ہے۔"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "這會從 Hermes 伺服器移除該排程工作。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "这会从 Hermes 服务器移除该计划任务。"
          }
