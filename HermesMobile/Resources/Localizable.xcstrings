    "Photo from %@" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Foto vom %@" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Foto del %@" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Photo du %@" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Foto del %@" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Zdjęcie z %@" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Foto de %@" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Foto van %@" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Fotoğraf, %@" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Фото от %@" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "%@に撮影した写真" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "%@ 拍摄的照片" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "%@에 찍은 사진" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "صورة من %@" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "תמונה מ־%@" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "%@ کی تصویر" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "%@ 拍攝的照片" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "%@ 拍攝的相片" } } } },
    "Photos can save images and videos. Export audio to Files instead." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Fotos kann Bilder und Videos speichern. Exportiere Audio stattdessen in Dateien." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Fotos puede guardar imágenes y vídeos. Exporta el audio a Archivos." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Photos peut enregistrer des images et des vidéos. Exportez plutôt l’audio vers Fichiers." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Foto può salvare immagini e video. Esporta l’audio in File." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Zdjęcia mogą zapisywać obrazy i wideo. Wyeksportuj audio do Plików." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "O Fotos pode salvar imagens e vídeos. Exporte o áudio para o app Arquivos." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Foto's kan afbeeldingen en video's bewaren. Exporteer audio in plaats daarvan naar Bestanden." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Fotoğraflar görüntü ve videoları kaydedebilir. Sesi bunun yerine Dosyalar’a aktarın." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Приложение «Фото» сохраняет только изображения и видео. Экспортируйте аудио в «Файлы»." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "「写真」には画像とビデオを保存できます。オーディオは「ファイル」にエクスポートしてください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "“照片”可以保存图片和视频。请改为将音频导出到“文件”。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "사진 앱에는 이미지와 동영상을 저장할 수 있습니다. 오디오는 대신 파일 앱으로 내보내세요." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "يمكن لتطبيق الصور حفظ الصور ومقاطع الفيديو. صدّر الصوت إلى الملفات بدلًا من ذلك." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "״תמונות״ יכולה לשמור תמונות וסרטונים. במקום זאת יש לייצא שמע ל״קבצים״." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "Photos تصاویر اور ویڈیوز محفوظ کر سکتا ہے۔ اس کے بجائے آڈیو Files میں برآمد کریں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "「照片」可以儲存圖片和影片。請改為將音訊匯出至「檔案」。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "「相片」可以儲存圖片和影片。請改為將音訊匯出至「檔案」。" } } } },
    "Photos could not save this media." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Fotos konnte diese Medien nicht speichern." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Fotos no pudo guardar este contenido multimedia." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Photos n’a pas pu enregistrer ce média." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Impossibile salvare questo media in Foto." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Nie można zapisać tych multimediów w Zdjęciach." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "O Fotos não conseguiu salvar esta mídia." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Foto's kon deze media niet bewaren." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Fotoğraflar bu medyayı kaydedemedi." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Приложению «Фото» не удалось сохранить это медиа." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "「写真」でこのメディアを保存できませんでした。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "“照片”无法保存此媒体。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "사진 앱이 이 미디어를 저장하지 못했습니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "تعذّر على الصور حفظ هذه الوسائط." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "״תמונות״ לא הצליחה לשמור את המדיה הזו." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "Photos یہ میڈیا محفوظ نہیں کر سکا۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "「照片」無法儲存此媒體。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "「相片」無法儲存此媒體。" } } } },
