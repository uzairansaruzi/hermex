    "Server speech-to-text is not configured." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Die Spracherkennung auf dem Server ist nicht konfiguriert." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "La conversión de voz a texto del servidor no está configurada." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "La transcription vocale n’est pas configurée sur le serveur." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "La trascrizione vocale del server non è configurata." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Zamiana mowy na tekst na serwerze nie jest skonfigurowana." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "A conversão de fala em texto do servidor não está configurada." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Spraak-naar-tekst op de server is niet geconfigureerd." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Sunucuda konuşmayı metne dönüştürme yapılandırılmamış." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Серверное преобразование речи в текст не настроено." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "サーバーの音声文字変換が設定されていません。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "服务器未配置语音转文字。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "서버 음성 텍스트 변환이 구성되지 않았습니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "تحويل الكلام إلى نص على الخادم غير مُهيأ." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "המרת דיבור לטקסט בשרת אינה מוגדרת." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "سرور کی اسپیچ ٹو ٹیکسٹ ترتیب نہیں دی گئی۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "伺服器未設定語音轉文字。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "伺服器未設定語音轉文字。" } } } },
    "Show hidden (%lld)" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Ausgeblendete zeigen (%lld)" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Mostrar ocultos (%lld)" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Afficher les éléments masqués (%lld)" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Mostra nascosti (%lld)" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Pokaż ukryte (%lld)" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Mostrar ocultos (%lld)" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Verborgen items tonen (%lld)" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Gizlenenleri göster (%lld)" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Показать скрытые (%lld)" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "非表示の項目を表示（%lld）" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "显示已隐藏项（%lld）" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "숨긴 항목 표시(%lld)" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "إظهار المخفية (%lld)" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "הצגת מוסתרים (%lld)" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "پوشیدہ دکھائیں (%lld)" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "顯示已隱藏項目（%lld）" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "顯示已隱藏項目（%lld）" } } } },
    "Shows archived sessions." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Zeigt archivierte Sitzungen." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Muestra las sesiones archivadas." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Affiche les sessions archivées." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Mostra le sessioni archiviate." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Pokazuje zarchiwizowane sesje." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Mostra as sessões arquivadas." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Toont gearchiveerde sessies." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Arşivlenmiş oturumları gösterir." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Показывает архивные сессии." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "アーカイブ済みセッションを表示します。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "显示已归档的会话。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "보관된 세션을 표시합니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "يعرض الجلسات المؤرشفة." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "מציג מפגשים בארכיון." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "آرکائیو شدہ سیشنز دکھاتا ہے۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "顯示已封存的工作階段。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "顯示已封存的工作階段。" } } } },
    "Sign in again. Check your Bot connection username and password." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Melde dich erneut an. Prüfe Benutzername und Passwort deiner Bot-Verbindung." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Vuelve a iniciar sesión. Comprueba el usuario y la contraseña de tu conexión de Bot." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Reconnectez-vous. Vérifiez le nom d’utilisateur et le mot de passe de votre connexion Bot." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Accedi di nuovo. Controlla nome utente e password della connessione Bot." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Zaloguj się ponownie. Sprawdź nazwę użytkownika i hasło połączenia z botami." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Entre novamente. Verifique o nome de usuário e a senha da conexão do Bot." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Log opnieuw in. Controleer de gebruikersnaam en het wachtwoord van je botverbinding." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Yeniden oturum açın. Bot bağlantısı kullanıcı adınızı ve parolanızı kontrol edin." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Войдите снова. Проверьте имя пользователя и пароль подключения ботов." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "再度サインインしてください。ボット接続のユーザ名とパスワードを確認してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "请重新登录。检查你的机器人连接用户名和密码。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "다시 로그인하세요. 봇 연결 사용자 이름과 비밀번호를 확인하세요." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "سجّل الدخول مرة أخرى. تحقق من اسم المستخدم وكلمة المرور لاتصال الروبوتات." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "יש להתחבר שוב. יש לבדוק את שם המשתמש והסיסמה של חיבור הבוטים." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "دوبارہ سائن اِن کریں۔ اپنے بوٹ کنکشن کا یوزر نیم اور پاس ورڈ چیک کریں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "請重新登入。檢查你的機器人連線使用者名稱和密碼。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "請重新登入。檢查你的機械人連線用戶名稱和密碼。" } } } },
    "Sign in is required for Kanban." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Für Kanban ist eine Anmeldung erforderlich." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Kanban requiere iniciar sesión." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Une connexion est requise pour Kanban." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Per usare Kanban è necessario accedere." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Kanban wymaga zalogowania." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "É necessário entrar para usar o Kanban." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Inloggen is vereist voor Kanban." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Kanban için oturum açmak gerekiyor." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Для Канбана требуется вход." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "カンバンにはサインインが必要です。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "需要登录才能使用看板。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "칸반을 사용하려면 로그인이 필요합니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "يلزم تسجيل الدخول لاستخدام كانبان." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "נדרשת כניסה כדי להשתמש בקנבן." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "کانبان کے لیے سائن اِن ضروری ہے۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "需要登入才能使用看板。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "需要登入才能使用看板。" } } } },
    "Skip" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Überspringen" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Omitir" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Ignorer" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Salta" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Pomiń" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Pular" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Overslaan" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Atla" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Пропустить" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "スキップ" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "跳过" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "건너뛰기" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "تخطي" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "דילוג" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "چھوڑیں" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "略過" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "略過" } } } },
    "Skip this setup" : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Diese Einrichtung überspringen" } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Omitir esta configuración" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Ignorer cette configuration" } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Salta questa configurazione" } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Pomiń tę konfigurację" } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Pular esta configuração" } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Deze instelling overslaan" } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Bu kurulumu atla" } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Пропустить эту настройку" } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "このセットアップをスキップ" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "跳过此设置" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "이 설정 건너뛰기" } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "تخطي هذا الإعداد" } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "דילוג על ההגדרה הזו" } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "یہ سیٹ اپ چھوڑیں" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "略過此設定" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "略過此設定" } } } },
    "Skip to continue without it." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Überspringe, um ohne weiterzumachen." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Omite para continuar sin ello." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Ignorez pour continuer sans." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Salta per continuare senza." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Pomiń, aby kontynuować bez tego." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Pule para continuar sem isso." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Sla over om zonder verder te gaan." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Atlarsanız bu olmadan devam edilir." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Пропустите, чтобы продолжить без этого." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "スキップすると、それなしで続行します。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "跳过即可在没有它的情况下继续。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "건너뛰면 이것 없이 계속 진행합니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "تخطَّ للمتابعة بدونها." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "אפשר לדלג כדי להמשיך בלעדיו." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "اس کے بغیر جاری رکھنے کے لیے چھوڑیں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "略過即可在沒有它的情況下繼續。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "略過即可在沒有它的情況下繼續。" } } } },
    "Skip to let the command fail instead." : { "localizations" : { "de" : { "stringUnit" : { "state" : "needs_review", "value" : "Überspringe, um den Befehl stattdessen fehlschlagen zu lassen." } }, "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Omite para dejar que el comando falle." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Ignorez pour laisser la commande échouer." } }, "it" : { "stringUnit" : { "state" : "needs_review", "value" : "Salta per far fallire il comando." } }, "pl" : { "stringUnit" : { "state" : "needs_review", "value" : "Pomiń, aby polecenie zakończyło się błędem." } }, "pt-BR" : { "stringUnit" : { "state" : "needs_review", "value" : "Pule para deixar o comando falhar." } }, "nl" : { "stringUnit" : { "state" : "needs_review", "value" : "Sla over om de opdracht in plaats daarvan te laten mislukken." } }, "tr" : { "stringUnit" : { "state" : "needs_review", "value" : "Atlarsanız komut başarısız olur." } }, "ru" : { "stringUnit" : { "state" : "needs_review", "value" : "Пропустите, чтобы команда завершилась с ошибкой." } }, "ja" : { "stringUnit" : { "state" : "needs_review", "value" : "スキップすると、代わりにコマンドが失敗します。" } }, "zh-Hans" : { "stringUnit" : { "state" : "needs_review", "value" : "跳过则会让该命令失败。" } }, "ko" : { "stringUnit" : { "state" : "needs_review", "value" : "건너뛰면 대신 명령이 실패합니다." } }, "ar" : { "stringUnit" : { "state" : "needs_review", "value" : "تخطَّ لترك الأمر يفشل بدلًا من ذلك." } }, "he" : { "stringUnit" : { "state" : "needs_review", "value" : "אפשר לדלג, והפקודה תיכשל." } }, "ur" : { "stringUnit" : { "state" : "needs_review", "value" : "اس کے بجائے کمانڈ کو ناکام ہونے دینے کے لیے چھوڑیں۔" } }, "zh-Hant" : { "stringUnit" : { "state" : "needs_review", "value" : "略過則會讓該指令失敗。" } }, "zh-HK" : { "stringUnit" : { "state" : "needs_review", "value" : "略過則會讓該命令失敗。" } } } },
