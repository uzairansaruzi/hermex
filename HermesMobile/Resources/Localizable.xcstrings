    } },
    "This Preview is stale. Run Preview Dispatch again before relying on it." : { "localizations" : {
      "de" : { "stringUnit" : { "state" : "translated", "value" : "Diese Vorschau ist veraltet. Führe die Dispatch-Vorschau erneut aus, bevor du dich darauf verlässt." } },
      "es" : { "stringUnit" : { "state" : "translated", "value" : "Esta vista previa está obsoleta. Ejecuta de nuevo la vista previa del despacho antes de confiar en ella." } },
      "fr" : { "stringUnit" : { "state" : "translated", "value" : "Cet aperçu est obsolète. Relancez l’aperçu de la répartition avant de vous y fier." } },
      "it" : { "stringUnit" : { "state" : "translated", "value" : "Questa anteprima è obsoleta. Esegui di nuovo l’anteprima dispatch prima di farvi affidamento." } },
      "pl" : { "stringUnit" : { "state" : "translated", "value" : "Ten podgląd jest nieaktualny. Uruchom ponownie podgląd dyspozycji, zanim na nim polegasz." } },
      "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Esta prévia está desatualizada. Execute a prévia do despacho novamente antes de confiar nela." } },
      "nl" : { "stringUnit" : { "state" : "translated", "value" : "Dit voorbeeld is verouderd. Voer Dispatch-voorbeeld opnieuw uit voordat je erop vertrouwt." } },
      "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu önizleme eskidi. Güvenmeden önce Dağıtım Önizlemesini yeniden çalıştırın." } },
      "ru" : { "stringUnit" : { "state" : "translated", "value" : "Этот предпросмотр устарел. Повторите предпросмотр диспетчеризации, прежде чем полагаться на него." } },
      "ja" : { "stringUnit" : { "state" : "translated", "value" : "このプレビューは古くなっています。参考にする前にディスパッチのプレビューを再実行してください。" } },
      "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此预览已过时。请重新运行预览调度后再据此操作。" } },
      "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 미리보기는 오래되었습니다. 이 결과를 사용하기 전에 디스패치 미리보기를 다시 실행하세요." } },
      "ar" : { "stringUnit" : { "state" : "translated", "value" : "هذه المعاينة قديمة. شغّل معاينة التوزيع مرة أخرى قبل الاعتماد عليها." } },
      "he" : { "stringUnit" : { "state" : "translated", "value" : "התצוגה המקדימה התיישנה. יש להפעיל שוב את תצוגת ההפצה לפני שמסתמכים עליה." } },
      "ur" : { "stringUnit" : { "state" : "translated", "value" : "یہ پیش منظر پرانا ہو چکا ہے۔ اس پر انحصار کرنے سے پہلے ڈسپیچ پیش منظر دوبارہ چلائیں۔" } },
      "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "此預覽已過時。請重新執行預覽調度後再據此操作。" } },
      "zh-HK" : { "stringUnit" : { "state" : "translated", "value" : "此預覽已過時。請重新執行預覽調度後再據此操作。" } }
    } },
    "The server refused this Dispatcher request. Hermex did not retry it." : { "localizations" : {
      "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Server hat diese Dispatcher-Anfrage abgelehnt. Hermex hat sie nicht erneut versucht." } },
      "es" : { "stringUnit" : { "state" : "translated", "value" : "El servidor rechazó esta solicitud del despachador. Hermex no volvió a intentarla." } },
      "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le serveur a refusé cette requête du répartiteur. Hermex ne l’a pas réessayée." } },
      "it" : { "stringUnit" : { "state" : "translated", "value" : "Il server ha rifiutato questa richiesta del dispatcher. Hermex non ha riprovato." } },
      "pl" : { "stringUnit" : { "state" : "translated", "value" : "Serwer odrzucił to żądanie dyspozytora. Hermex nie ponowił próby." } },
      "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O servidor recusou esta solicitação do despachador. O Hermex não tentou novamente." } },
      "nl" : { "stringUnit" : { "state" : "translated", "value" : "De server heeft dit dispatcher-verzoek geweigerd. Hermex heeft het niet opnieuw geprobeerd." } },
      "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sunucu bu dağıtıcı isteğini reddetti. Hermex yeniden denemedi." } },
      "ru" : { "stringUnit" : { "state" : "translated", "value" : "Сервер отклонил этот запрос диспетчера. Hermex не повторял его." } },
      "ja" : { "stringUnit" : { "state" : "translated", "value" : "サーバーがこのディスパッチャー要求を拒否しました。Hermex は再試行していません。" } },
      "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "服务器拒绝了此调度器请求。Hermex 未重试。" } },
      "ko" : { "stringUnit" : { "state" : "translated", "value" : "서버가 이 디스패처 요청을 거부했습니다. Hermex는 다시 시도하지 않았습니다." } },
      "ar" : { "stringUnit" : { "state" : "translated", "value" : "رفض الخادم طلب الموزّع هذا. لم يُعِد Hermex المحاولة." } },
      "he" : { "stringUnit" : { "state" : "translated", "value" : "השרת דחה את בקשת המפיץ הזו. Hermex לא ניסה שוב." } },
      "ur" : { "stringUnit" : { "state" : "translated", "value" : "سرور نے اس ڈسپیچر درخواست کو مسترد کر دیا۔ Hermex نے دوبارہ کوشش نہیں کی۔" } },
      "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "伺服器拒絕了此調度器要求。Hermex 未重試。" } },
      "zh-HK" : { "stringUnit" : { "state" : "translated", "value" : "伺服器拒絕了此調度器要求。Hermex 未重試。" } }
    } },
    "This may start up to %lld workers and consume API budget." : { "localizations" : {
      "de" : { "stringUnit" : { "state" : "translated", "value" : "Dadurch können bis zu %lld Worker gestartet und API-Budget verbraucht werden." } },
      "es" : { "stringUnit" : { "state" : "translated", "value" : "Esto puede iniciar hasta %lld trabajadores y consumir presupuesto de API." } },
      "fr" : { "stringUnit" : { "state" : "translated", "value" : "Cela peut démarrer jusqu’à %lld workers et consommer du budget API." } },
      "it" : { "stringUnit" : { "state" : "translated", "value" : "Questa operazione può avviare fino a %lld worker e consumare budget API." } },
      "pl" : { "stringUnit" : { "state" : "translated", "value" : "Może to uruchomić do %lld procesów roboczych i zużyć budżet API." } },
      "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Isso pode iniciar até %lld workers e consumir orçamento de API." } },
      "nl" : { "stringUnit" : { "state" : "translated", "value" : "Dit kan maximaal %lld workers starten en API-budget verbruiken." } },
      "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu işlem en fazla %lld worker başlatabilir ve API bütçesi tüketebilir." } },
      "ru" : { "stringUnit" : { "state" : "translated", "value" : "Это может запустить до %lld воркеров и израсходовать бюджет API." } },
      "ja" : { "stringUnit" : { "state" : "translated", "value" : "最大 %lld 個のワーカーが起動し、API 予算を消費する可能性があります。" } },
      "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这可能会启动最多 %lld 个工作进程并消耗 API 预算。" } },
