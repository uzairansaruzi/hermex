          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "분기가 변경되었지만 저장된 변경 사항을 복원할 수 없습니다."
          }
        },
        "ar" : {
          "stringUnit" : {
