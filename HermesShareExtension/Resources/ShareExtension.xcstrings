    "Shared content saved. Open Hermex manually.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared content saved. Open Hermex manually."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "S'ha desat el contingut compartit. Obre Hermex manualment."
          }
