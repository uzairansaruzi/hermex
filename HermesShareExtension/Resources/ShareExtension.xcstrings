      },
      "comment": "Transient status while the share extension stages content and opens the main app."
    },
    "Hermex accepts text, URLs, images, PDFs, and files up to 20 MB.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermex accepts text, URLs, images, PDFs, and files up to 20 MB."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hermex accepta text, URL, imatges, PDF i fitxers de fins a 20 MB."
          }
        }
      },
      "comment": "Error shown when a share contains no accepted text, URL, image, PDF, or file."
    },
    "Could not access Hermex storage.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not access Hermex storage."
          }
        },
        "ca": {
