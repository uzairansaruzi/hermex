#!/usr/bin/env python3
"""Times cold launches of one or more installed-app builds on a simulator from the app's
`Launch` signpost (`HermesMobile/Config/PerformanceSignposts.swift`), interleaving the builds
so warmup and network drift favor none. The simulator must already be signed in.

  scripts/benchmark-sim-launch <udid> <A.app> [<B.app> ...] [--rounds 4] [--per-install 3]

Each round installs every build in turn, discards one launch, then measures `--per-install`
launches. Prints each build's median, range, run count, and failures (a launch whose
interval never ended within the wait) for two numbers: `Launch` (first rows on screen, cached
or read) and `live` (from the same start to the end of the first `Cache Write`, the host's
first page landing), so a build that paints its cache sooner can't hide a slower host read.
"""
import argparse
import datetime
import re
import statistics
import subprocess
import time

BUNDLE = "com.uzairansar.hermesmobile"
LINE = re.compile(r"^(\S+ \S+) Sp \S+\[(\d+):\w+\] \[[^\]]+:Performance\] \[spid \w+, process, +(begin|end)\] ([A-Za-z ]+?)(?:: (.*))?$")


def sh(*args, check=True):
    return subprocess.run(args, check=check, capture_output=True, text=True).stdout


def signposts(udid, since):
    out = sh("xcrun", "simctl", "spawn", udid, "log", "show", "--signpost", "--style", "compact",
             "--start", since, "--predicate", f'subsystem == "{BUNDLE}" AND category == "Performance"', check=False)
    events = []
    for line in out.splitlines():
        m = LINE.match(line)
        if m:
            stamp = datetime.datetime.strptime(m[1], "%Y-%m-%d %H:%M:%S.%f")
            events.append((stamp, int(m[2]), m[3], m[4], m[5] or ""))
    return events


def launch_once(udid, wait):
    since = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    sh("xcrun", "simctl", "terminate", udid, BUNDLE, check=False)
    time.sleep(1)
    sh("xcrun", "simctl", "launch", udid, BUNDLE)
    time.sleep(wait)
    events = signposts(udid, since)
    begin = next((e for e in events if e[2] == "begin" and e[3] == "Launch"), None)
    end = next((e for e in events if e[2] == "end" and e[3] == "Launch"), None)
    write = next((e for e in events if e[2] == "end" and e[3] == "Cache Write"), None)
    if not begin or not end or not write:
        return None, None
    return (end[0] - begin[0]).total_seconds() * 1000, (write[0] - begin[0]).total_seconds() * 1000


def main():
    p = argparse.ArgumentParser()
    p.add_argument("udid")
    p.add_argument("apps", nargs="+")
    p.add_argument("--rounds", type=int, default=4)
    p.add_argument("--per-install", type=int, default=3)
    p.add_argument("--wait", type=float, default=7)
    a = p.parse_args()
    results = {app: [] for app in a.apps}
    live = {app: [] for app in a.apps}
    failures = {app: 0 for app in a.apps}
    for r in range(a.rounds):
        for app in a.apps:
            sh("xcrun", "simctl", "install", a.udid, app)
            launch_once(a.udid, a.wait)
            for _ in range(a.per_install):
                ms, live_ms = launch_once(a.udid, a.wait)
                if ms is None:
                    failures[app] += 1
                else:
                    results[app].append(ms)
                    live[app].append(live_ms)
                print(f"round {r} {app}: " + ("FAIL" if ms is None else f"Launch {ms:.0f} ms, live {live_ms:.0f} ms"),
                      flush=True)
    for app in a.apps:
        print(app)
        for name, xs in (("Launch", results[app]), ("live", live[app])):
            if xs:
                print(f"  {name} median {statistics.median(xs):.0f} ms, range {min(xs):.0f}-{max(xs):.0f}, "
                      f"n={len(xs)}, failures={failures[app]}")
            else:
                print(f"  {name}: no completed launches, failures={failures[app]}")


if __name__ == "__main__":
    main()
